  const s = loadStats();
  if (!s.quizzes[mid]) s.quizzes[mid] = {attempts:0, correct:0, byQuestion:[]};
  s.quizzes[mid].attempts++; if (correct) s.quizzes[mid].correct++;
  s.quizzes[mid].byQuestion[qIdx] = correct;
  s.history = s.history || {}; const k = todayKey();
  s.history[k] = s.history[k] || {quizCorrect:0,quizTotal:0,time:0};
  s.history[k].quizTotal++; if (correct) s.history[k].quizCorrect++;
  const before = new Set(s.achievements || []);
  s.achievements = evaluateAchievements(s);
