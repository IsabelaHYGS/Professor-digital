<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Professor Digital — Plataforma Completa</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js"></script>
<style>:root{--bg:#000020;--surface:#171a4a;--primary:#212c79;--accent:#ff9800;--accent-l:#ffcc50;--text:#fff;--muted:#b8bcd0;--border:rgba(255,204,80,.15);--ok:#2ea043;--err:#dc3232}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter','Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh}
a{color:var(--accent-l);text-decoration:none}
header.top{position:sticky;top:0;z-index:100;background:rgba(0,0,32,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.logo{font-weight:800;font-size:.98rem;display:flex;align-items:center;gap:8px;cursor:pointer}
.logo .dot{width:12px;height:12px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent)}
.logo span{color:var(--accent-l)}
nav.main{display:flex;gap:3px;flex-wrap:wrap;margin-left:auto;align-items:center}
nav.main button{background:transparent;border:1px solid transparent;color:var(--muted);font:inherit;cursor:pointer;padding:6px 11px;border-radius:8px;font-size:.85rem}
nav.main button:hover{color:var(--text);background:var(--surface)}
nav.main button.active{color:#1466C3;background:var(--accent-l);font-weight:600}
main{padding:22px 16px 100px;max-width:1200px;margin:0 auto}
h1{font-size:1.9rem;line-height:1.15;margin-bottom:12px}
h1 .accent{color:var(--accent-l)}
h2{font-size:1.35rem;margin-bottom:10px}
p{color:var(--muted);margin-bottom:10px}
.hero{background:linear-gradient(135deg,var(--surface),var(--primary));border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:26px}
.badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}
.badge{background:rgba(255,204,80,.12);color:var(--accent-l);border:1px solid rgba(255,204,80,.3);padding:3px 10px;border-radius:14px;font-size:.72rem;font-weight:500}
.grid-disc{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:16px}
.card-disc{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;cursor:pointer;transition:.2s;position:relative;overflow:hidden}
.card-disc:hover{transform:translateY(-3px);border-color:var(--accent-l);background:var(--primary)}
.card-disc .icon{font-size:1.6rem;margin-bottom:8px}
.card-disc h3{color:var(--text);font-size:1rem;margin-bottom:4px}
.card-disc p{font-size:.82rem;margin:0}
.card-disc .count{position:absolute;top:14px;right:14px;font-size:.68rem;color:var(--accent-l);background:rgba(255,204,80,.1);padding:2px 8px;border-radius:10px}
.grid-mod{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;margin-top:14px}
.card-mod{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;cursor:pointer;transition:.2s;position:relative}
.card-mod:hover{border-color:var(--accent);background:var(--primary)}
.card-mod .num{font-size:.68rem;font-weight:700;color:var(--accent-l);letter-spacing:1px}
.card-mod h4{font-size:.9rem;font-weight:600;color:var(--text);margin:4px 0}
.card-mod p{font-size:.76rem;margin:0}
.module-head{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:16px}
.breadcrumb{font-size:.8rem;color:var(--muted);margin-bottom:8px}
.breadcrumb a{color:var(--accent-l);cursor:pointer}
.module-head h1{font-size:1.4rem;margin-bottom:4px}
.obj{background:rgba(255,204,80,.08);border-left:3px solid var(--accent-l);padding:10px 14px;border-radius:0 8px 8px 0;margin-top:10px;font-size:.88rem}
.obj strong{color:var(--accent-l)}
.stepper{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:14px;background:var(--surface);padding:10px;border-radius:12px;border:1px solid var(--border)}
.step-btn{min-width:32px;padding:5px 8px;height:32px;border-radius:7px;border:1px solid var(--border);background:transparent;color:var(--muted);font:inherit;font-size:.74rem;font-weight:600;cursor:pointer;transition:.15s}
.step-btn:hover{border-color:var(--accent-l);color:var(--accent-l)}
.step-btn.active{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.step-btn.done{background:var(--primary);color:var(--accent-l)}
.step-btn.map-btn{background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);border:none;font-weight:700}
.section{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:22px;min-height:320px}
.step-label{font-size:.7rem;font-weight:700;color:var(--accent);letter-spacing:1.4px;margin-bottom:4px}
.section-body{color:var(--muted);font-size:.92rem}
.section-body ul{padding-left:20px;margin-bottom:10px}
.section-body li{margin-bottom:5px}
.section-body strong{color:var(--text)}
.section-body em{color:var(--accent-l);font-style:normal}
.subsection{background:rgba(0,0,32,.4);border-radius:8px;padding:12px 14px;margin:10px 0;border-left:2px solid rgba(255,204,80,.4)}
.subsection h4{color:var(--accent-l);font-size:.85rem;margin-bottom:4px;font-weight:700;letter-spacing:.5px}
.formula-block{background:rgba(0,0,32,.6);border-left:3px solid var(--accent);padding:10px 14px;border-radius:0 8px 8px 0;margin:10px 0;color:var(--accent-l);font-family:monospace;font-size:.92rem;line-height:1.8}
.nav-buttons{display:flex;justify-content:space-between;margin-top:16px;gap:10px;flex-wrap:wrap}
.btn{padding:8px 16px;border-radius:9px;border:1px solid var(--border);background:var(--surface);color:var(--text);font:inherit;font-weight:600;cursor:pointer;transition:.2s;font-size:.88rem;text-decoration:none;display:inline-block}
.btn:hover{border-color:var(--accent-l);color:var(--accent-l)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.btn.primary:hover{background:var(--accent-l)}
.btn:disabled{opacity:.35;cursor:not-allowed}
.btn.video{background:rgba(220,50,50,.15);border-color:#dc3232;color:#ff8888;font-size:.82rem}
.quiz{background:rgba(33,44,121,.4);border:1px solid var(--border);border-radius:10px;padding:16px;margin-top:12px}
.quiz .q{font-weight:600;color:var(--text);margin-bottom:10px;font-size:.92rem}
.quiz .opts{display:flex;flex-direction:column;gap:6px}
.quiz .opt{text-align:left;padding:9px 13px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;cursor:pointer;font-size:.86rem}
.quiz .opt:hover:not(:disabled){border-color:var(--accent-l);background:var(--primary)}
.quiz .opt.correct{background:rgba(46,160,67,.2);border-color:var(--ok);color:#A2CA8E}
.quiz .opt.wrong{background:rgba(220,50,50,.15);border-color:var(--err);color:#ff8888}
.quiz .opt:disabled{cursor:default}
.quiz .feedback{margin-top:10px;padding:10px 14px;border-radius:8px;background:rgba(255,204,80,.08);border-left:3px solid var(--accent-l);font-size:.86rem}
.quiz .feedback strong{color:var(--accent-l)}
.enem-tag{display:inline-block;background:rgba(255,152,0,.15);color:var(--accent);border:1px solid rgba(255,152,0,.3);padding:1px 8px;border-radius:10px;font-size:.68rem;font-weight:600;margin-bottom:6px}
#viz-container{margin-top:14px;border-radius:10px;overflow:hidden;border:1px solid var(--border);background:var(--surface);display:none;flex-direction:column;align-items:center}
#viz-container.show{display:flex}
#viz-container canvas{display:block;max-width:100%;height:auto!important;cursor:crosshair;touch-action:none}
.viz-hint{padding:6px 14px;font-size:.74rem;color:var(--accent-l);background:rgba(255,204,80,.06);border-top:1px solid var(--border);text-align:center;width:100%}
.controls{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;padding:10px;background:rgba(0,0,32,.5);border-radius:8px}
.control{display:flex;flex-direction:column;gap:4px;min-width:120px;flex:1}
.control label{font-size:.74rem;color:var(--muted)}
.control input[type=range]{accent-color:var(--accent);width:100%}
.control .val{color:var(--accent-l);font-weight:600;font-size:.8rem}
.info-box{background:rgba(0,0,32,.5);border-radius:8px;padding:12px 14px;margin-top:10px;font-size:.86rem;border:1px solid var(--border)}
.info-box .label{color:var(--accent-l);font-weight:600;font-size:.72rem;letter-spacing:1px}
.info-box p{color:var(--muted);margin:4px 0 0}
.destaque{background:rgba(255,152,0,.08);border-left:3px solid var(--accent);padding:10px 14px;border-radius:0 8px 8px 0;margin:10px 0;color:var(--text);font-size:.88rem}
.video-card{background:rgba(0,0,32,.5);border:1px solid var(--border);border-radius:10px;padding:12px;margin-top:8px}
.video-card .video-title{color:var(--text);font-weight:600;font-size:.88rem;margin-bottom:2px}
.video-card .video-credit{color:var(--muted);font-size:.74rem;margin-bottom:8px}
.source-tag{display:inline-block;background:rgba(255,204,80,.12);color:var(--accent-l);border:1px solid rgba(255,204,80,.25);padding:2px 8px;border-radius:10px;font-size:.68rem;font-weight:500;margin-right:6px;margin-top:6px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(120px);background:var(--surface);border:1px solid var(--accent-l);padding:10px 20px;border-radius:8px;color:var(--accent-l);font-weight:600;font-size:.86rem;transition:.3s;z-index:900}
.toast.show{transform:translateX(-50%) translateY(0)}
.error-banner{background:var(--err);color:#fff;padding:14px 20px;font-family:monospace;font-size:.85rem;margin:20px;border-radius:10px;white-space:pre-wrap;display:none}
.mia-btn{position:fixed;bottom:18px;right:18px;width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#EFAE78,#F5E19C);border:none;cursor:pointer;z-index:250;box-shadow:0 8px 30px rgba(255,152,0,.5);display:flex;align-items:center;justify-content:center;transition:transform .25s;padding:0}
.mia-btn:hover{transform:scale(1.08) rotate(-5deg)}
.mia-btn svg{width:56px;height:56px}
.mia-chat{position:fixed;bottom:100px;right:18px;width:360px;max-width:calc(100vw - 36px);height:520px;max-height:calc(100vh - 130px);background:var(--surface);border:1px solid var(--accent);border-radius:16px;z-index:250;display:none;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.7)}
.mia-chat.open{display:flex}
.mia-header{background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);padding:10px 14px;display:flex;align-items:center;gap:10px;font-weight:700}
.mia-header svg{width:36px;height:36px}
.mia-header .mia-info{flex:1;line-height:1.1}
.mia-header .mia-info strong{font-size:.98rem}
.mia-header .mia-info span{font-size:.7rem;opacity:.75;font-weight:500}
.mia-header button{background:rgba(0,0,32,.2);border:none;color:var(--bg);width:26px;height:26px;border-radius:50%;font-size:1rem;cursor:pointer;font-weight:700}
.mia-messages{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:rgba(0,0,32,.4)}
.mia-msg{max-width:85%;padding:9px 13px;border-radius:12px;font-size:.85rem;line-height:1.5}
.mia-msg.mia{background:var(--primary);color:var(--text);border-bottom-left-radius:4px;align-self:flex-start}
.mia-msg.user{background:var(--accent);color:var(--bg);border-bottom-right-radius:4px;align-self:flex-end;font-weight:500}
.mia-msg strong{color:var(--accent-l)}
.mia-msg.user strong{color:var(--bg)}
.mia-typing{display:flex;gap:3px;padding:10px 14px;align-self:flex-start;background:var(--primary);border-radius:12px;border-bottom-left-radius:4px}
.mia-typing span{width:7px;height:7px;background:var(--accent-l);border-radius:50%;animation:mt 1.4s infinite}
.mia-typing span:nth-child(2){animation-delay:.2s}
.mia-typing span:nth-child(3){animation-delay:.4s}
@keyframes mt{0%,60%,100%{opacity:.3}30%{opacity:1}}
.mia-sug{padding:6px 12px;display:flex;gap:5px;flex-wrap:wrap;background:rgba(0,0,32,.5)}
.mia-sug button{background:rgba(255,204,80,.1);border:1px solid rgba(255,204,80,.3);color:var(--accent-l);font:inherit;font-size:.7rem;padding:4px 9px;border-radius:10px;cursor:pointer}
.mia-sug button:hover{background:rgba(255,204,80,.25)}
.mia-sug button:focus-visible{outline:2px solid var(--accent-l);outline-offset:2px}
.mia-sug{pointer-events:auto;position:relative;z-index:2}
.mia-input{display:flex;gap:6px;padding:10px;border-top:1px solid var(--border);background:var(--surface)}
.mia-input input{flex:1;background:var(--bg);border:1px solid var(--border);color:var(--text);font:inherit;font-size:.86rem;padding:8px 12px;border-radius:8px;outline:none}
.mia-input input:focus{border-color:var(--accent)}
.mia-input button{background:var(--accent);color:var(--bg);border:none;padding:0 14px;border-radius:8px;font:inherit;font-weight:700;cursor:pointer}
.mia-tag{display:inline-block;background:rgba(255,204,80,.15);color:var(--accent-l);font-size:.68rem;padding:1px 7px;border-radius:8px;margin-bottom:3px}
.map-modal{position:fixed;inset:0;background:rgba(0,0,32,.94);z-index:300;display:none;align-items:center;justify-content:center;padding:16px}
.map-modal.open{display:flex}
.map-content{background:#F5E19C;border:1px solid var(--accent);border-radius:16px;width:100%;max-width:1200px;height:100%;max-height:92vh;display:flex;flex-direction:column;overflow:hidden}
.map-header{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid rgba(255,204,80,.3);background:linear-gradient(135deg,var(--accent),var(--accent-l))}
.map-header h3{color:#F5E19C;font-size:1rem;margin:0;font-weight:800}
.map-header button{background:rgba(0,0,32,.15);border:none;color:#F5E19C;width:30px;height:30px;border-radius:7px;font-size:1.1rem;cursor:pointer;font-weight:700}
.map-canvas{flex:1;overflow:auto;background:#F5E19C}
.map-canvas svg{width:100%;height:100%;min-height:620px;display:block}
.map-detail{padding:12px 18px;background:#F5E19C;border-top:2px dashed var(--accent);font-size:.86rem;color:#1466C3;min-height:50px}
.prof-toggle{position:fixed;top:68px;right:18px;z-index:240;background:linear-gradient(135deg,#EFAE78,#F5E19C);color:#F5E19C;border:none;padding:8px 14px;border-radius:10px;font:inherit;font-weight:700;font-size:.82rem;cursor:pointer;box-shadow:0 4px 16px rgba(255,152,0,.4)}
.prof-toggle.on{background:#1466C3;color:#F5E19C}
.prof-sidebar{position:fixed;top:62px;right:0;width:360px;max-width:calc(100vw - 20px);height:calc(100vh - 62px);background:var(--surface);border-left:2px solid var(--accent);z-index:240;display:none;flex-direction:column;box-shadow:-12px 0 40px rgba(0,0,0,.55);overflow-y:auto}
.prof-sidebar.show{display:flex}
.prof-head{padding:14px 18px;background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);display:flex;justify-content:space-between;align-items:center;font-weight:800;position:sticky;top:0;z-index:2}
.prof-head .left{display:flex;flex-direction:column;line-height:1.2}
.prof-head .left strong{font-size:1rem}
.prof-head .timer{font-size:.72rem;font-weight:700;font-family:'Consolas',monospace;background:rgba(0,0,0,.15);padding:2px 8px;border-radius:10px;display:inline-block;margin-top:3px;width:fit-content}
.prof-head button{background:rgba(0,0,0,.15);border:none;color:var(--bg);width:28px;height:28px;border-radius:50%;cursor:pointer;font-size:1.1rem;font-weight:700}
.prof-body{padding:14px 18px}
.prof-sec{margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.prof-sec:last-child{border-bottom:none;margin-bottom:0}
.prof-lb{font-size:.66rem;color:var(--accent-l);font-weight:700;letter-spacing:1.4px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center}
.prof-mod-info{font-size:.9rem;color:var(--text);font-weight:600;margin-bottom:2px}
.prof-step-title{font-size:.82rem;color:var(--accent-l);font-weight:700;margin-bottom:4px}
.prof-step-desc{font-size:.8rem;color:var(--muted);line-height:1.5}
.prof-tip{font-size:.82rem;color:var(--text);background:rgba(0,0,0,.35);padding:9px 12px;border-radius:8px;border-left:3px solid var(--accent-l);margin-top:8px;line-height:1.5}
.prof-tip::before{content:'💡 '}
.prof-nav{display:flex;gap:6px}
.prof-nav button{flex:1;padding:9px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:600;font-size:.82rem;cursor:pointer}
.prof-nav button:disabled{opacity:.35;cursor:not-allowed}
.prof-nav button.pri{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.prof-tools{display:flex;gap:6px;flex-wrap:wrap}
.prof-tools button{padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:600;font-size:.76rem;cursor:pointer;flex:1;min-width:100px}
.prof-tools button.hot{border-color:var(--accent);color:var(--accent-l)}
.prof-notes{width:100%;min-height:70px;background:var(--bg);border:1px solid var(--border);color:var(--text);font:inherit;font-size:.84rem;padding:8px 10px;border-radius:8px;resize:vertical;outline:none;font-family:inherit;line-height:1.5}
.prof-prog-bar{height:8px;background:var(--primary);border-radius:4px;overflow:hidden;margin-bottom:4px}
.prof-prog-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));transition:width .3s;width:0%}
.prof-prog-txt{font-size:.78rem;color:var(--muted);text-align:center}
.draw-modal{position:fixed;inset:0;background:rgba(0,0,32,.9);z-index:400;display:none;align-items:center;justify-content:center;padding:20px}
.draw-modal.open{display:flex}
.draw-box{background:var(--surface);border:1px solid var(--accent);border-radius:16px;width:100%;max-width:540px;max-height:88vh;display:flex;flex-direction:column;overflow:hidden}
.draw-head{padding:14px 20px;background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);font-weight:800;display:flex;justify-content:space-between;align-items:center}
.draw-head button{background:rgba(0,0,0,.15);border:none;color:var(--bg);width:28px;height:28px;border-radius:50%;cursor:pointer;font-weight:700;font-size:1rem}
.draw-body{padding:18px;overflow-y:auto}
.draw-lbl{display:block;font-size:.72rem;color:var(--accent-l);font-weight:700;letter-spacing:1px;margin-bottom:6px}
.draw-textarea{width:100%;min-height:120px;background:#F5E19C;border:2px solid var(--border);color:#fff;font:inherit;padding:12px 14px;border-radius:8px;resize:vertical;font-family:'Consolas',monospace;font-size:.92rem;line-height:1.6;outline:none;caret-color:var(--accent-l)}
.draw-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.draw-actions button{flex:1;min-width:110px;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:600;cursor:pointer;font-size:.86rem}
.draw-actions button.pri{background:var(--accent);color:var(--bg);border-color:var(--accent);font-weight:700}
.draw-result{margin-top:14px;padding:26px 20px;background:linear-gradient(135deg,var(--primary),var(--surface));border-radius:12px;text-align:center;font-size:1.7rem;font-weight:800;color:var(--accent-l);min-height:90px;display:flex;align-items:center;justify-content:center;border:2px dashed var(--accent-l)}
.draw-result.highlight{animation:drawPulse .7s}
@keyframes drawPulse{50%{transform:scale(1.09);box-shadow:0 0 40px var(--accent)}}
.pres-overlay{position:fixed;inset:0;background:#000;z-index:350;display:none;flex-direction:column;overflow:hidden}
.pres-overlay.on{display:flex}
.pres-toolbar{position:absolute;top:16px;right:16px;display:flex;gap:4px;z-index:355;background:rgba(23,26,74,.94);border:1px solid var(--accent);border-radius:12px;padding:8px 10px;align-items:center;flex-wrap:wrap;max-width:calc(100% - 32px)}
.pres-toolbar button{background:transparent;border:1px solid transparent;color:var(--text);width:38px;height:38px;border-radius:8px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center}
.pres-toolbar button.on{background:var(--accent);color:var(--bg)}
.pres-toolbar .color-dot{width:24px;height:24px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0;margin:0 2px}
.pres-toolbar .color-dot.on{border-color:var(--accent-l);transform:scale(1.2)}
.pres-content{flex:1;overflow-y:auto;padding:100px 80px 80px;background:radial-gradient(circle at 50% 0%,rgba(255,152,0,.06),transparent 60%),var(--bg);position:relative;z-index:1}
.pres-content h2{font-size:2.4rem;color:var(--accent-l);margin-bottom:28px}
.pres-content p,.pres-content li{font-size:1.25rem;color:var(--text);margin-bottom:18px;line-height:1.85}
.pres-content ul{padding-left:30px}
.pres-content strong{color:var(--accent-l)}
.draw-layer{position:absolute;inset:0;width:100%;height:100%;z-index:20;pointer-events:none;touch-action:none;display:block;overflow:visible;isolation:isolate}
.draw-layer.on{pointer-events:auto;cursor:crosshair;touch-action:none}
.slide-stage{isolation:isolate}
.slide-card{z-index:1}
.slide-tools{z-index:30}
.draw-layer path{fill:none;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
.slides-modal{position:fixed;inset:0;background:#66AF91;z-index:380;display:none;flex-direction:column}
.slides-modal.on{display:flex}
.slide-stage{flex:1;display:flex;align-items:center;justify-content:center;padding:30px;position:relative;overflow:hidden}
.slide-card{background:#F5E19C;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.5);width:100%;max-width:1100px;height:100%;max-height:640px;padding:50px 60px;display:flex;flex-direction:column;position:relative;z-index:1;overflow-y:auto;border:5px solid var(--accent)}
.slide-card .slide-num{position:absolute;top:18px;right:24px;font-size:.8rem;font-weight:700;color:#1466C3;letter-spacing:1.5px}
.slide-card h1{color:#1466C3;font-size:2.6rem;margin-bottom:22px;line-height:1.15;font-weight:800}
.slide-card h2{color:#1466C3;font-size:2rem;margin-bottom:20px;font-weight:800}
.slide-card p,.slide-card li{color:#1466C3;font-size:1.2rem;line-height:1.7;margin-bottom:14px}
.slide-card strong{color:#F5E19C}
.slide-card .formula-block{background:#F5E19C;border-left:5px solid #EFAE78;color:#1466C3;font-size:1.15rem;padding:18px 24px;border-radius:0 10px 10px 0;margin:14px 0}
.slide-controls{display:flex;justify-content:center;gap:12px;padding:14px;background:var(--surface);border-top:3px solid var(--accent);align-items:center;flex-wrap:wrap}
.slide-controls button{padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:700;cursor:pointer;font-size:.9rem}
.slide-controls button.pri{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.slide-counter{color:var(--accent-l);font-weight:700;font-size:.98rem;min-width:90px;text-align:center}
.slide-tools{display:flex;gap:4px;padding:8px 12px;background:rgba(23,26,74,.94);position:absolute;top:14px;left:14px;border-radius:10px;z-index:5;border:1px solid var(--accent);align-items:center;flex-wrap:wrap}
.slide-tools button{background:transparent;border:1px solid transparent;color:var(--text);width:36px;height:36px;border-radius:6px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center}
.slide-tools button.on{background:var(--accent);color:var(--bg)}
.slide-tools .color-dot{width:22px;height:22px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0;margin:0 2px}
.slide-tools .color-dot.on{border-color:var(--accent-l);transform:scale(1.2)}
.game-modal{position:fixed;inset:0;background:#000;z-index:450;display:none;flex-direction:column;overflow:hidden}
.game-modal.on{display:flex}
.game-hud{display:flex;justify-content:space-between;align-items:center;padding:10px 18px;background:linear-gradient(135deg,var(--surface),var(--primary));border-bottom:2px solid var(--accent);font-weight:700;flex-wrap:wrap;gap:10px;font-size:.9rem}
.game-hud button{background:var(--bg);border:1px solid var(--accent);color:var(--accent-l);padding:6px 12px;border-radius:8px;font:inherit;font-weight:700;cursor:pointer;font-size:.82rem}
.game-hud .hud-item{background:rgba(0,0,0,.4);padding:5px 12px;border-radius:8px;color:var(--accent-l);font-family:'Consolas',monospace;font-size:.86rem}
.game-canvas{display:block;margin:auto;max-width:100%;max-height:calc(100vh - 130px);background:#87ceeb;image-rendering:pixelated;border:2px solid var(--accent)}
.game-wrap{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#F5E19C}
.game-touch{position:absolute;inset:auto 18px 18px;display:none;justify-content:space-between;align-items:end;pointer-events:none;z-index:5}
.game-touch button{width:58px;height:58px;border-radius:50%;border:2px solid rgba(255,204,80,.7);background:rgba(23,26,74,.82);color:#F5E19C;font-size:1.35rem;font-weight:800;touch-action:none;pointer-events:auto;user-select:none}
.touch-left{display:flex;gap:10px}
.touch-jump{margin-left:auto}
@media (max-width:800px),(pointer:coarse){
  .game-touch{display:flex}
  .game-hud{font-size:.78rem;padding:7px 9px}
  .game-hud .hud-item{padding:4px 7px}
  .game-canvas{max-height:calc(100vh - 170px)}
}

.game-hint{text-align:center;padding:8px;background:var(--surface);color:var(--muted);font-size:.82rem;border-top:1px solid var(--border)}
.game-question,.game-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:460;display:none;align-items:center;justify-content:center;padding:20px}
.game-question.on,.game-overlay.on{display:flex}
.gq-box{background:var(--surface);border:2px solid var(--accent);border-radius:16px;max-width:620px;width:100%;max-height:90vh;overflow-y:auto}
.gq-head{background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);padding:14px 22px;font-weight:800;font-size:1.05rem;border-radius:14px 14px 0 0}
.gq-body{padding:20px 22px}
.gq-q{color:var(--text);font-weight:600;font-size:1rem;line-height:1.6;margin-bottom:16px}
.gq-opts{display:flex;flex-direction:column;gap:8px}
.gq-opt{text-align:left;padding:12px 16px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;cursor:pointer;font-size:.9rem}
.gq-opt:hover:not(:disabled){border-color:var(--accent-l);background:var(--primary)}
.gq-opt.correct{background:rgba(46,160,67,.25);border-color:var(--ok);color:#A2CA8E}
.gq-opt.wrong{background:rgba(220,50,50,.2);border-color:var(--err);color:#ff8888}
.gq-feedback{margin-top:14px;padding:12px 16px;border-radius:10px;background:rgba(255,204,80,.08);border-left:3px solid var(--accent-l);font-size:.9rem;color:var(--text);display:none}
.gq-feedback.on{display:block}
.game-overlay .gq-box{text-align:center;padding:32px 26px}
.game-overlay h2{color:var(--accent-l);font-size:1.8rem;margin-bottom:14px}
.game-overlay p{color:var(--text);font-size:1rem;margin-bottom:18px}
.game-overlay .ov-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.game-overlay .ov-btns button{padding:12px 22px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:700;cursor:pointer;font-size:.92rem}
.game-overlay .ov-btns button.pri{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.locked-overlay{position:absolute;inset:0;background:rgba(0,0,0,.75);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:2.2rem}
.dash-hero{background:linear-gradient(135deg,var(--surface),var(--primary));border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:22px}
.dash-hero h1{font-size:1.9rem;margin-bottom:8px}
.dash-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:18px}
.stat-card{background:rgba(0,0,32,.5);border:1px solid var(--border);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--accent)}
.stat-card .stat-icon{font-size:1.4rem}
.stat-card .stat-value{font-size:1.5rem;font-weight:800;color:var(--accent-l);line-height:1}
.stat-card .stat-label{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;font-weight:600}
.stat-card.blue::before{background:#1466C3}.stat-card.blue .stat-value{color:#1466C3}
.stat-card.green::before{background:#2ea043}.stat-card.green .stat-value{color:#A2CA8E}
.stat-card.red::before{background:#dc3232}.stat-card.red .stat-value{color:#ff8888}
.stat-card.purple::before{background:#8a5adb}.stat-card.purple .stat-value{color:#b48cff}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}
@media(max-width:860px){.dash-grid{grid-template-columns:1fr}}
.dash-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:18px}
.dash-panel h3{color:var(--accent-l);font-size:1rem;margin-bottom:12px;font-weight:800;display:flex;align-items:center;gap:8px}
.dash-panel h3 .tag{font-size:.66rem;background:rgba(255,204,80,.15);color:var(--accent-l);padding:2px 8px;border-radius:10px;font-weight:600}
.dash-panel svg{display:block;width:100%;height:auto;max-height:280px}
.dash-table{width:100%;border-collapse:collapse;font-size:.86rem}
.dash-table th{text-align:left;padding:10px 8px;color:var(--accent-l);font-weight:700;font-size:.72rem;letter-spacing:.8px;text-transform:uppercase;border-bottom:1px solid var(--border)}
.dash-table td{padding:9px 8px;color:var(--text);border-bottom:1px solid rgba(255,204,80,.08)}
.dash-table .mod-prog-bar{height:6px;background:var(--primary);border-radius:3px;overflow:hidden;min-width:80px}
.dash-table .mod-prog-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));transition:width .3s}
.dash-table .mod-prog-txt{font-size:.72rem;color:var(--muted);margin-left:6px;font-weight:600}
.dash-table .acc{display:inline-block;padding:2px 8px;border-radius:8px;font-size:.74rem;font-weight:700}
.dash-table .acc.high{background:rgba(46,160,67,.2);color:#A2CA8E}
.dash-table .acc.mid{background:rgba(255,152,0,.2);color:#F5E19C}
.dash-table .acc.low{background:rgba(220,50,50,.2);color:#ff8888}
.dash-table .acc.none{background:rgba(184,188,208,.15);color:var(--muted)}
.achievements{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.achievement{background:rgba(0,0,32,.5);border:1px solid var(--border);border-radius:12px;padding:12px;text-align:center;transition:.2s}
.achievement.locked{opacity:.4;filter:grayscale(1)}
.achievement.unlocked{border-color:var(--accent);background:rgba(255,152,0,.08)}
.achievement .ach-icon{font-size:1.8rem;margin-bottom:4px}
.achievement .ach-name{font-size:.8rem;font-weight:700;color:var(--text);margin-bottom:2px}
.achievement .ach-desc{font-size:.68rem;color:var(--muted);line-height:1.3}
.heatmap{display:grid;grid-template-columns:repeat(15,1fr);gap:4px;margin-top:8px}
.heat-cell{aspect-ratio:1;border-radius:3px;background:rgba(184,188,208,.1);cursor:help}
.heat-cell.lvl1{background:rgba(255,204,80,.3)}
.heat-cell.lvl2{background:rgba(255,204,80,.55)}
.heat-cell.lvl3{background:rgba(255,204,80,.8)}
.heat-cell.lvl4{background:#F5E19C}
.goals-list{display:flex;flex-direction:column;gap:10px}
.goal-item{background:rgba(0,0,32,.5);border:1px solid var(--border);border-radius:12px;padding:14px;position:relative}
.goal-item.done{border-color:var(--ok);background:rgba(46,160,67,.08)}
.goal-item .goal-title{font-weight:700;color:var(--text);margin-bottom:4px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.goal-item .goal-type{font-size:.7rem;color:var(--accent-l);background:rgba(255,204,80,.1);padding:2px 8px;border-radius:8px;font-weight:600}
.goal-item .goal-progress{font-size:.84rem;color:var(--muted);margin:8px 0}
.goal-item .goal-bar{height:8px;background:var(--primary);border-radius:4px;overflow:hidden}
.goal-item .goal-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));transition:width .4s}
.goal-item .goal-actions{position:absolute;top:10px;right:10px}
.goal-item .goal-actions button{background:transparent;border:1px solid var(--border);color:var(--muted);width:26px;height:26px;border-radius:6px;cursor:pointer;font-size:.8rem;padding:0}
.goal-form{display:grid;gap:8px;margin-top:14px;padding-top:14px;border-top:1px solid var(--border)}
.goal-form label{font-size:.72rem;color:var(--accent-l);font-weight:700}
.goal-form input, .goal-form select{background:var(--bg);border:1px solid var(--border);color:var(--text);font:inherit;padding:8px 12px;border-radius:8px;outline:none;font-size:.88rem;width:100%}
.goal-form input:focus, .goal-form select:focus{border-color:var(--accent)}
.goal-form .row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ach-notif{position:fixed;top:80px;right:22px;background:linear-gradient(135deg,var(--surface),var(--primary));border:2px solid var(--accent);border-radius:16px;padding:16px;max-width:360px;z-index:800;box-shadow:0 20px 60px rgba(0,0,0,.7);display:flex;gap:14px;align-items:center;transform:translateX(420px);transition:transform .5s cubic-bezier(.2,.9,.4,1.1)}
.ach-notif.show{transform:translateX(0)}
.ach-notif .an-icon{font-size:2.6rem;flex-shrink:0;animation:achBounce .7s}
@keyframes achBounce{0%{transform:scale(0)}60%{transform:scale(1.3)}100%{transform:scale(1)}}
.ach-notif .an-text{flex:1;line-height:1.4}
.ach-notif .an-tag{font-size:.66rem;color:var(--accent-l);font-weight:800;letter-spacing:1.2px}
.ach-notif .an-name{font-size:1rem;color:var(--text);font-weight:800;margin:2px 0}
.ach-notif .an-desc{font-size:.76rem;color:var(--muted)}
.ach-notif .an-cat{font-size:.74rem;color:var(--accent-l);margin-top:6px;font-weight:700}
.cat-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.cat-card{background:rgba(0,0,32,.5);border:2px solid var(--border);border-radius:14px;padding:12px;text-align:center;cursor:pointer;transition:.2s;position:relative}
.cat-card.unlocked{border-color:var(--accent-l)}
.cat-card.unlocked:hover{transform:translateY(-3px);border-color:var(--accent);background:var(--primary)}
.cat-card.locked{opacity:.35;cursor:not-allowed}
.cat-card.locked .cat-svg{filter:brightness(0.12) grayscale(1)}
.cat-card .cat-svg{width:64px;height:64px;margin:0 auto 6px;display:block}
.cat-card .cat-name{font-size:.84rem;font-weight:700;color:var(--text)}
.cat-card .cat-personality{font-size:.68rem;color:var(--muted);line-height:1.3;margin-top:2px}
.cat-card .cat-mood-badge{position:absolute;top:6px;right:8px;font-size:1rem}
.cat-modal{position:fixed;inset:0;background:rgba(0,0,32,.92);z-index:500;display:none;align-items:center;justify-content:center;padding:20px}
.cat-modal.open{display:flex}
.cat-panel{background:var(--surface);border:2px solid var(--accent);border-radius:20px;max-width:540px;width:100%;max-height:92vh;overflow-y:auto;padding:22px;position:relative}
.cat-panel .cat-close{position:absolute;top:14px;right:14px;background:rgba(0,0,0,.35);border:none;color:var(--text);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1.1rem;font-weight:700;z-index:2}
