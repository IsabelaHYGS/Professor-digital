function pdFlow(items){return `<div class="pd-flow">${items.map(x=>`<div class="node">${pdEsc(x)}</div>`).join('')}</div>`}
function pdCards(items){return `<div class="pd-grid">${items.map(x=>`<div class="pd-card"><b>${pdEsc(x[0])}</b><p>${pdEsc(x[1])}</p></div>`).join('')}</div>`}
