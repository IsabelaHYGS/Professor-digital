function updateFCProgress(mid, idx, rating){
  const s=loadFC(); if (!s[mid]) s[mid]={}; if (!s[mid][idx]) s[mid][idx]={level:0,lastSeen:0,attempts:0};
  const c=s[mid][idx]; c.attempts=(c.attempts||0)+1; c.lastSeen=Date.now();
  if (rating === 'easy') c.level = Math.min(5, (c.level||0)+1);
  else if (rating === 'hard') c.level = Math.max(0, (c.level||0));
