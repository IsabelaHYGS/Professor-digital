    <div class="afk-book-toolbar">
      <div><span class="afk-book-toolbar-dot">📖</span><span>CRÔNICAS DO SABER</span></div>
      <button class="afk-book-close" onclick="document.getElementById('afkBookReader')?.remove()">✕ Fechar</button>
    </div>
    <article class="afk-book-page">
