.afk-slot:hover{border-color:var(--accent-l);background:rgba(255,204,80,.07)}
.afk-slot.filled{border-style:solid;border-color:rgba(255,204,80,.45)}
.afk-slot img{width:70px;height:70px;object-fit:cover;border-radius:9px;display:block;margin:0 auto 5px}
.afk-slot .slot-name{font-size:.7rem;font-weight:700;color:var(--text)}
.afk-slot .slot-role{font-size:.6rem;color:var(--muted)}
.afk-formation-help{font-size:.72rem;color:var(--muted);margin-top:9px;line-height:1.5}
.afk-slot.selected{border-color:var(--accent-l);box-shadow:0 0 0 2px rgba(255,204,80,.18),0 0 24px rgba(255,204,80,.10);background:rgba(255,204,80,.10)}
.afk-slot .slot-action{font-size:.58rem;color:var(--accent-l);margin-top:4px;font-weight:700}
.afk-hero-card.formation-picked{border-color:#F5E19C;box-shadow:0 0 0 3px rgba(255,211,77,.16),0 0 24px rgba(255,211,77,.10);transform:translateY(-2px)}
.afk-slot .slot-remove{font-size:.58rem;padding:4px 7px;margin-top:6px;background:rgba(255,100,100,.08);border-color:rgba(255,130,130,.25);color:#ffc0c0}
.afk-battle-status.battle-running{border-color:rgba(255,204,80,.45);background:linear-gradient(90deg,rgba(255,204,80,.12),rgba(139,92,246,.10));color:#ffe7a0;box-shadow:0 0 22px rgba(255,204,80,.08)}
.battle-spinner{display:inline-block;animation:afkBattleSpin 1s linear infinite;margin-right:4px}@keyframes afkBattleSpin{to{transform:rotate(360deg)}}
.btn:disabled{opacity:.58;cursor:not-allowed;transform:none!important}
.afk-formation-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:10px;padding:9px 11px;border:1px solid rgba(255,204,80,.18);border-radius:10px;background:rgba(255,204,80,.04)}
.afk-formation-selected{font-size:.72rem;color:var(--text)}
.afk-battle-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
.afk-power-box{background:#F5E19C;border:1px solid var(--border);border-radius:12px;padding:12px}
