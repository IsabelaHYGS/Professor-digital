/* v28 — Dark mode stays faithful to the original Professor Digital palette.
   Light mode uses the supplied palette with softened neutrals, gradients and restrained contrast. */
.theme-toggle{
  appearance:none;border:1px solid rgba(255,204,80,.20);background:rgba(23,26,74,.72);color:#ffcc50;
  border-radius:10px;padding:7px 11px;font:700 .72rem 'Inter','Segoe UI',system-ui,sans-serif;cursor:pointer;
  transition:transform .18s ease,background .18s ease,border-color .18s ease;white-space:nowrap;
}
.theme-toggle:hover{transform:translateY(-1px);background:rgba(33,44,121,.92);border-color:#ffcc50}
body.light-theme{
  --bg:#E7EEEB;
  --surface:#F2EEE5;
  --primary:#1466C3;
  --accent:#D98A55;
  --accent-l:#8B6B25;
  --text:#193943;
  --muted:#5F767A;
  --border:rgba(20,102,195,.15);
  --ok:#4F936F;
  background:
    radial-gradient(circle at 10% 0%,rgba(162,202,142,.30),transparent 30%),
    radial-gradient(circle at 92% 8%,rgba(239,174,120,.20),transparent 28%),
    linear-gradient(145deg,#E7EEEB 0%,#EEF1EA 48%,#E8ECE7 100%);
  color:var(--text);
}
