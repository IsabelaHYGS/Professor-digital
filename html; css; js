  if (ov.requestFullscreen) ov.requestFullscreen().catch(()=>{});
  requestAnimationFrame(()=>setupSVGDraw('pres'));
}

function closePresentation(){
  document.getElementById('presOverlay').classList.remove('on');
  document.body.style.overflow='';
  stopDrawing('pres');
  if (document.fullscreenElement&&document.exitFullscreen) document.exitFullscreen().catch(()=>{});
}

function togglePresentation(){
  if (document.getElementById('presOverlay').classList.contains('on')) closePresentation();
  else openPresentation();
}

function openSlides(){
  if (state.view!=='modulo'||!state.mod){ toast('Abra um módulo'); return; }
  slideIdx=1;
  const modal=document.getElementById('slidesModal');
  modal.classList.add('on');
  document.body.style.overflow='hidden';
  renderSlide();
  if (modal.requestFullscreen) modal.requestFullscreen().catch(()=>{});
}

function closeSlides(){
  document.getElementById('slidesModal').classList.remove('on');
  document.body.style.overflow='';
  if (document.fullscreenElement&&document.exitFullscreen) document.exitFullscreen().catch(()=>{});
}

function slideNav(d){
  if (!d) return;
  const next=Math.max(1,Math.min(TOTAL_SLIDES,slideIdx+d));
  if (next===slideIdx) return;
  slideIdx=next;
  renderSlide();
}


