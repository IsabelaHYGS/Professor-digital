/* GAME */
const GAME = { canvas:null, ctx:null, W:960, H:480, player:null, platforms:[], coins:[], enemies:[], gates:[], goal:null, islandIdx:0, phaseIdx:0, lives:3, score:0, cam:0, keys:{left:false,right:false,jump:false}, jumpLocked:false, rafId:null, questionOpen:false, overlayOpen:false, paused:false, currentTarget:null, currentQuestion:null, particles:[] };
const GAME_ISLANDS = [
  {nome:'Física',cor:'#0a3a5c',ceu:'#1a4a6c',chao:'#1a5c2c',icone:'⚛',disc:'fisica'},
  {nome:'Biologia',cor:'#0a3a2c',ceu:'#1a5a3c',chao:'#0a7a2c',icone:'🧬',disc:'biologia'},
  {nome:'Química',cor:'#3a0a1c',ceu:'#5c1a2c',chao:'#3c0a1c',icone:'🧪',disc:'quimica'},
  {nome:'Robótica',cor:'#3a2a0a',ceu:'#6c4a1a',chao:'#5c3a0a',icone:'🤖',disc:'robotica'},
  {nome:'Final',cor:'#2a0a3a',ceu:'#4a1a6c',chao:'#1a0a3a',icone:'🏆',disc:'final'}
];
const GAME_TOTAL_FASES = 3, GAME_LEVEL_WIDTH = 2400;

function loadGameProgress(){
  if (isAdmin()) return { unlocked:5, maxScore:9999 };
  try { return JSON.parse(pdStorage.getItem(GAME_KEY)) || {unlocked:1,maxScore:0}; }
  catch { return {unlocked:1,maxScore:0}; }
}
function saveGameProgress(p){ if (isAdmin()) return; pdStorage.setItem(GAME_KEY,JSON.stringify(p)); }

function renderGameHub(){
  const p=loadGameProgress(), app=document.getElementById('app'); if (!app) return;
  app.innerHTML = `<section class="hero" style="background:linear-gradient(135deg,#66AF91,#4a1a6c)">
    <h1>🎮 Ilhas do <span class="accent">Conhecimento</span></h1>
    <p>Atravesse 5 ilhas respondendo questões para derrotar inimigos ❓ e abrir portões 🚪.</p>
    <div class="badges"><span class="badge">← → mover</span><span class="badge">↑ pular</span><span class="badge">3 fases por ilha</span><span class="badge">⭐ Recorde: ${p.maxScore}</span></div>
  </section>
  <h2>Escolha uma ilha</h2>
  <div class="grid-disc">${GAME_ISLANDS.map((isl,i)=>{
    const u=i<p.unlocked, done=i<p.unlocked-1;
    return `<div class="card-disc" style="background:linear-gradient(135deg,${isl.cor},${isl.ceu});border:2px solid ${u?isl.cor:'#333'};${u?'':'cursor:not-allowed'}" onclick="${u?`startGame(${i})`:`toast('🔒 Bloqueada')`}">
      <div class="icon" style="font-size:2.2rem">${isl.icone}</div><h3>${isl.nome}</h3>
      <p>${done?'✓ Concluída':u?'▶ Jogar':'🔒'}</p>${u?'':'<div class="locked-overlay">🔒</div>'}
    </div>`;
  }).join('')}</div>`;
}

function startGame(i){
  GAME.islandIdx=i; GAME.phaseIdx=0; GAME.lives=3; GAME.score=0; GAME.paused=false;
  document.getElementById('gameModal').classList.add('on');
  startPhase();
}

function restartPhase(){
  startPhase();
}

function startPhase(){
  const modal=document.getElementById('gameModal'); if (!modal) return;
  modal.classList.add('on');
  GAME.canvas=document.getElementById('gameCanvas'); if (!GAME.canvas) return;
  GAME.ctx=GAME.canvas.getContext('2d');
  GAME.questionOpen=false; GAME.overlayOpen=false; GAME.paused=false;
  GAME.canvas.focus?.();
  loadLevel(); updateGameHUD();
  const pb=document.getElementById('gamePauseBtn'); if (pb) pb.textContent='⏸ Pausar';
  if (GAME.rafId) cancelAnimationFrame(GAME.rafId);
  gameLoop();
}

function toggleGamePause(){
  if (GAME.questionOpen||GAME.overlayOpen) return;
  GAME.paused=!GAME.paused;
  const b=document.getElementById('gamePauseBtn');
  if (b) b.textContent=GAME.paused?'▶ Continuar':'⏸ Pausar';
}

function gameTouch(key,on){
  if (GAME.paused||GAME.questionOpen||GAME.overlayOpen) return;
  GAME.keys[key]=on;
  if (key==='jump' && on) GAME.jumpLocked=false;
}

function closeGame(){
  document.getElementById('gameModal').classList.remove('on');
  document.getElementById('gameQuestion').classList.remove('on');
  document.getElementById('gameOverlay').classList.remove('on');
  GAME.questionOpen=false; GAME.overlayOpen=false; GAME.paused=false;
  GAME.keys={left:false,right:false,jump:false};
  if (GAME.rafId) cancelAnimationFrame(GAME.rafId);
  GAME.rafId=null;
  state.view='game'; renderNav(); renderGameHub();
}

function updateGameHUD(){
  const isl=GAME_ISLANDS[GAME.islandIdx];
  const elI=document.getElementById('gameIsland'), elL=document.getElementById('gameLives'), elS=document.getElementById('gameScore'), elP=document.getElementById('gamePhase');
  if (elI) elI.textContent=isl.icone+' '+isl.nome;
  if (elL) elL.textContent='❤'.repeat(Math.max(0,GAME.lives))+'·'.repeat(Math.max(0,3-GAME.lives));
  if (elS) elS.textContent='⭐ '+GAME.score;
  if (elP) elP.textContent='Fase '+(GAME.phaseIdx+1)+'/'+GAME_TOTAL_FASES;
}

function loadLevel(){
  const ph=GAME.phaseIdx;
  GAME.platforms=[{x:GAME_LEVEL_WIDTH/2,y:460,w:GAME_LEVEL_WIDTH,h:40,type:'ground'}];
  GAME.coins=[]; GAME.enemies=[]; GAME.gates=[]; GAME.particles=[];

  const nP=5+ph;
  for(let i=0;i<nP;i++){
    const px=365+i*220, py=350-((i%3)*60);
    GAME.platforms.push({x:px,y:py,w:130,h:20,type:'plat'});
  }
  for(let i=0;i<nP;i++){
    const p=GAME.platforms[i+1];
    GAME.coins.push({x:p.x,y:p.y-p.h/2-34,r:12,collected:false});
  }

  const nE=2+ph;
  for(let i=0;i<nE;i++){
    const ex=560+i*360;
    const isBoss=(i===nE-1)&&(ph===GAME_TOTAL_FASES-1);
    GAME.enemies.push({x:ex,y:400,w:38,h:38,vx:1+ph*0.4,minX:ex-130,maxX:ex+130,dead:false,isBoss,hp:isBoss?3:1});
  }

  GAME.gates.push({x:2000,y:390,w:30,h:100,open:false});
  GAME.goal={x:2160,y:385,w:34,h:70,reached:false};
  GAME.player={x:80,y:390,w:32,h:32,vx:0,vy:0,onGround:false,facing:1,invuln:0};
  GAME.cam=0; GAME.keys={left:false,right:false,jump:false}; GAME.jumpLocked=false;
}

function gameLoop(){
  if (!GAME.ctx) return;
  if (!GAME.questionOpen&&!GAME.overlayOpen&&!GAME.paused){
    updatePlayer(); updateEnemies(); updateParticles();
  }
  renderGame();
  GAME.rafId=requestAnimationFrame(gameLoop);
}

function updatePlayer(){
  const p=GAME.player; if (!p) return;
  const acc=0.7,fric=0.82,grav=0.75,jump=-14;
  if(GAME.keys.left){p.vx-=acc;p.facing=-1;}
  if(GAME.keys.right){p.vx+=acc;p.facing=1;}
  if(!GAME.keys.left&&!GAME.keys.right)p.vx*=fric;
  p.vx=Math.max(-7,Math.min(7,p.vx));

  if(GAME.keys.jump&&p.onGround&&!GAME.jumpLocked){
    p.vy=jump;p.onGround=false;GAME.jumpLocked=true;
  }
  if(!GAME.keys.jump) GAME.jumpLocked=false;

  p.vy=Math.min(16,p.vy+grav);
  p.x+=p.vx;p.y+=p.vy;
  if(p.x<20)p.x=20;
  if(p.x>GAME_LEVEL_WIDTH-20)p.x=GAME_LEVEL_WIDTH-20;

  p.onGround=false;
  for(const plat of GAME.platforms){
    if(rectCollide(p,plat)){
      const pBottom=p.y+p.h/2, pTop=p.y-p.h/2;
      const platTop=plat.y-plat.h/2, platBottom=plat.y+plat.h/2;
      if(p.vy>=0 && pBottom>=platTop && pBottom-p.vy<=platTop+8){
        p.y=platTop-p.h/2;p.vy=0;p.onGround=true;
      } else if(p.vy<0 && pTop<=platBottom && pTop-p.vy>=platBottom-8){
        p.y=platBottom+p.h/2;p.vy=0;
      }
    }
  }

  if(p.y>GAME.H+160){loseLife();return;}

  for(const c of GAME.coins){
    if(c.collected)continue;
    if(Math.hypot(p.x-c.x,p.y-c.y)<32){
      c.collected=true;GAME.score+=10;updateGameHUD();
      for(let i=0;i<6;i++)GAME.particles.push({x:c.x,y:c.y,vx:(Math.random()-0.5)*4,vy:-Math.random()*4,life:30,cor:'#F5E19C'});
    }
  }

  for(const g of GAME.gates){
    if(g.open)continue;
    if(rectCollide(p,g)){openQuestion(g,'gate');return;}
  }

  if(!GAME.goal.reached&&rectCollide(p,GAME.goal)){
    GAME.goal.reached=true;completePhase();return;
  }

  const tc=Math.max(0,Math.min(GAME_LEVEL_WIDTH-GAME.W,p.x-GAME.W/2));
  GAME.cam+=(tc-GAME.cam)*0.15;
  if(p.invuln>0)p.invuln--;
}

function updateEnemies(){
  const p=GAME.player;if(!p)return;
  for(const e of GAME.enemies){
    if(e.dead)continue;
    e.x+=e.vx;
    if(e.x<e.minX||e.x>e.maxX)e.vx*=-1;
    if(!GAME.questionOpen&&p.invuln<=0&&rectCollide(p,e)){openQuestion(e,'enemy');return;}
  }
}

function updateParticles(){
  for(const pt of GAME.particles){pt.x+=pt.vx;pt.y+=pt.vy;pt.vy+=0.3;pt.life--;}
  GAME.particles=GAME.particles.filter(pt=>pt.life>0);
}

function rectCollide(a,b){
  const ax=a.x-a.w/2,ay=a.y-a.h/2,bx=b.x-b.w/2,by=b.y-b.h/2;
  return ax<bx+b.w&&ax+a.w>bx&&ay<by+b.h&&ay+a.h>by;
}

function renderGame(){
  const ctx=GAME.ctx,W=GAME.W,H=GAME.H;if(!ctx)return;
  const isl=GAME_ISLANDS[GAME.islandIdx];
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle=isl.ceu;ctx.fillRect(0,0,W,H);
  const t=performance.now()*0.0002;
  ctx.fillStyle='rgba(255,255,255,.15)';
  for(let i=0;i<5;i++){
    const cx=((i*260)-GAME.cam*0.3+t*40)%(W+200)-100;
    ctx.beginPath();ctx.arc(cx,80+i*15,34,0,Math.PI*2);ctx.fill();
    ctx.beginPath();ctx.arc(cx+30,80+i*15,26,0,Math.PI*2);ctx.fill();
  }
  ctx.fillStyle=isl.cor;
  for(let i=0;i<8;i++){
    const mx=i*340-(GAME.cam*0.4)%340;
    ctx.beginPath();ctx.moveTo(mx,440);ctx.lineTo(mx+170,200+(i%3)*30);ctx.lineTo(mx+340,440);ctx.closePath();ctx.fill();
  }

  ctx.save();ctx.translate(-GAME.cam,0);
  for(const plat of GAME.platforms){
    ctx.fillStyle=plat.type==='ground'?isl.chao:isl.cor;
    ctx.fillRect(plat.x-plat.w/2,plat.y-plat.h/2,plat.w,plat.h);
    ctx.fillStyle='rgba(255,255,255,.15)';
    ctx.fillRect(plat.x-plat.w/2,plat.y-plat.h/2,plat.w,6);
  }
  for(const c of GAME.coins){
    if(c.collected)continue;
    ctx.save();ctx.translate(c.x,c.y+Math.sin(performance.now()*0.005+c.x)*3);
    ctx.fillStyle='#F5E19C';ctx.beginPath();ctx.arc(0,0,c.r,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#EFAE78';ctx.font='bold 14px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('⭐',0,0);ctx.restore();
  }
  for(const g of GAME.gates){
    if(g.open)continue;
    ctx.fillStyle='#1466C3';ctx.fillRect(g.x-g.w/2,g.y-g.h/2,g.w,g.h);
    ctx.strokeStyle='#F5E19C';ctx.lineWidth=3;ctx.strokeRect(g.x-g.w/2,g.y-g.h/2,g.w,g.h);
    ctx.font='20px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('🚪',g.x,g.y);
  }
  if(GAME.goal){
    ctx.fillStyle='#666';ctx.fillRect(GAME.goal.x-2,GAME.goal.y-GAME.goal.h/2,4,GAME.goal.h);
    ctx.fillStyle='#2ea043';ctx.beginPath();ctx.moveTo(GAME.goal.x+2,GAME.goal.y-GAME.goal.h/2);ctx.lineTo(GAME.goal.x+32,GAME.goal.y-GAME.goal.h/2+12);ctx.lineTo(GAME.goal.x+2,GAME.goal.y-GAME.goal.h/2+26);ctx.closePath();ctx.fill();
    ctx.font='20px sans-serif';ctx.textAlign='center';ctx.fillText('🏁',GAME.goal.x+16,GAME.goal.y+20);
  }
  for(const e of GAME.enemies){
    if(e.dead)continue;
    const bob=Math.sin(performance.now()*0.006+e.x*0.01)*4;
    ctx.save();ctx.translate(e.x,e.y+bob);
    ctx.fillStyle=e.isBoss?'#dc3232':'#8a5adb';ctx.beginPath();ctx.arc(0,0,e.w/2,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(-6,-6,5,0,Math.PI*2);ctx.arc(6,-6,5,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#F5E19C';ctx.beginPath();ctx.arc(-6,-6,2,0,Math.PI*2);ctx.arc(6,-6,2,0,Math.PI*2);ctx.fill();
    ctx.fillStyle='#fff';ctx.font='bold 16px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(e.isBoss?'👹':'❓',0,6);ctx.restore();
  }
  for(const pt of GAME.particles){
    ctx.globalAlpha=pt.life/30;ctx.fillStyle=pt.cor;ctx.beginPath();ctx.arc(pt.x,pt.y,3,0,Math.PI*2);ctx.fill();
  }
  ctx.globalAlpha=1;drawPlayer(ctx);ctx.restore();

  if(GAME.paused){
    ctx.fillStyle='rgba(0,0,0,.55)';ctx.fillRect(0,0,W,H);
    ctx.fillStyle='#F5E19C';ctx.font='800 34px sans-serif';ctx.textAlign='center';ctx.fillText('⏸ PAUSADO',W/2,H/2);
