<script>

/* ============ STORAGE SEGURO ============ */
/*
  Alguns ambientes de preview/iframe (como sandboxes com iframe)
  bloqueiam window.localStorage e lançam SecurityError.
  O adaptador tenta usar localStorage normalmente e, se ele estiver
  bloqueado, usa memória para que a aplicação continue funcionando.
*/
const pdMemoryStorage = Object.create(null);
let pdNativeStorage = null;

try {
  const testStorage = window.localStorage;
  const testKey = '__pd_storage_test__';
  testStorage.setItem(testKey, 'ok');
  testStorage.removeItem(testKey);
  pdNativeStorage = testStorage;
} catch (e) {
  pdNativeStorage = null;
}

const pdStorage = {
  getItem(key) {
    try {
      if (pdNativeStorage) return pdNativeStorage.getItem(key);
    } catch (e) {}
    return Object.prototype.hasOwnProperty.call(pdMemoryStorage, key)
      ? pdMemoryStorage[key]
      : null;
  },
  setItem(key, value) {
    try {
      if (pdNativeStorage) {
        pdNativeStorage.setItem(key, String(value));
        return;
      }
    } catch (e) {
      pdNativeStorage = null;
    }
    pdMemoryStorage[key] = String(value);
  },
  removeItem(key) {
    try {
      if (pdNativeStorage) {
        pdNativeStorage.removeItem(key);
        return;
      }
    } catch (e) {
      pdNativeStorage = null;
    }
    delete pdMemoryStorage[key];
  },
  clear() {
    try {
      if (pdNativeStorage) {
        pdNativeStorage.clear();
        return;
      }
    } catch (e) {
      pdNativeStorage = null;
    }
    for (const key of Object.keys(pdMemoryStorage)) delete pdMemoryStorage[key];
  },
  key(index) {
    try {
      if (pdNativeStorage) return pdNativeStorage.key(index);
    } catch (e) {
      pdNativeStorage = null;
    }
    return Object.keys(pdMemoryStorage)[index] ?? null;
  },
  get length() {
    try {
      if (pdNativeStorage) return pdNativeStorage.length;
    } catch (e) {
      pdNativeStorage = null;
    }
    return Object.keys(pdMemoryStorage).length;
  }
};

window.addEventListener('error', e => {
  const b = document.getElementById('errorBanner');
  if (b){ b.style.display = 'block'; b.textContent = '⚠ ' + e.message + ' em ' + (e.lineno||''); }
});

/* ============ CONTEÚDO ============ */
const CT = {"F1":{"p":"Uma questão de Física pode parecer difícil porque o texto é grande, mas o raciocínio costuma começar por três perguntas: <strong>o que foi dado, o que está sendo pedido e qual fenômeno físico liga essas informações?</strong>","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como pensar em uma questão</h4><p>Não comece escolhendo uma fórmula. Primeiro separe os <strong>dados</strong> e escreva as unidades. Depois identifique o fenômeno: movimento, força, energia, eletricidade, ondas etc. Só então procure a relação matemática adequada.</p><p><strong>Passo 1 — Dados:</strong> retire do enunciado apenas as informações úteis. <strong>Passo 2 — Pedido:</strong> escreva exatamente o que precisa encontrar. <strong>Passo 3 — Modelo:</strong> escolha a lei ou relação que conecta os dados ao pedido. <strong>Passo 4 — Unidades:</strong> coloque as grandezas no mesmo sistema quando necessário. <strong>Passo 5 — Sentido físico:</strong> veja se o resultado é razoável.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> se uma questão informa 72 km/h e pede a velocidade em m/s, não é uma questão para decorar uma fórmula de movimento. É uma conversão: 72 ÷ 3,6 = 20 m/s.</div><p><strong>Erro comum:</strong> substituir números em uma fórmula antes de entender o que cada número representa. Em questões do ENEM, a interpretação do gráfico, tabela ou situação pode ser mais importante que a conta.</p>","ap":"<strong>Estratégia dos 5 passos:</strong> dados → pedido → fenômeno → relação física → conferência. Uma boa leitura transforma um texto aparentemente complexo em pequenas decisões.","m":"<div class=&quot;formula-block&quot;>72 km/h ÷ 3,6 = 20 m/s<br>I = U/R<br>d = v·t</div>","a":"Interpretar gráficos, tabelas, unidades e relações matemáticas é útil para Física escolar e para situações cotidianas.","en":"Questões do ENEM frequentemente misturam interpretação de texto, gráficos, tabelas e conceitos de mais de uma área.","cu":"A unidade de uma resposta também é uma pista: ela ajuda a perceber se você calculou a grandeza certa.","c":"Monte um roteiro de resolução e tente explicar em voz alta por que escolheu cada relação.","r":"Se travar, volte ao enunciado e destaque dados, pedido e unidades antes de olhar qualquer fórmula.","f":["INEP — Matriz do ENEM"]},"F2":{"p":"A eletricidade precisa viajar grandes distâncias entre usinas e cidades. O problema é que os fios possuem resistência e, quando há corrente, parte da energia elétrica é transformada em energia térmica pelo <strong>efeito Joule</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que é um transformador?</h4><p>Um <strong>transformador</strong> é um dispositivo que altera a tensão de uma corrente alternada por meio da indução eletromagnética. Ele possui uma bobina primária, uma bobina secundária e, normalmente, um núcleo ferromagnético que favorece o fluxo magnético.</p><p>Quando a corrente alternada passa pela primária, o campo magnético varia. Essa variação produz uma tensão induzida na secundária. A quantidade de espiras de cada bobina determina a relação entre as tensões.</p><div class=&quot;formula-block&quot;>V₁/V₂ = N₁/N₂</div><p>Se a secundária tem mais espiras que a primária, a tensão aumenta: é um <strong>transformador elevador</strong>. Se tem menos, a tensão diminui: é um <strong>abaixador</strong>.</p><p>No modelo ideal, a potência é conservada:</p><div class=&quot;formula-block&quot;>V₁ · i₁ = V₂ · i₂</div><p>Isso explica por que elevar a tensão é útil na transmissão: para uma mesma potência, uma tensão maior permite uma <strong>corrente menor</strong>. Como as perdas resistivas dependem de i², reduzir a corrente diminui bastante as perdas.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> N₁ = 100, N₂ = 500 e V₁ = 20 V. Então V₂ = 20 × 500/100 = 100 V.</div><p><strong>Importante:</strong> o transformador convencional depende de fluxo magnético variável, por isso é associado à corrente alternada.</p>","ap":"<strong>Visão completa:</strong> geração → transformador elevador → linhas de transmissão → subestação → transformadores abaixadores → consumidores.","m":"<div class=&quot;formula-block&quot;>V₁/V₂ = N₁/N₂<br>V₁·i₁ = V₂·i₂<br>P<sub>perdas</sub> = R·i²</div>","a":"Está presente em redes elétricas, carregadores, fontes e subestações. O objetivo não é criar energia, mas adaptar tensão e corrente.","en":"Em questões de transmissão, procure a relação entre potência, tensão, corrente e perdas por efeito Joule.","cu":"O núcleo e as bobinas permitem o acoplamento magnético entre os circuitos sem uma ligação elétrica direta entre primária e secundária.","c":"Explique com suas palavras por que aumentar a tensão pode diminuir as perdas.","r":"Não confunda aumentar tensão com criar potência: no transformador ideal, quando V aumenta, a corrente diminui proporcionalmente.","f":["Toda Matéria — Transformadores"]},"F3":{"p":"Uma onda pode ser observada no mar, em uma corda ou no som. Embora esses fenômenos pareçam diferentes, todos envolvem uma <strong>perturbação que se propaga</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que é uma onda?</h4><p>Uma onda é uma perturbação que se propaga, levando <strong>energia</strong> de uma região para outra sem transportar matéria de forma líquida junto com a propagação. As partículas do meio podem oscilar enquanto a perturbação avança.</p><h4>Como classificar?</h4><p><strong>Mecânicas</strong> precisam de um meio material, como o som no ar. <strong>Eletromagnéticas</strong> não precisam de meio material e podem se propagar no vácuo, como a luz.</p><p>Também podemos classificar pela direção da vibração. Em uma onda <strong>transversal</strong>, a vibração é perpendicular à direção de propagação. Em uma <strong>longitudinal</strong>, é paralela.</p><p>As grandezas principais são amplitude, comprimento de onda λ, frequência f, período T e velocidade v.</p><div class=&quot;formula-block&quot;>T = 1/f<br>v = λ·f</div><p>Essas relações mostram que velocidade, comprimento de onda e frequência estão conectados. Se a frequência aumenta enquanto a velocidade permanece constante, o comprimento de onda diminui.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> v = 340 m/s e f = 170 Hz. Logo, λ = 340/170 = 2 m.</div><p>Fenômenos importantes são <strong>reflexão, refração, difração e interferência</strong>.</p>","ap":"<strong>Mapa mental:</strong> onda = perturbação + propagação + transporte de energia. Depois classifique por meio, dimensão e direção da vibração.","m":"<div class=&quot;formula-block&quot;>T = 1/f<br>v = λ·f</div>","a":"Som, ondas do mar, cordas vibrantes, luz, rádio e Wi-Fi podem ser estudados usando conceitos de ondulatória, embora tenham naturezas diferentes.","en":"O ENEM costuma apresentar ondas em gráficos, situações tecnológicas e fenômenos do cotidiano.","cu":"O som é uma onda mecânica: sem meio material, não há partículas para transmitir a perturbação sonora.","c":"Desenhe uma onda e identifique amplitude, λ, cristas e vales. Depois classifique som e luz.","r":"Não confunda amplitude com frequência: amplitude está relacionada ao tamanho da oscilação; frequência, ao número de oscilações por segundo.","f":["Toda Matéria — Ondas"]},"F4":{"p":"Duas ondas podem ter o mesmo formato geral e ainda assim apresentar frequências e períodos diferentes. Para comparar ondas, precisamos conhecer suas grandezas características.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>As cinco grandezas essenciais</h4><p><strong>Amplitude (A)</strong> mede o afastamento máximo em relação à posição de equilíbrio. <strong>Comprimento de onda (λ)</strong> é a distância entre pontos equivalentes consecutivos, como duas cristas.</p><p><strong>Frequência (f)</strong> é o número de oscilações por segundo e é medida em hertz. <strong>Período (T)</strong> é o tempo necessário para uma oscilação completa. Por isso, são grandezas inversas:</p><div class=&quot;formula-block&quot;>T = 1/f</div><p><strong>Velocidade (v)</strong> indica a rapidez com que a perturbação se propaga:</p><div class=&quot;formula-block&quot;>v = λ·f</div><p>Quando uma onda passa para outro meio, sua frequência é determinada pela fonte e, em condições usuais, <strong>não muda</strong>. O que pode mudar é sua velocidade; como v = λf, o comprimento de onda também muda.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> se f = 50 Hz, T = 1/50 = 0,02 s. Se a velocidade é 300 m/s, λ = 300/50 = 6 m.</div><p>Uma maneira útil de memorizar é pensar: <strong>frequência responde “quantas vezes por segundo?”; período responde “quanto tempo para uma vez?”</strong></p>","ap":"Ao resolver problemas, escreva primeiro a relação entre as grandezas e só depois substitua os valores. Isso reduz erros de unidade e de inversão.","m":"<div class=&quot;formula-block&quot;>T = 1/f<br>v = λ·f</div>","a":"É útil em som, instrumentos musicais, telecomunicações e análise de sinais.","en":"Questões podem pedir comparação entre ondas sem exigir uma conta: observe o eixo, a distância entre ciclos e o número de oscilações.","cu":"Ao mudar de meio, a fonte continua vibrando na mesma frequência; por isso a frequência não simplesmente “vira outra”.","c":"Esboce duas ondas: uma com f maior e outra com f menor. Depois compare seus períodos.","r":"Não use amplitude para calcular frequência. São grandezas diferentes.","f":["Toda Matéria — Ondas"]},"F5":{"p":"Celulares, GPS, Bluetooth e Wi-Fi funcionam graças à transmissão de informações por <strong>ondas eletromagnéticas</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que são ondas eletromagnéticas?</h4><p>Ondas eletromagnéticas são oscilações acopladas dos campos elétrico e magnético. No modelo clássico, os campos são perpendiculares entre si e também à direção de propagação.</p><p>Diferentemente das ondas mecânicas, elas <strong>não precisam de um meio material</strong>. No vácuo, todas se propagam com aproximadamente:</p><div class=&quot;formula-block&quot;>c = 3·10⁸ m/s</div><p>A relação entre velocidade, comprimento de onda e frequência continua sendo:</p><div class=&quot;formula-block&quot;>c = λ·f</div><p>Isso significa que, para a mesma velocidade no vácuo, aumentar a frequência implica diminuir o comprimento de onda.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> uma onda de 2,4 GHz tem λ ≈ 0,125 m, ou 12,5 cm, no vácuo.</div><p>As ondas eletromagnéticas formam um espectro que inclui rádio, micro-ondas, infravermelho, luz visível, ultravioleta, raios X e gama.</p>","ap":"<strong>Ideia-chave:</strong> a tecnologia muda, mas o princípio físico permanece: uma onda eletromagnética pode carregar informação ao variar suas características de forma controlada.","m":"<div class=&quot;formula-block&quot;>c = λ·f<br>f = c/λ</div>","a":"Telefonia, rádio, televisão, Wi-Fi, Bluetooth e GPS usam diferentes regiões do espectro eletromagnético.","en":"Em uma questão, identifique primeiro a frequência ou o comprimento de onda e verifique se a propagação ocorre no vácuo ou em outro meio.","cu":"Maxwell formulou a teoria eletromagnética que levou à previsão das ondas eletromagnéticas; posteriormente, experimentos confirmaram sua existência.","c":"Escolha cinco tecnologias e tente identificar que tipo de onda eletromagnética elas utilizam.","r":"Não confunda “não precisar de meio” com “não interagir com matéria”: ondas eletromagnéticas interagem com materiais de várias formas.","f":["Griffiths — Eletrodinâmica"]},"F6":{"p":"O espectro eletromagnético é uma forma de organizar as radiações eletromagnéticas de acordo principalmente com frequência e comprimento de onda.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como ler o espectro?</h4><p>A sequência, do menor para o maior comprimento de onda, é:</p><div class=&quot;destaque&quot;><strong>Rádio → micro-ondas → infravermelho → visível → ultravioleta → raios X → gama.</strong></div><p>Como c = λf no vácuo, quando o comprimento de onda diminui, a frequência aumenta. A energia de um fóton também cresce com a frequência:</p><div class=&quot;formula-block&quot;>E = h·f = h·c/λ</div><p>Portanto, <strong>maior frequência significa maior energia por fóton</strong>. Radiações de frequência suficientemente alta podem ser ionizantes, isto é, capazes de remover elétrons de átomos ou moléculas.</p><p>A luz visível ocupa apenas uma pequena faixa do espectro. O que chamamos de “cor” corresponde a diferentes frequências dentro dessa faixa.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> entre luz visível e raios gama, os raios gama possuem frequência maior e, portanto, fótons mais energéticos.</div><p>Para resolver questões, não decore apenas a ordem: conecte <strong>λ, f e E</strong>. Uma alteração em uma dessas grandezas ajuda a prever as outras.</p>","ap":"<strong>Regra de ouro:</strong> λ ↓ → f ↑ → E ↑. A relação vale porque c = λf e E = hf.","m":"<div class=&quot;formula-block&quot;>E = h·f = h·c/λ<br>E(eV) ≈ 1240/λ(nm)</div>","a":"Cada faixa possui aplicações diferentes: rádio em comunicações, micro-ondas em comunicações e aquecimento, infravermelho em sensores e calor, luz em visão, UV em processos químicos e biológicos, X e gama em aplicações médicas e industriais.","en":"Questões do ENEM podem pedir a ordem do espectro, comparar energia de fótons ou relacionar radiação a uma aplicação.","cu":"A frequência é a grandeza que determina a energia de cada fóton no modelo E = hf.","c":"Monte uma tabela com região, frequência relativa, comprimento de onda relativo, energia e uma aplicação.","r":"Não diga simplesmente que “toda radiação é perigosa”. O efeito depende da frequência, intensidade, tempo de exposição e contexto.","f":["NASA — Espectro eletromagnético"]},"F7":{"p":"Radiação está presente naturalmente no ambiente e também é utilizada em várias tecnologias. Para estudá-la, é importante diferenciar <strong>tipo de radiação, fonte e dose</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Ionizante e não ionizante</h4><p>Uma radiação é chamada de <strong>ionizante</strong> quando possui energia suficiente para produzir ionização, removendo elétrons de átomos ou moléculas. Exemplos incluem determinados raios X, raios gama e partículas de alta energia.</p><p>Existem fontes naturais, como radiação cósmica, materiais presentes no solo e radônio, e fontes artificiais, como equipamentos usados na medicina.</p><p>Para falar de risco, não basta perguntar “qual radiação?”. Também precisamos considerar <strong>dose, tempo de exposição e condições da exposição</strong>. O sievert (Sv) é uma unidade usada para expressar dose efetiva considerando efeitos biológicos.</p><div class=&quot;formula-block&quot;>N(t) = N₀·(1/2)^(t/T)</div><p>Essa equação descreve a diminuição da quantidade de núcleos radioativos em função da meia-vida T. Depois de uma meia-vida, resta metade; depois de duas, um quarto; depois de três, um oitavo.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> uma amostra de 100 unidades com meia-vida de 30 anos terá 50 após 30 anos, 25 após 60 e 12,5 após 90.</div>","ap":"<strong>Não confunda:</strong> atividade, dose absorvida e dose efetiva são conceitos diferentes. A pergunta “quanto existe?” não é automaticamente a mesma que “qual é o efeito biológico?”.","m":"<div class=&quot;formula-block&quot;>N(t) = N₀·(1/2)^(t/T)</div>","a":"Radioterapia, diagnóstico por imagem, esterilização e pesquisas utilizam diferentes formas de radiação.","en":"Questões podem apresentar gráficos de decaimento ou comparar exposições. Procure a grandeza pedida antes de interpretar o número.","cu":"O fundo natural de radiação varia conforme a região e as condições ambientais; não é uma constante universal idêntica para todas as pessoas.","c":"Calcule uma sequência de três meias-vidas e explique o resultado em palavras.","r":"Não use meia-vida como se significasse que toda a radiação desaparece depois desse tempo: ela indica quando metade dos núcleos originais permanece.","f":["CNEN — informações sobre radiação"]},"F8":{"p":"Afirmações sobre radiação aparecem frequentemente nas redes sociais. Para avaliá-las, primeiro descubra <strong>que radiação está sendo discutida</strong> e depois pergunte qual evidência sustenta a afirmação.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como avaliar uma alegação?</h4><p>Primeiro identifique a região do espectro: rádio, micro-ondas, infravermelho, visível, UV, X ou gama. Depois determine se ela é ionizante ou não ionizante no contexto apresentado.</p><p>Micro-ondas e radiofrequências, incluindo as utilizadas em comunicações sem fio, pertencem à região <strong>não ionizante</strong>. Isso significa que seus fótons não possuem energia suficiente para ionizar átomos individualmente como ocorre com radiações ionizantes. Isso não significa que qualquer exposição seja automaticamente inofensiva em qualquer intensidade: efeitos térmicos e limites de exposição continuam sendo questões relevantes.</p><p>Para avaliar uma notícia científica, procure <strong>fonte, método, tamanho do estudo, comparação utilizada e se os resultados foram reproduzidos</strong>. Uma frase isolada não substitui o conjunto das evidências.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> “X causa doença” é uma afirmação incompleta. Pergunte: qual exposição? qual dose? em humanos ou em laboratório? qual estudo? qual é o consenso das evidências?</div>","ap":"<strong>Checklist:</strong> identificar a radiação → classificar → verificar mecanismo físico → localizar a fonte da alegação → comparar com evidências científicas.","m":"<div class=&quot;formula-block&quot;>E<sub>fóton</sub> = h·f</div>","a":"Letramento científico é útil para saúde, tecnologia e decisões cotidianas.","en":"Uma questão pode exigir que você diferencie uma característica física da interpretação exagerada de uma notícia.","cu":"A classificação “ionizante/não ionizante” é física; já uma conclusão sobre risco depende também de dose, exposição e evidências.","c":"Pegue três afirmações sobre tecnologia e escreva que evidência seria necessária para avaliá-las.","r":"Não transforme “não ionizante” em “não oferece nenhum efeito”: a intensidade e a exposição continuam importantes.","f":["OMS — informações sobre campos eletromagnéticos"]},"F9":{"p":"Acidentes radioativos mostram que o risco não está apenas na existência de uma fonte, mas também em <strong>como ela é armazenada, identificada, monitorada e controlada</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Estudo de caso: três mecanismos diferentes</h4><p><strong>Chernobyl</strong> envolveu um reator do tipo RBMK e uma sequência de falhas técnicas, operacionais e de segurança. <strong>Fukushima</strong> ocorreu após um grande terremoto e tsunami, que comprometeram sistemas de energia e resfriamento.</p><p>Em <strong>Goiânia</strong>, uma fonte contendo césio-137 foi retirada de uma instalação abandonada e acabou sendo manipulada sem que as pessoas soubessem do perigo. O caso mostra a importância de controle, identificação e fiscalização de fontes radioativas.</p><p>O césio-137 possui meia-vida de aproximadamente 30 anos. Isso significa que a quantidade de núcleos radioativos cai pela metade a cada 30 anos, não que o material desapareça.</p><div class=&quot;formula-block&quot;>Após n meias-vidas: N = N₀/2ⁿ</div><p>Ao estudar acidentes, não procure apenas “quem errou”. Analise <strong>cadeia de eventos, barreiras de segurança, comunicação, manutenção, treinamento e resposta de emergência</strong>.</p>","ap":"<strong>Aprendizado central:</strong> segurança nuclear e radiológica depende de várias camadas de prevenção. Uma falha pode ser contida por outra camada quando o sistema é bem projetado.","m":"<div class=&quot;formula-block&quot;>Cs-137: T ≈ 30 anos<br>N = N₀/2ⁿ</div>","a":"O estudo de acidentes ajuda a entender gestão de risco, comunicação científica e importância da fiscalização.","en":"Questões podem pedir comparação entre causas, consequências ou medidas de prevenção.","cu":"A meia-vida descreve o decaimento radioativo; ela não mede diretamente o dano causado a uma pessoa.","c":"Monte uma linha do tempo e, em cada evento, escreva uma barreira de segurança que poderia reduzir o risco.","r":"Evite decorar apenas datas: entenda o mecanismo que levou ao acidente e as medidas que poderiam interromper a cadeia.","f":["IAEA — segurança nuclear","CNEN — segurança radiológica"]},"F10":{"p":"Quando um metal é aquecido, ele pode passar do invisível ao vermelho, laranja e branco. Isso acontece porque a matéria quente emite radiação eletromagnética com uma distribuição que depende da temperatura.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Corpo negro e temperatura</h4><p>O modelo de <strong>corpo negro</strong> descreve um objeto ideal que absorve e emite radiação de maneira característica. A distribuição da radiação emitida depende da temperatura.</p><p>A <strong>lei de Wien</strong> diz que o comprimento de onda no qual a emissão é máxima diminui quando a temperatura aumenta:</p><div class=&quot;formula-block&quot;>λ<sub>max</sub>·T = 2,9·10⁻³ m·K</div><p>Assim, um objeto mais quente apresenta seu máximo de emissão em comprimentos de onda menores. A <strong>lei de Stefan-Boltzmann</strong> relaciona a potência emitida por unidade de área à quarta potência da temperatura absoluta:</p><div class=&quot;formula-block&quot;>P/A = σT⁴</div><p>O uso de T em kelvin é essencial. Não substitua graus Celsius diretamente nessas fórmulas.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> para T = 300 K, λ<sub>max</sub> ≈ 2,9×10⁻³/300 ≈ 9,7×10⁻⁶ m, ou cerca de 9,7 μm.</div>","ap":"<strong>Intuição:</strong> aumentar T desloca o pico para λ menor e aumenta fortemente a potência total emitida, porque a potência varia com T⁴.","m":"<div class=&quot;formula-block&quot;>λmax·T = 2,9·10⁻³ m·K<br>P/A = σT⁴</div>","a":"É usado em astronomia, sensores de temperatura, pirômetros e análise de radiação térmica.","en":"Questões podem apresentar curvas de emissão e pedir qual objeto é mais quente ou como o pico se desloca.","cu":"A temperatura do Sol é frequentemente aproximada em torno de 5.800 K em modelos introdutórios.","c":"Calcule λmax para 300 K e 600 K e compare os resultados.","r":"Use kelvin, não Celsius, nas leis de Wien e Stefan-Boltzmann.","f":["Planck — fundamentos da radiação térmica"]},"F11":{"p":"No efeito fotoelétrico, aumentar a frequência da luz pode fazer elétrons serem emitidos enquanto aumentar apenas a intensidade, abaixo da frequência de corte, não resolve o problema.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que está acontecendo?</h4><p>Um fóton carrega energia <strong>E = hf</strong>. Para retirar um elétron de um material, é necessário fornecer pelo menos a energia chamada <strong>função trabalho Φ</strong>.</p><p>Se a energia do fóton supera Φ, sobra energia para o elétron sair com energia cinética:</p><div class=&quot;formula-block&quot;>E<sub>c</sub> = h·f − Φ</div><p>Existe uma frequência mínima, chamada <strong>frequência de corte</strong>:</p><div class=&quot;formula-block&quot;>f₀ = Φ/h</div><p>Se f &lt; f₀, não há emissão fotoelétrica idealmente, mesmo que a intensidade seja aumentada. Se f &gt; f₀, aumentar a intensidade significa aumentar o número de fótons incidentes e, portanto, pode aumentar o número de elétrons emitidos, mas não a energia máxima de cada elétron.</p><div class=&quot;destaque&quot;><strong>Resumo:</strong> frequência controla a energia de cada fóton; intensidade controla quantos fótons chegam por unidade de tempo.</div><p>Esse fenômeno ajudou a consolidar a ideia de quantização da luz.</p>","ap":"<strong>Como resolver:</strong> calcule ou compare hf com Φ. Se hf &gt; Φ, há emissão; a diferença determina a energia cinética máxima.","m":"<div class=&quot;formula-block&quot;>E = h·f<br>Ec = h·f − Φ<br>f₀ = Φ/h</div>","a":"A ideia está relacionada a células fotovoltaicas e sensores de luz, embora dispositivos reais envolvam também outros processos de materiais semicondutores.","en":"Questões costumam explorar a diferença entre frequência e intensidade e interpretar gráficos de energia cinética em função da frequência.","cu":"Einstein explicou o efeito fotoelétrico usando a ideia de fótons e recebeu o Nobel de Física por trabalhos relacionados a esse fenômeno.","c":"Faça um gráfico qualitativo de Ec × f e marque a frequência de corte.","r":"Não diga que “mais intensidade sempre aumenta a energia dos elétrons”: para a mesma frequência, ela aumenta principalmente a quantidade de fótons.","f":["Toda Matéria — Efeito fotoelétrico"]},"F12":{"p":"A Física quântica mostra que objetos microscópicos não se comportam exatamente como objetos clássicos do cotidiano. Um dos conceitos centrais é a <strong>dualidade onda-partícula</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que significa dualidade?</h4><p>Experimentos mostram comportamentos associados a ondas e a partículas. A luz, por exemplo, apresenta interferência e difração, mas também interage em quantidades discretas chamadas fótons.</p><p>De Broglie propôs que partículas materiais também possuem um comprimento de onda associado ao seu momento:</p><div class=&quot;formula-block&quot;>λ = h/p = h/(m·v)</div><p>Quanto maior o momento p, menor o comprimento de onda associado. Por isso, os efeitos ondulatórios de objetos macroscópicos são extremamente difíceis de observar no cotidiano, enquanto partículas como elétrons podem apresentar difração de maneira observável.</p><p>Essa ideia ajuda a entender o funcionamento de técnicas como a microscopia eletrônica: elétrons podem ter comprimentos de onda muito menores que os da luz visível, permitindo investigar estruturas muito pequenas.</p><div class=&quot;destaque&quot;><strong>Não é “a partícula vira uma onda”</strong> no sentido de uma transformação cotidiana. A dualidade indica que o comportamento quântico não cabe perfeitamente nas categorias clássicas de “onda” e “partícula”.</div>","ap":"<strong>Conexão matemática:</strong> primeiro encontre o momento p. Depois use λ = h/p. Quanto maior p, menor λ.","m":"<div class=&quot;formula-block&quot;>λ = h/(m·v)</div>","a":"Microscópios eletrônicos, difração de elétrons e várias tecnologias quânticas dependem de propriedades desse tipo.","en":"Questões podem comparar comprimentos de onda de elétrons e luz ou pedir consequências da relação de De Broglie.","cu":"A hipótese de De Broglie foi uma etapa importante no desenvolvimento da mecânica quântica.","c":"Compare qualitativamente o λ de um elétron rápido e de um elétron lento.","r":"Não confunda comprimento de onda de De Broglie com o tamanho físico da partícula.","f":["de Broglie — fundamentos da dualidade"]},"F13":{"p":"Na Física quântica, medir um sistema não é simplesmente “olhar sem interferir”. A descrição do sistema e o processo de medição estão ligados de maneira profunda.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Princípio da incerteza</h4><p>O princípio de Heisenberg estabelece um limite fundamental para a precisão simultânea de certas grandezas, como posição x e momento p:</p><div class=&quot;formula-block&quot;>Δx·Δp ≥ ℏ/2</div><p>Isso não significa apenas que nossos instrumentos são ruins. A relação faz parte da própria estrutura da teoria quântica. Quanto mais estreitamente uma posição é definida, maior tende a ser a incerteza associada ao momento, e vice-versa.</p><h4>Superposição e medida</h4><p>Antes da medição, um sistema quântico pode ser descrito por uma superposição de possibilidades. No tratamento introdutório da interpretação de Copenhague, a medida é associada ao <strong>colapso da função de onda</strong>, selecionando um resultado observado.</p><p>Na experiência de dupla fenda, obter informação sobre o caminho da partícula pode alterar ou eliminar o padrão de interferência. O ponto importante é que a obtenção de informação física não é necessariamente neutra.</p>","ap":"<strong>Ideia central:</strong> incerteza quântica não é sinônimo de “não sabemos porque não temos tecnologia”. É uma limitação fundamental descrita pela teoria.","m":"<div class=&quot;formula-block&quot;>Δx·Δp ≥ ℏ/2</div>","a":"O conceito aparece em microscopia, espectroscopia, física atômica e tecnologias quânticas.","en":"Questões podem apresentar uma situação de dupla fenda e pedir o efeito de obter informação sobre o caminho.","cu":"O gato de Schrödinger é um experimento mental criado para discutir interpretações da mecânica quântica, não uma descrição literal de um gato cotidiano.","c":"Explique com suas palavras por que aumentar a precisão de x afeta a incerteza de p.","r":"Não confunda princípio da incerteza com erro experimental comum.","f":["Heisenberg — princípio da incerteza"]},"F14":{"p":"O silício é um semicondutor: sua capacidade de conduzir corrente pode ser controlada. Essa característica é fundamental para diodos, transistores, circuitos integrados e outros dispositivos.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que é um semicondutor?</h4><p>Um semicondutor apresenta propriedades elétricas intermediárias e controláveis. Sua condutividade pode ser alterada pela temperatura, pela luz e principalmente pela <strong>dopagem</strong>, que introduz pequenas quantidades de outros elementos.</p><p>Na dopagem <strong>tipo-n</strong>, o material é preparado para possuir elétrons como portadores majoritários. Na dopagem <strong>tipo-p</strong>, as lacunas são os portadores majoritários.</p><p>Uma <strong>lacuna</strong> pode ser entendida como a ausência de um elétron em uma estrutura eletrônica. Ela se comporta como um portador de carga positiva no modelo usado para circuitos semicondutores.</p><div class=&quot;formula-block&quot;>σ = n·e·μ</div><p>Essa expressão simplificada mostra que a condutividade depende da quantidade de portadores n, da carga e de sua mobilidade μ.</p><div class=&quot;destaque&quot;><strong>Conexão:</strong> controlar portadores permite controlar corrente. É essa possibilidade de controle que torna o semicondutor tão útil para construir dispositivos eletrônicos.</div>","ap":"<strong>Tipo-n:</strong> elétrons como portadores majoritários. <strong>Tipo-p:</strong> lacunas como portadores majoritários. A junção desses materiais é a base de muitos dispositivos.","m":"<div class=&quot;formula-block&quot;>σ = n·e·μ</div>","a":"Chips, LEDs, sensores e painéis solares dependem de propriedades semicondutoras.","en":"Questões podem apresentar gráficos de condutividade, dopagem ou funcionamento de dispositivos.","cu":"O desenvolvimento de semicondutores permitiu miniaturizar circuitos e aumentar enormemente a capacidade de processamento eletrônico.","c":"Desenhe um material tipo-n e tipo-p e identifique os portadores majoritários.","r":"Não confunda “lacuna” com uma partícula positiva independente: ela representa uma ausência de elétron na estrutura do material.","f":["Shockley — fundamentos de semicondutores"]},"F15":{"p":"Alguns materiais apresentam resistência elétrica extremamente baixa abaixo de uma temperatura crítica. Esse fenômeno é chamado de <strong>supercondutividade</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que muda em um supercondutor?</h4><p>Quando um material supercondutor está abaixo de sua temperatura crítica <strong>Tc</strong>, o modelo introdutório descreve uma resistência elétrica nula:</p><div class=&quot;formula-block&quot;>T &lt; Tc → R = 0</div><p>Em muitos supercondutores convencionais, elétrons formam pares de Cooper e passam a participar de um estado coletivo. Outra característica importante é o <strong>efeito Meissner</strong>: o material expulsa o fluxo magnético de seu interior em determinadas condições.</p><p>O fenômeno depende de temperatura e, em condições mais completas, também de campo magnético e corrente crítica. Portanto, “R = 0” não significa que qualquer corrente, campo ou temperatura seja permitido.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> se Tc = 90 K, um material a 70 K está abaixo da temperatura crítica e, no modelo idealizado da aula, apresenta R = 0.</div><p>Supercondutividade é interessante porque pode reduzir perdas elétricas e produzir campos magnéticos intensos, embora a necessidade de resfriamento seja um desafio em muitas aplicações.</p>","ap":"<strong>Dois conceitos para separar:</strong> resistência nula está ligada ao transporte elétrico; efeito Meissner está ligado ao comportamento magnético do estado supercondutor.","m":"<div class=&quot;formula-block&quot;>T &lt; Tc → R = 0</div>","a":"MRI, sistemas de levitação magnética e grandes aceleradores utilizam materiais ou ímãs supercondutores em condições específicas.","en":"Questões podem apresentar um gráfico R × T e pedir em que faixa o material é supercondutor.","cu":"Heike Kamerlingh Onnes observou supercondutividade em 1911 ao estudar materiais em temperaturas muito baixas.","c":"Leia um gráfico R × T e identifique Tc.","r":"Não trate Tc como uma temperatura universal: cada material possui suas próprias condições críticas.","f":["BCS — fundamentos da supercondutividade"]},"F16":{"p":"Um sensor transforma uma grandeza física, como luz ou temperatura, em um sinal que um sistema eletrônico consegue medir. O desafio é transformar um fenômeno contínuo em dados utilizáveis.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Do fenômeno ao número</h4><p>Um <strong>sensor</strong> detecta uma grandeza e produz uma resposta elétrica. Um LDR responde à luz; um termistor responde à temperatura; um piezoelétrico produz sinais relacionados a deformação ou vibração.</p><p>Quando o sinal é analógico, um <strong>ADC</strong> (conversor analógico-digital) transforma uma faixa contínua de valores em níveis discretos. Um ADC de 10 bits possui:</p><div class=&quot;formula-block&quot;>2¹⁰ = 1024 níveis</div><p>Se a referência é 5 V, uma aproximação para a tensão correspondente à leitura é:</p><div class=&quot;formula-block&quot;>V = (leitura/1023)·5</div><p>A diferença entre 1023 e 1024 ocorre porque os códigos de uma leitura de 10 bits vão de 0 a 1023.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> se a leitura é 512, V ≈ (512/1023)×5 ≈ 2,50 V.</div><p>Assim, um sistema de aquisição pode seguir a cadeia: <strong>fenômeno → sensor → sinal → ADC → processamento → decisão/visualização</strong>.</p>","ap":"<strong>Ideia central:</strong> o número exibido por um microcontrolador não é a grandeza física diretamente; é uma representação obtida por uma cadeia de medição.","m":"<div class=&quot;formula-block&quot;>Níveis = 2ⁿ<br>V ≈ (leitura/(2ⁿ−1))·Vref</div>","a":"Estações meteorológicas, relógios inteligentes, celulares e sistemas de automação usam sensores e conversores.","en":"Questões podem pedir resolução do ADC, interpretação de leituras ou escolha do sensor adequado.","cu":"A resolução de um ADC depende do número de bits e da faixa de referência utilizada.","c":"Calcule a tensão para leituras 0, 512 e 1023 em um ADC de 10 bits com Vref = 5 V.","r":"Não confunda resolução em bits com precisão absoluta do sensor: são características diferentes.","f":["Horowitz & Hill — The Art of Electronics"]},"F17":{"p":"Um sistema automático precisa perceber o ambiente, decidir o que fazer e agir. É por isso que sistemas de controle combinam <strong>sensores, processamento e atuadores</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Do sensor ao atuador</h4><p>Imagine um ar-condicionado. Um sensor mede a temperatura; o controlador compara essa medida com o valor desejado; depois um atuador liga ou desliga o sistema de refrigeração.</p><p>Uma regra simples pode ser escrita como:</p><div class=&quot;formula-block&quot;>IF condição THEN ação ELSE alternativa</div><p>O problema de simplesmente ligar e desligar no mesmo ponto é a <strong>oscilação</strong>. Para reduzi-la, usa-se histerese. Por exemplo: ligar a 30 °C e desligar somente quando chegar a 28 °C.</p><p>Em controles mais sofisticados, um PID usa três componentes: proporcional, integral e derivativo.</p><div class=&quot;formula-block&quot;>u(t)=Kp·e + Ki·∫e·dt + Kd·de/dt</div><p>O erro é a diferença entre o valor desejado, chamado <strong>setpoint</strong>, e a leitura. O termo proporcional reage ao erro atual; o integral acumula erros ao longo do tempo; o derivativo considera a tendência de variação do erro.</p><div class=&quot;destaque&quot;><strong>Resumo:</strong> sensor mede → controlador compara → lógica decide → atuador age → sensor mede novamente.</div>","ap":"<strong>Histerese</strong> é uma solução simples para evitar liga-desliga rápido. <strong>PID</strong> é uma estratégia de controle contínuo mais sofisticada.","m":"<div class=&quot;formula-block&quot;>erro = setpoint − leitura<br>u(t)=Kp·e + Ki·∫e·dt + Kd·de/dt</div>","a":"Automação aparece em climatização, drones, impressoras 3D, processos industriais e muitos sistemas embarcados.","en":"Questões podem pedir para identificar sensor, atuador, setpoint ou interpretar um fluxograma IF/THEN.","cu":"Sistemas reais normalmente precisam de calibração, limites de segurança e tratamento de falhas, não apenas uma regra matemática.","c":"Crie um fluxograma de um ventilador que liga quando a temperatura ultrapassa um limite.","r":"Não confunda setpoint com leitura: setpoint é o valor desejado; leitura é o valor medido.","f":["Åström — teoria de controle"]},"B1":{"p":"A poluição do ar é uma mistura de agentes físicos e químicos. Alguns poluentes conseguem alcançar regiões profundas do sistema respiratório e desencadear respostas inflamatórias.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Por que partículas pequenas preocupam?</h4><p><strong>MP2,5</strong> é o material particulado com diâmetro aerodinâmico de até aproximadamente 2,5 μm. Por ser muito pequeno, pode alcançar os alvéolos, regiões onde ocorre troca gasosa.</p><p>Além do MP2,5, a poluição pode envolver ozônio, óxidos de nitrogênio, dióxido de enxofre e monóxido de carbono. Cada agente possui propriedades e efeitos diferentes.</p><p>Quando o sistema respiratório é exposto a poluentes, podem ocorrer irritação e inflamação. Pessoas com doenças respiratórias, crianças, idosos e outros grupos vulneráveis podem apresentar maior impacto.</p><div class=&quot;destaque&quot;><strong>Raciocínio:</strong> fonte de poluição → concentração no ar → exposição → contato com o organismo → resposta biológica → possível efeito na saúde.</div><p>Para interpretar dados ambientais, observe sempre a unidade, o período de exposição e a população analisada.</p>","ap":"Entenda a cadeia fonte → exposição → efeito. Um gráfico de concentração não é automaticamente um gráfico de doença: é preciso considerar a relação entre as variáveis.","m":"<div class=&quot;formula-block&quot;>MP2,5: partículas ≤ 2,5 μm</div>","a":"Saúde ambiental, planejamento urbano e políticas de qualidade do ar dependem da compreensão dessas relações.","en":"Questões podem relacionar concentração de poluentes com internações, sintomas ou distribuição espacial.","cu":"O episódio de smog de Londres em 1952 é um exemplo histórico de como poluição atmosférica intensa pode afetar a saúde pública.","c":"Analise um mapa de fontes de poluição e proponha quais grupos poderiam estar mais expostos.","r":"Não conclua causalidade apenas porque duas curvas aumentam juntas; observe desenho do estudo e outras variáveis.","f":["OMS — qualidade do ar"]},"B2":{"p":"Dengue, doença de Chagas e leishmaniose são exemplos de doenças que dependem de fatores biológicos, ambientais e sociais. Por isso, seu controle não se resume ao tratamento de uma pessoa doente.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que são doenças tropicais negligenciadas?</h4><p>São doenças que atingem de maneira desproporcional populações vulneráveis e recebem menor atenção e recursos em relação ao impacto que produzem.</p><p>Algumas possuem <strong>vetores</strong>: organismos que participam da transmissão do agente infeccioso. Exemplos incluem <em>Aedes</em>, <em>Triatoma</em> e <em>Lutzomyia</em>. O vetor não é necessariamente o agente causador; ele participa do ciclo de transmissão.</p><p>O ambiente também importa: saneamento, moradia, acesso a serviços de saúde, condições de trabalho e distribuição de renda podem alterar a exposição.</p><div class=&quot;destaque&quot;><strong>Controle integrado:</strong> reduzir o vetor + melhorar ambiente + vigilância + diagnóstico + tratamento + educação em saúde.</div><p>O conceito de R₀ ajuda a descrever a capacidade de transmissão em uma população suscetível em determinadas condições. De forma simplificada, R₀ maior que 1 indica potencial de crescimento da transmissão.</p>","ap":"Pense no ciclo completo: agente → hospedeiro → vetor/ambiente → nova pessoa. Interromper qualquer etapa pode contribuir para o controle.","m":"<div class=&quot;formula-block&quot;>R₀ &gt; 1 → potencial de crescimento da transmissão</div>","a":"Controle de vetores, saneamento e vigilância são estratégias de saúde pública.","en":"Questões podem apresentar ciclos de transmissão, mapas ou curvas epidemiológicas.","cu":"Carlos Chagas descreveu a doença que recebeu seu nome no início do século XX.","c":"Desenhe o ciclo de uma doença transmitida por vetor e marque onde uma intervenção poderia agir.","r":"Não confunda vetor com agente etiológico: são papéis diferentes no ciclo da doença.","f":["OMS — doenças tropicais negligenciadas"]},"B3":{"p":"Doenças podem surgir em populações, reaparecer depois de terem diminuído ou ampliar sua distribuição. Para entender isso, é necessário olhar além do microrganismo.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Emergentes e reemergentes</h4><p>Uma doença <strong>emergente</strong> pode representar uma nova ocorrência ou um aumento importante de ocorrência em determinada população. Uma doença <strong>reemergente</strong> é aquela que volta a apresentar transmissão ou aumento depois de ter diminuído.</p><p>Fatores ambientais e sociais podem favorecer esses processos: mudanças no uso do solo, urbanização, viagens, alterações climáticas, contato entre humanos e animais e mudanças na cobertura vacinal são exemplos de fatores que podem modificar a dinâmica de doenças.</p><p>O conceito de <strong>One Health (Saúde Única)</strong> reconhece que saúde humana, saúde animal e ambiente estão conectados.</p><div class=&quot;destaque&quot;><strong>Raciocínio:</strong> o surgimento de uma doença não depende apenas de “um vírus novo”; depende também de oportunidade de transmissão, população suscetível e condições ambientais.</div>","ap":"Ao analisar uma doença emergente, pergunte: o agente mudou? o ambiente mudou? a população suscetível mudou? a capacidade de vigilância mudou?","m":"<div class=&quot;formula-block&quot;>R₀ e R<sub>efetivo</sub> ajudam a descrever transmissão</div>","a":"Vigilância epidemiológica e cooperação entre áreas de saúde são fundamentais para detectar mudanças rapidamente.","en":"Questões podem pedir para classificar uma doença como emergente ou reemergente e identificar fatores que favorecem transmissão.","cu":"A pandemia de COVID-19 mostrou a importância de vigilância, comunicação e colaboração entre diferentes áreas.","c":"Monte uma linha do tempo com uma doença e marque os fatores que alteraram sua transmissão.","r":"Não use “emergente” como sinônimo de “doença desconhecida”: o conceito também envolve aumento ou mudança relevante de ocorrência.","f":["OMS — doenças emergentes"]},"B4":{"p":"O sistema linfático ajuda a devolver líquido dos tecidos para a circulação, participa da absorção de lipídios e integra o sistema imunológico.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Por onde passa a linfa?</h4><p>Parte do líquido que sai dos capilares sanguíneos chega aos espaços entre as células. O sistema linfático recolhe esse excesso e o conduz por <strong>capilares e vasos linfáticos</strong> até retornar à circulação.</p><p>Os <strong>linfonodos</strong> funcionam como locais de filtragem e organização de respostas imunes. Neles, células do sistema imune encontram antígenos e podem iniciar ou ampliar respostas específicas.</p><p>O sistema inclui também estruturas como baço e timo. O baço participa da filtragem do sangue e de funções imunes; o timo está relacionado à maturação de linfócitos T.</p><div class=&quot;destaque&quot;><strong>Imagine uma drenagem:</strong> vasos linfáticos recolhem líquido; linfonodos funcionam como pontos de filtragem; o conteúdo finalmente retorna à circulação.</div><p>A circulação linfática não possui um coração bombeando linfa. Contrações musculares, movimentos corporais e válvulas ajudam a impulsionar o líquido.</p>","ap":"Separe duas funções que frequentemente são misturadas: <strong>drenagem de líquido</strong> e <strong>defesa imunológica</strong>. O sistema linfático participa das duas.","m":"<div class=&quot;formula-block&quot;>Sistema linfático = drenagem + transporte + defesa</div>","a":"Edema e aumento de linfonodos são exemplos de situações em que o sistema pode aparecer em contextos clínicos.","en":"Questões podem apresentar mapas corporais ou situações de inchaço e perguntar qual sistema está envolvido.","cu":"A distribuição dos linfonodos pode ser percebida em regiões cervicais, axilares e inguinais.","c":"Desenhe o trajeto geral da linfa até o retorno à circulação sanguínea.","r":"Não confunda linfa com sangue: são fluidos diferentes com funções e composição diferentes.","f":["Moore — Anatomia"]},"B5":{"p":"O sangue precisa ser constantemente renovado. Essa produção de células é chamada de <strong>hematopoiese</strong> e ocorre principalmente na medula óssea vermelha.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Uma origem comum</h4><p>As células-tronco hematopoéticas (CTH) dão origem às diferentes linhagens de células do sangue. A partir delas surgem células que se especializam em <strong>eritrócitos, leucócitos e plaquetas</strong>.</p><p><strong>Eritrócitos</strong> transportam gases respiratórios, especialmente oxigênio. <strong>Leucócitos</strong> participam da defesa. <strong>Plaquetas</strong> são fragmentos celulares importantes para a coagulação.</p><p>A medula óssea funciona como um tecido produtor. A produção é regulada por sinais do organismo; quando há necessidade maior de determinadas células, o sistema pode alterar a produção.</p><div class=&quot;destaque&quot;><strong>Ideia central:</strong> uma única população de células-tronco dá origem a várias células especializadas por diferenciação.</div>","ap":"Pense em uma árvore: a CTH está na base; as ramificações representam linhagens que dão origem a células especializadas.","m":"<div class=&quot;formula-block&quot;>CTH → linhagens hematopoéticas → células sanguíneas</div>","a":"Hemogramas, anemias e leucemias são contextos em que a produção e as características das células sanguíneas são importantes.","en":"Questões podem pedir local da hematopoiese ou função de cada tipo celular.","cu":"A produção diária de células sanguíneas é enorme porque muitas células possuem vida limitada.","c":"Faça um fluxograma começando em CTH e terminando em três grupos de células.","r":"Não confunda plaqueta com célula completa: ela é um fragmento derivado de megacariócitos.","f":["Junqueira — Histologia"]},"B6":{"p":"Leucócitos não são um grupo único. Eles possuem funções diferentes e atuam em etapas diferentes da defesa do organismo.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Principais tipos</h4><p><strong>Neutrófilos</strong> são importantes na resposta rápida e na fagocitose. <strong>Macrófagos</strong> fagocitam, participam da inflamação e podem apresentar antígenos. <strong>Linfócitos B</strong> podem se diferenciar em plasmócitos produtores de anticorpos. <strong>Linfócitos T</strong> atuam em diferentes funções de imunidade celular.</p><p><strong>Eosinófilos</strong> participam de respostas relacionadas a parasitas e alergias. <strong>Basófilos</strong> participam de respostas inflamatórias e alérgicas, liberando mediadores.</p><p>Quando uma questão apresenta um leucograma, a interpretação depende do tipo celular aumentado ou reduzido e do contexto clínico.</p><div class=&quot;destaque&quot;><strong>Memorização útil:</strong> B → anticorpos; T → resposta celular; neutrófilo → fagocitose rápida; macrófago → fagocitose + apresentação de antígeno.</div>","ap":"Não tente decorar apenas nomes. Associe cada célula a uma ação: reconhecer, fagocitar, apresentar, produzir anticorpos ou coordenar resposta.","m":"<div class=&quot;formula-block&quot;>Leucócitos = células de defesa</div>","a":"Hemogramas ajudam a avaliar alterações na quantidade de diferentes células, sempre considerando o contexto.","en":"Questões podem pedir a função de um leucócito ou interpretar uma alteração no leucograma.","cu":"O pus pode conter grande quantidade de células inflamatórias e restos celulares, especialmente neutrófilos mortos.","c":"Crie cartões com “célula → função principal”.","r":"Não diga que apenas um leucócito “faz toda a defesa”: a resposta imune é cooperativa.","f":["Abbas — Imunologia Celular e Molecular"]},"B7":{"p":"O sistema imune precisa responder rapidamente a ameaças sem precisar conhecer previamente cada microrganismo. Por isso existe uma defesa inata e, depois, uma resposta adaptativa mais específica.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Imunidade inata</h4><p>A defesa inata inclui barreiras físicas e químicas e células como neutrófilos, macrófagos e células NK. Ela responde rapidamente e reconhece padrões gerais associados a agentes infecciosos ou dano.</p><h4>Imunidade adaptativa</h4><p>A resposta adaptativa envolve linfócitos B e T. Os B podem produzir anticorpos; os T podem coordenar respostas ou destruir células-alvo, dependendo do subtipo.</p><p>Uma ponte importante entre as duas é a <strong>apresentação de antígenos</strong>. Moléculas do complexo MHC apresentam fragmentos antigênicos para reconhecimento por linfócitos T.</p><div class=&quot;destaque&quot;><strong>Resumo:</strong> inata = rápida e ampla; adaptativa = específica e capaz de gerar memória.</div>","ap":"Estude a sequência: barreira → reconhecimento → resposta inata → apresentação de antígeno → ativação adaptativa → memória.","m":"<div class=&quot;formula-block&quot;>Inata: rápida / Adaptativa: específica + memória</div>","a":"Vacinas exploram a capacidade de a imunidade adaptativa formar memória.","en":"Questões podem comparar células, anticorpos, MHC e características da imunidade inata e adaptativa.","cu":"Anticorpos são produzidos por plasmócitos, células derivadas de linfócitos B ativados.","c":"Faça um fluxograma da entrada de um agente até a formação de memória.","r":"Não confunda antígeno com anticorpo: antígeno é reconhecido pelo sistema imune; anticorpo é uma proteína produzida por células B/plasmócitos.","f":["Abbas — Imunologia"]},"B8":{"p":"Uma característica poderosa da imunidade adaptativa é a <strong>memória imunológica</strong>: depois de uma primeira exposição, parte das células permanece preparada para responder novamente.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Resposta primária e secundária</h4><p>Na primeira exposição a um antígeno, o organismo precisa ativar e multiplicar clones específicos. Por isso a resposta é mais lenta. Depois, células B e T de memória permanecem por longos períodos.</p><p>Em uma segunda exposição ao mesmo antígeno, essas células podem responder de maneira <strong>mais rápida e intensa</strong>. A resposta secundária costuma apresentar produção de anticorpos mais eficiente.</p><p>As imunoglobulinas também podem variar ao longo da resposta. Em uma descrição introdutória, a <strong>IgM</strong> aparece precocemente, enquanto a <strong>IgG</strong> costuma predominar posteriormente em muitas respostas sistêmicas.</p><div class=&quot;destaque&quot;><strong>É esse princípio que as vacinas aproveitam:</strong> apresentar ao sistema imune um estímulo seguro ou controlado para formar memória sem depender da doença natural para aprender.</div>","ap":"Compare os gráficos de resposta primária e secundária: observe tempo para começar, altura do pico e duração.","m":"<div class=&quot;formula-block&quot;>Primária: mais lenta<br>Secundária: mais rápida e intensa</div>","a":"Vacinação é uma aplicação direta do conceito de memória imunológica.","en":"Questões podem apresentar curvas de anticorpos e pedir qual representa a segunda exposição.","cu":"Células de memória podem permanecer por anos e, em alguns casos, por décadas.","c":"Desenhe duas curvas de anticorpos e identifique exposição 1 e exposição 2.","r":"Não conclua que toda IgG significa necessariamente imunidade perfeita: o contexto e o agente importam.","f":["Plotkin — Vaccines"]},"B9":{"p":"O sistema imune normalmente precisa distinguir o próprio organismo de estruturas estranhas. Quando mecanismos de tolerância falham ou respostas são direcionadas inadequadamente, podem surgir imunopatologias.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Três situações diferentes</h4><p><strong>Autoimunidade</strong> ocorre quando respostas imunes são direcionadas contra componentes do próprio organismo. Exemplos incluem lúpus, artrite reumatoide e diabetes tipo 1.</p><p><strong>Alergia</strong> é uma resposta exagerada a substâncias geralmente inofensivas. Em muitos quadros alérgicos, a IgE participa da ativação de células que liberam mediadores como histamina.</p><p><strong>Imunodeficiência</strong> ocorre quando algum componente da defesa está ausente ou comprometido. O HIV, por exemplo, compromete o sistema imune ao atingir células importantes da resposta adaptativa.</p><div class=&quot;destaque&quot;><strong>Compare:</strong> autoimunidade = alvo é o próprio organismo; alergia = resposta exagerada a um antígeno geralmente inofensivo; imunodeficiência = defesa insuficiente.</div>","ap":"Para classificar um caso, pergunte: o sistema está atacando o próprio corpo, reagindo excessivamente a algo externo ou falhando em defender o organismo?","m":"<div class=&quot;formula-block&quot;>IgE → mastócitos/basófilos → mediadores inflamatórios</div>","a":"O tratamento depende da causa e pode envolver controle da inflamação, modulação imune ou tratamento da infecção associada.","en":"Questões podem apresentar casos clínicos simplificados e pedir a categoria de imunopatologia.","cu":"A tolerância imunológica é fundamental para impedir respostas contra componentes próprios.","c":"Monte uma tabela com autoimunidade, alergia e imunodeficiência.","r":"Não use “alergia” e “autoimunidade” como sinônimos: são mecanismos distintos.","f":["Abbas — Imunologia"]},"B10":{"p":"Vacinas e soros podem envolver anticorpos, mas fazem coisas diferentes. A principal diferença é <strong>de onde vêm os anticorpos e se o organismo precisa produzir sua própria resposta</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Imunização ativa</h4><p>Na <strong>vacinação</strong>, o organismo recebe um estímulo que apresenta antígenos ou informações capazes de induzir uma resposta imune. O próprio sistema produz células efetoras e de memória. Por isso a proteção não costuma ser imediata.</p><h4>Imunização passiva</h4><p>No <strong>soro</strong>, anticorpos já prontos são administrados. A ação pode ser rápida, mas a pessoa não precisa construir aquela resposta do zero e, portanto, não obtém a mesma formação de memória típica da imunização ativa.</p><div class=&quot;formula-block&quot;>Vacina → ativa → memória<br>Soro → passiva → anticorpos prontos</div><div class=&quot;destaque&quot;><strong>Exemplo:</strong> em determinadas exposições a venenos de animais, soros específicos fornecem anticorpos ou fragmentos de anticorpos capazes de neutralizar toxinas.</div>","ap":"A pergunta-chave é: <strong>o organismo está aprendendo a responder ou está recebendo anticorpos prontos?</strong>","m":"<div class=&quot;formula-block&quot;>Ativa: resposta própria + memória<br>Passiva: anticorpos prontos</div>","a":"A escolha depende do contexto, da urgência e do tipo de agente ou toxina envolvido.","en":"Questões costumam pedir para distinguir vacina de soro em situações de exposição.","cu":"Instituições como Butantan e Vital Brazil têm papel histórico importante no desenvolvimento de produtos imunobiológicos no Brasil.","c":"Faça uma tabela comparando origem dos anticorpos, velocidade e memória.","r":"Não diga que soro “não protege”: ele pode fornecer proteção imediata, mas de natureza passiva e geralmente temporária.","f":["Butantan — imunização e soros"]},"B11":{"p":"Vacinas treinam o sistema imune para reconhecer um agente ou componente dele. O objetivo é criar uma resposta capaz de proteger contra uma exposição futura.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como uma vacina funciona?</h4><p>Uma vacina apresenta ao organismo um <strong>antígeno</strong> ou uma informação que leva à produção/apresentação de um antígeno. O sistema imune reconhece esse estímulo e ativa células específicas. Parte delas se transforma em células de memória.</p><p>Existem diferentes plataformas, como vacinas atenuadas, inativadas, subunidades, toxoides, mRNA e vetores virais. Elas diferem no material apresentado e na forma como o antígeno é produzido ou entregue.</p><h4>Proteção individual e coletiva</h4><p>Quando uma grande parcela da população está protegida, a transmissão pode diminuir, dificultando a circulação do agente e protegendo também pessoas que não podem responder adequadamente ou não podem receber determinada vacina.</p><div class=&quot;formula-block&quot;>H ≈ 1 − 1/R₀</div><p>Essa expressão é um modelo simplificado do limiar de imunidade coletiva para uma população homogênea. Ela não deve ser aplicada cegamente a situações reais, nas quais existem heterogeneidades e mudanças no comportamento.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> se R₀ = 4, o modelo simples dá H = 1 − 1/4 = 75%.</div>","ap":"Ao estudar vacinas, separe plataforma, resposta imune, memória e dinâmica de transmissão. São conceitos relacionados, mas não iguais.","m":"<div class=&quot;formula-block&quot;>H = 1 − 1/R₀</div>","a":"Vacinação é uma ferramenta de prevenção e saúde pública, integrada a vigilância e outras medidas.","en":"Questões podem comparar tipos de vacina ou calcular um limiar teórico de cobertura.","cu":"A erradicação da varíola é um exemplo histórico do impacto de vacinação combinada com vigilância e outras estratégias.","c":"Compare três plataformas de vacina em uma tabela: material, objetivo e exemplo.","r":"Não confunda eficácia, efetividade e cobertura vacinal: são medidas diferentes.","f":["Butantan — vacinas","Fiocruz — imunização"]},"B12":{"p":"Prevenir acidentes significa agir antes que o dano aconteça. Para isso, é necessário identificar perigos, avaliar riscos e modificar o ambiente ou o comportamento.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Perigo não é o mesmo que risco</h4><p><strong>Perigo</strong> é uma fonte potencial de dano. <strong>Risco</strong> depende da probabilidade e da gravidade do dano em determinada situação. Uma superfície escorregadia é um perigo; o risco de queda depende de quem passa, das condições do piso e de outros fatores.</p><p>Na prevenção, podemos atuar por educação, fiscalização, equipamentos de proteção, organização do ambiente e políticas públicas.</p><p>Em trânsito, cinto de segurança e capacete reduzem consequências de acidentes. Em ambientes escolares, iluminação, sinalização, manutenção e cultura de segurança também são importantes.</p><div class=&quot;destaque&quot;><strong>Modelo:</strong> identificar perigo → estimar risco → escolher barreira → implementar → verificar se funcionou.</div>","ap":"Uma prevenção boa não depende apenas de dizer “tenha cuidado”. Ela modifica o sistema para tornar o comportamento seguro mais fácil.","m":"<div class=&quot;formula-block&quot;>Prevenção = identificar → reduzir → monitorar</div>","a":"Segurança escolar, trânsito, trabalho e saúde pública usam princípios semelhantes de prevenção.","en":"Questões podem apresentar um cenário e pedir qual medida reduz o risco de forma mais direta.","cu":"Quedas são um problema importante para idosos porque podem produzir lesões e perda de autonomia.","c":"Escolha um ambiente da escola e faça uma inspeção de riscos.","r":"Não confunda prevenção com punição: prevenção procura reduzir a chance ou consequência do evento.","f":["Materiais de educação em saúde e segurança"]},"B13":{"p":"Primeiros socorros são medidas imediatas para preservar a vida, impedir agravamento e acionar ajuda especializada. O primeiro princípio é <strong>não transformar o socorrista em outra vítima</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Sequência geral</h4><p>Primeiro, observe a segurança do local. Depois avalie a situação e a pessoa, acione o serviço de emergência quando necessário e ofereça apenas medidas para as quais você está treinado.</p><p>Em uma parada cardiorrespiratória de adulto, diretrizes de primeiros socorros ensinam a iniciar compressões torácicas quando indicado e usar um DEA assim que disponível, seguindo as instruções do aparelho.</p><div class=&quot;formula-block&quot;>RCP: 100–120 compressões/min<br>Profundidade aproximada em adulto: 5–6 cm<br>Relação 30:2 quando ventilação é realizada</div><p>Em engasgos e hemorragias, a conduta depende da situação. O ponto comum é reconhecer rapidamente o problema, pedir ajuda e aplicar a técnica adequada.</p><div class=&quot;destaque&quot;><strong>Emergência no Brasil:</strong> SAMU 192. Em uma situação real, siga orientação do serviço de emergência e protocolos oficiais atualizados.</div>","ap":"A sequência mental é: <strong>segurança → avaliar → chamar ajuda → agir dentro do treinamento → acompanhar</strong>.","m":"<div class=&quot;formula-block&quot;>RCP adulto: 100–120/min<br>30:2 quando indicado</div>","a":"Conhecimento de primeiros socorros pode reduzir atrasos até a chegada do atendimento profissional.","en":"Questões podem pedir ordem de condutas ou identificar a finalidade de uma técnica.","cu":"O DEA analisa o ritmo e orienta o socorrista; ele deve ser usado seguindo as instruções do equipamento.","c":"Revise um fluxograma oficial de primeiros socorros e memorize o número 192.","r":"Não tente técnicas para as quais você não tem treinamento em uma emergência real; priorize segurança e orientação profissional.","f":["Manuais oficiais de primeiros socorros","SAMU 192"]},"B14":{"p":"A escola é um espaço de aprendizagem, mas também é um espaço de promoção da saúde. O <strong>Programa Saúde na Escola (PSE)</strong> aproxima educação e saúde.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Por que escola e saúde trabalham juntas?</h4><p>Estudantes passam uma parte importante da vida na escola. Isso torna o ambiente escolar estratégico para vacinação, saúde bucal, alimentação, saúde mental, prevenção de violências e outras ações.</p><p>No PSE, profissionais de saúde e educação podem planejar ações de acordo com as necessidades da comunidade escolar. O estudante não é apenas receptor: pode atuar como <strong>multiplicador de informações</strong> e participar de ações de promoção da saúde.</p><div class=&quot;destaque&quot;><strong>Planejamento:</strong> identificar necessidade → escolher ação → envolver escola e saúde → executar → avaliar resultados.</div>","ap":"Pense no PSE como uma ponte: a escola conhece o território e a rotina dos estudantes; a saúde oferece conhecimentos e serviços especializados.","m":"<div class=&quot;formula-block&quot;>PSE = educação + saúde + comunidade</div>","a":"Vacinação, saúde bucal, prevenção de violências e promoção da saúde mental são exemplos de temas que podem aparecer em ações escolares.","en":"Questões podem pedir qual ação integra educação e saúde ou como estudantes participam da promoção da saúde.","cu":"O PSE foi instituído em 2007.","c":"Crie uma proposta de ação do PSE para um problema real da escola.","r":"Não reduza saúde na escola a atendimento médico: promoção e prevenção também fazem parte.","f":["Ministério da Saúde — PSE"]},"B15":{"p":"No Brasil, a saúde é reconhecida constitucionalmente como um direito. O Sistema Único de Saúde organiza parte importante das ações e serviços públicos de saúde.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que diz a Constituição?</h4><p>O artigo 196 da Constituição Federal estabelece que a saúde é direito de todos e dever do Estado, garantida mediante políticas sociais e econômicas que busquem reduzir riscos de doença e outros agravos e assegurar acesso universal e igualitário.</p><p>O SUS é orientado por princípios como <strong>universalidade, integralidade e equidade</strong>. Universalidade significa que o sistema se destina a todas as pessoas; integralidade envolve olhar para promoção, prevenção, tratamento e reabilitação; equidade reconhece que pessoas e grupos podem precisar de respostas diferentes para alcançar condições justas de acesso.</p><div class=&quot;destaque&quot;><strong>Diferença importante:</strong> igualdade é tratar todos da mesma maneira; equidade busca considerar necessidades diferentes para reduzir desigualdades injustas.</div>","ap":"Ao estudar SUS, não memorize apenas três palavras. Relacione cada princípio a um exemplo concreto de política ou atendimento.","m":"<div class=&quot;formula-block&quot;>SUS: universalidade + integralidade + equidade</div>","a":"A saúde pública envolve promoção, prevenção, vigilância, assistência e participação social.","en":"Questões podem apresentar situações e perguntar qual princípio do SUS está sendo aplicado.","cu":"A Constituição de 1988 é conhecida como Constituição Cidadã e estabeleceu a saúde como direito de todos e dever do Estado.","c":"Crie um exemplo para cada princípio do SUS.","r":"Não confunda universalidade com ausência de organização: o SUS possui redes, níveis de atenção e critérios técnicos para organizar serviços.","f":["Constituição Federal de 1988","Ministério da Saúde"]},"B16":{"p":"Direitos humanos e saúde estão ligados porque condições de vida, acesso a serviços e proteção contra violência influenciam diretamente o bem-estar das pessoas.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Violação de direitos</h4><p>Violência pode ocorrer de várias formas: física, psicológica, sexual, institucional, patrimonial ou por negligência. A identificação depende do contexto e da pessoa afetada.</p><p><strong>Negligência</strong> envolve deixar de fornecer cuidados necessários quando existe responsabilidade de fazê-lo. Em serviços de saúde, práticas desrespeitosas ou que retirem autonomia e dignidade podem representar violações de direitos.</p><p>Em situações de suspeita de violência, a resposta adequada depende da idade da vítima, do tipo de violência e das normas locais. No Brasil, o <strong>Disque 100</strong> é um canal de denúncia e proteção de direitos humanos.</p><div class=&quot;destaque&quot;><strong>Princípio:</strong> identificar → proteger a pessoa → registrar/encaminhar conforme protocolo → acionar a rede de proteção.</div>","ap":"O objetivo de estudar o tema é reconhecer situações e saber que existem redes e canais de proteção, não resolver sozinho casos complexos.","m":"<div class=&quot;formula-block&quot;>Proteção = identificação + acolhimento + encaminhamento</div>","a":"Escolas, serviços de saúde e órgãos de proteção podem atuar em conjunto.","en":"Questões podem apresentar casos e pedir para identificar uma violação ou um canal de proteção.","cu":"O Disque 100 recebe denúncias relacionadas a violações de direitos humanos.","c":"Monte uma rede com escola, saúde, assistência social e órgãos de proteção.","r":"Não exponha ou investigue sozinho uma vítima em situação real. A proteção e o encaminhamento adequado são prioritários.","f":["Disque 100 — Direitos Humanos"]},"B17":{"p":"Prevenir violência envolve reduzir fatores de risco, fortalecer relações e construir ambientes em que conflitos possam ser tratados antes de se transformarem em danos.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Prevenção e intervenção</h4><p><strong>Prevenção</strong> procura diminuir a probabilidade de violência antes que ela aconteça. <strong>Intervenção</strong> acontece quando já existe um problema e é necessário proteger pessoas e interromper o dano.</p><p>A <strong>cultura de paz</strong> valoriza diálogo, respeito, participação e resolução não violenta de conflitos. Isso não significa ignorar situações graves: quando há risco, é necessário acionar responsáveis e serviços competentes.</p><p>A prevenção também é intersetorial. Escola, saúde, assistência social, conselho tutelar, Ministério Público e outros órgãos podem ter papéis diferentes na rede de proteção.</p><p>Na <strong>justiça restaurativa</strong>, o foco pode incluir reconhecimento do dano, responsabilização e reparação, conforme o contexto e os procedimentos adequados.</p>","ap":"Uma rede de proteção funciona melhor quando cada instituição sabe seu papel e consegue encaminhar o caso sem deixar a pessoa desassistida.","m":"<div class=&quot;formula-block&quot;>Prevenção → reduzir riscos<br>Intervenção → proteger e interromper danos</div>","a":"Projetos escolares de convivência, mediação e educação socioemocional podem contribuir para prevenção.","en":"Questões podem pedir diferença entre prevenção, intervenção e reparação.","cu":"A justiça restaurativa não significa simplesmente “perdoar”: envolve processos estruturados de responsabilização e reparação.","c":"Desenhe uma árvore de prevenção com causas, fatores de proteção e ações.","r":"Não trate toda situação de conflito como equivalente a violência; contexto, intensidade e risco importam.","f":["Materiais de direitos humanos e justiça restaurativa"]},"B18":{"p":"Um plano de ação transforma um problema amplo em um conjunto de ações concretas. Para isso, é necessário diagnosticar, priorizar, agir e avaliar.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como construir um plano?</h4><p><strong>1. Diagnóstico:</strong> descreva o problema usando dados e evidências. <strong>2. Priorização:</strong> escolha o que deve ser enfrentado primeiro. <strong>3. Objetivo:</strong> defina o resultado esperado. <strong>4. Ações:</strong> descreva o que será feito, por quem e quando.</p><p>Uma meta <strong>SMART</strong> é específica, mensurável, alcançável, relevante e temporal. Isso ajuda a transformar “melhorar a saúde da escola” em algo que possa ser acompanhado.</p><p>Os <strong>nós críticos</strong> são causas ou pontos do problema que têm grande impacto e podem ser alvo de intervenção. Depois da execução, indicadores permitem verificar se houve mudança.</p><div class=&quot;destaque&quot;><strong>PDCA:</strong> planejar → executar → verificar → agir/corrigir. O plano não termina quando a ação é executada; é preciso aprender com o resultado.</div>","ap":"Um bom plano responde cinco perguntas: <strong>qual problema? qual objetivo? qual ação? quem e quando? como saberemos se funcionou?</strong>","m":"<div class=&quot;formula-block&quot;>Diagnóstico → Priorização → SMART → Ação → Indicadores → Avaliação</div>","a":"Projetos escolares, campanhas de saúde e intervenções comunitárias podem usar essa estrutura.","en":"Questões podem pedir identificação da etapa do planejamento ou construção de uma meta SMART.","cu":"Indicadores tornam o acompanhamento mais objetivo porque permitem comparar situação inicial e resultado.","c":"Pegue um problema simples da escola e escreva uma meta SMART para ele.","r":"Não confunda ação com objetivo: “realizar palestra” é uma ação; “aumentar conhecimento sobre prevenção” é um objetivo que pode ser medido.","f":["Planejamento em saúde — princípios SMART e PDCA"]},"R1":{"p":"Um robô começa percebendo o mundo. Sensores transformam grandezas físicas em sinais que um microcontrolador consegue processar.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Da grandeza ao dado</h4><p>Um sensor não “entende” temperatura ou luz como uma pessoa. Ele responde fisicamente à grandeza e produz um sinal elétrico. Um <strong>LDR</strong>, por exemplo, altera sua resistência de acordo com a iluminação.</p><p>Quando um sinal analógico entra em um ADC, ele é convertido em um número. Em 10 bits existem 1024 níveis, de 0 a 1023.</p><div class=&quot;formula-block&quot;>V ≈ (leitura/1023)·Vref</div><p>Depois da leitura, o programa pode comparar o valor com um limite, registrar dados, mostrar um gráfico ou acionar um dispositivo.</p><div class=&quot;destaque&quot;><strong>Cadeia:</strong> grandeza física → sensor → sinal → ADC → número → programa → decisão.</div>","ap":"Ao projetar um sistema, pergunte sempre o que está sendo medido, qual sensor é adequado e como o sinal será convertido.","m":"<div class=&quot;formula-block&quot;>10 bits → 2¹⁰ = 1024 níveis</div>","a":"Estações de monitoramento, wearables e protótipos de automação usam essa cadeia.","en":"Questões podem pedir resolução do ADC ou identificar qual sensor mede determinada grandeza.","cu":"Sensores MEMS são usados em dispositivos eletrônicos para medir aceleração, rotação e outras grandezas.","c":"Faça um diagrama do caminho de uma leitura de temperatura até um gráfico no computador.","r":"Não confunda sensor com atuador: sensor mede; atuador produz uma ação física.","f":["Horowitz & Hill — The Art of Electronics"]},"R2":{"p":"Automação significa fazer um sistema executar ações com base em regras, sensores e estados. Uma das estruturas mais simples é a condição <strong>IF/THEN/ELSE</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como uma decisão funciona?</h4><p>O programa lê um valor e testa uma condição. Se a condição for verdadeira, executa a ação definida em <strong>THEN</strong>. Caso contrário, pode executar <strong>ELSE</strong>.</p><div class=&quot;formula-block&quot;>IF leitura &gt; limiar<br>THEN ligar<br>ELSE desligar</div><p>O problema de usar exatamente um limiar para ligar e desligar pode gerar oscilação. Se a leitura fica próxima do limite, o sistema pode ligar e desligar repetidamente.</p><p>A <strong>histerese</strong> cria dois limites. Por exemplo, ligar acima de 30 °C e desligar somente abaixo de 28 °C.</p><div class=&quot;destaque&quot;><strong>Resultado:</strong> o sistema deixa de reagir a pequenas flutuações em torno de um único ponto.</div>","ap":"Aprenda a ler uma regra como uma frase: “se isso acontecer, faça aquilo; caso contrário, faça outra coisa”.","m":"<div class=&quot;formula-block&quot;>IF condição → THEN ação<br>ELSE → alternativa</div>","a":"Ar-condicionado, iluminação automática e alarmes são exemplos simples.","en":"Questões podem pedir o resultado de uma condição ou identificar a função da histerese.","cu":"Controladores lógicos programáveis (CLPs) são usados amplamente na automação industrial.","c":"Crie três regras IF/THEN para uma casa inteligente.","r":"Não use o mesmo limite para ligar e desligar quando a oscilação for um problema; considere histerese.","f":["Groover — Automation"]},"R3":{"p":"Uma iluminação automática precisa transformar uma mudança na luz ambiente em uma decisão elétrica. O LDR é um exemplo simples de sensor usado para isso.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>LDR + divisor de tensão</h4><p>Um LDR (Light Dependent Resistor) altera sua resistência conforme a iluminação. Para que um microcontrolador leia essa mudança como tensão, o LDR pode ser colocado em um <strong>divisor de tensão</strong> com outro resistor.</p><p>O circuito produz uma tensão que varia conforme a resistência do LDR. O ADC transforma essa tensão em uma leitura numérica.</p><p>O programa então escolhe um limiar. Por exemplo: se a leitura indicar pouca luz, ligar o LED; se indicar luz suficiente, desligar.</p><div class=&quot;formula-block&quot;>Pouca luz → condição verdadeira → LED ligado</div><div class=&quot;destaque&quot;><strong>Projeto completo:</strong> luz → LDR → divisor → ADC → IF/THEN → saída → LED.</div>","ap":"O mais importante não é decorar o número 500 do exemplo, mas entender que o limiar precisa ser calibrado para o ambiente e o circuito.","m":"<div class=&quot;formula-block&quot;>R<sub>LDR</sub> varia com luz → V<sub>saída</sub> varia → ADC lê</div>","a":"Postes automáticos e sistemas de iluminação podem usar sensores de luminosidade.","en":"Questões podem apresentar um circuito e pedir qual componente mede luz ou como a decisão é tomada.","cu":"A calibração do limiar evita que pequenas mudanças ambientais acionem o sistema de maneira inadequada.","c":"Imagine um corredor e escolha um valor de limiar; depois explique como testaria se ele funciona.","r":"Não assuma que toda montagem LDR aumenta a tensão quando a luz aumenta: isso depende de como o divisor foi conectado.","f":["Horowitz & Hill — The Art of Electronics"]},"R4":{"p":"Controlar temperatura é um problema clássico de automação porque a temperatura varia continuamente e o sistema precisa reagir sem oscilar demais.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Sensor, setpoint e erro</h4><p>Um termistor pode ser usado como sensor de temperatura. O controlador compara a leitura com o <strong>setpoint</strong>, que é o valor desejado.</p><div class=&quot;formula-block&quot;>erro = setpoint − leitura</div><p>Uma solução simples é usar liga/desliga com histerese: ligar o aquecedor quando a temperatura cai abaixo de um limite e desligá-lo quando ultrapassa outro.</p><p>Um PID permite uma ação mais contínua. O termo proporcional reage ao erro atual, o integral considera erros acumulados e o derivativo reage à tendência de mudança.</p><div class=&quot;destaque&quot;><strong>Exemplo:</strong> em uma estufa, setpoint = 25 °C. O sistema pode ligar o aquecimento abaixo de 24 °C e desligar acima de 26 °C.</div>","ap":"Primeiro entenda liga/desliga e histerese. Depois avance para PID. Não tente aprender a equação do PID sem saber o que é erro e setpoint.","m":"<div class=&quot;formula-block&quot;>erro = setpoint − leitura<br>PID = P + I + D</div>","a":"Estufas, impressoras 3D e processos industriais precisam controlar temperatura.","en":"Questões podem pedir identificação do setpoint ou interpretação de uma curva de temperatura.","cu":"Ziegler-Nichols é um conjunto clássico de métodos para ajuste de controladores PID.","c":"Desenhe uma curva de temperatura e marque setpoint, limites de histerese e momentos de atuação.","r":"Não confunda sensor de temperatura com controlador: um mede; o outro decide como agir.","f":["Åström — teoria de controle"]},"R5":{"p":"Uma estação experimental coleta dados continuamente. Para transformar leituras em informação, precisamos organizar, filtrar e visualizar esses dados.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Da leitura ao dashboard</h4><p>Uma estação pode possuir sensores de temperatura, umidade, luz ou pressão. Cada leitura é registrada com um valor e, normalmente, um instante de tempo.</p><p>Dados reais podem conter ruído. Uma <strong>média móvel</strong> suaviza variações rápidas ao calcular a média de uma janela de valores:</p><div class=&quot;formula-block&quot;>M = (x₁ + x₂ + ... + xₖ)/k</div><p>Depois, gráficos e indicadores ajudam a perceber tendências, máximos, mínimos e mudanças abruptas.</p><div class=&quot;destaque&quot;><strong>Pipeline:</strong> sensor → aquisição → armazenamento → tratamento → visualização → interpretação.</div>","ap":"Um gráfico não substitui os dados. Ele é uma representação para facilitar a interpretação.","m":"<div class=&quot;formula-block&quot;>M<sub>n</sub> = (x<sub>n</sub> + ... + x<sub>n-k+1</sub>)/k</div>","a":"Meteorologia, monitoramento ambiental e sistemas industriais usam aquisição e visualização contínuas.","en":"Questões podem apresentar séries temporais e pedir identificação de tendência ou efeito de uma média móvel.","cu":"Estações com microcontroladores podem enviar dados para dashboards locais ou na internet.","c":"Crie uma pequena série de 5 temperaturas e calcule a média móvel de 3 valores.","r":"Uma média móvel suaviza ruído, mas também pode esconder mudanças rápidas; escolha a janela com cuidado.","f":["Horowitz & Hill — The Art of Electronics"]},"R6":{"p":"Robótica pode contribuir para sustentabilidade quando é usada para <strong>medir problemas, orientar decisões e avaliar resultados</strong>, e não apenas para automatizar por automatizar.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Medir → analisar → agir → avaliar</h4><p>Imagine uma escola que quer reduzir desperdício de energia. Sensores podem medir corrente, luminosidade ou temperatura. Esses dados podem ser organizados em indicadores, como consumo por sala ou por período.</p><p>Depois da análise, uma ação pode ser escolhida: ajustar iluminação, detectar equipamentos ligados sem necessidade ou mudar horários. Por fim, é preciso medir novamente para verificar se a intervenção funcionou.</p><div class=&quot;formula-block&quot;>Medir → Analisar → Agir → Avaliar</div><div class=&quot;destaque&quot;><strong>O dado só vira decisão quando é interpretado:</strong> um sensor sozinho não resolve o problema.</div>","ap":"Comece pelo problema ambiental e só depois escolha o sensor. Essa ordem evita criar uma tecnologia sem finalidade clara.","m":"<div class=&quot;formula-block&quot;>Indicador = medida usada para acompanhar um objetivo</div>","a":"Monitoramento de energia, água, resíduos e qualidade ambiental pode usar sensores e dashboards.","en":"Questões podem pedir qual etapa vem depois da medição ou qual indicador melhor representa um objetivo.","cu":"Sensores de corrente podem medir consumo sem necessariamente interromper o circuito, dependendo do tipo utilizado.","c":"Escolha um problema ambiental da escola e desenhe um ciclo de medição e avaliação.","r":"Não confunda quantidade de sensores com qualidade da solução: a pergunta principal é se o sistema ajuda a tomar uma decisão melhor.","f":["ONU — sustentabilidade e indicadores"]},"R7":{"p":"Sensores também podem ser usados para detectar situações potencialmente perigosas. A lógica básica é combinar <strong>medição, limiar, decisão e alerta</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>Como um sistema de alerta funciona?</h4><p>Um acelerômetro pode medir aceleração em diferentes eixos. Um sensor de gás pode detectar concentração de determinada substância. Um sensor de temperatura pode identificar aquecimento anormal.</p><p>O sistema precisa de uma regra para interpretar o sinal. Por exemplo, se a leitura ultrapassar um limite durante determinado intervalo, pode gerar um alerta.</p><p>O limite deve ser <strong>calibrado</strong>. Um limiar muito sensível pode produzir falsos positivos; um limiar alto demais pode deixar passar eventos reais.</p><div class=&quot;destaque&quot;><strong>Segurança:</strong> sistemas reais podem usar redundância, confirmação de eventos e mecanismos de falha segura.</div>","ap":"Um sensor de segurança não deve apenas “detectar”. Ele precisa ter uma decisão confiável e uma forma apropriada de comunicar o evento.","m":"<div class=&quot;formula-block&quot;>sensor → filtro/confirmação → limiar → alerta/atuador</div>","a":"Wearables, detectores de gás e sistemas de monitoramento podem usar arquiteturas semelhantes.","en":"Questões podem pedir qual sensor é adequado para uma situação ou por que a calibração é necessária.","cu":"Redundância pode reduzir a chance de uma única falha causar uma decisão perigosa.","c":"Desenhe um sistema que detecte uma queda e liste três possíveis fontes de falso positivo.","r":"Não trate um protótipo escolar como dispositivo médico ou de segurança certificado.","f":["OMS — tecnologia assistiva e segurança"]},"R8":{"p":"Para integrar um robô a uma plataforma digital, é preciso estabelecer uma comunicação entre o microcontrolador e o computador. Uma opção é a <strong>porta serial</strong>.","i":"Antes de ler a explicação, tente responder: o que você já sabe sobre esse fenômeno? Que grandezas, estruturas ou relações parecem importantes?","e":"<h4>O que é comunicação serial?</h4><p>Na comunicação serial, os dados são enviados sequencialmente por uma interface. O computador e o microcontrolador precisam concordar com parâmetros de comunicação, como a taxa de transmissão (<strong>baud rate</strong>).</p><p>Em um protótipo, o microcontrolador pode enviar uma linha como <code>temperatura=24.5</code>. O navegador recebe a informação e pode atualizar um gráfico ou painel.</p><p>A <strong>Web Serial API</strong> permite que navegadores compatíveis acessem portas seriais após autorização do usuário. Em outros projetos, Wi-Fi e HTTP podem ser usados.</p><div class=&quot;formula-block&quot;>Robô → serial/Wi-Fi → computador → JavaScript → dashboard</div><div class=&quot;destaque&quot;><strong>Detalhe importante:</strong> “9600” é apenas um exemplo de baud rate. Os dois lados precisam usar parâmetros compatíveis.</div>","ap":"Separe o problema em duas partes: primeiro faça o robô enviar dados corretamente; depois faça o computador interpretar esses dados.","m":"<div class=&quot;formula-block&quot;>Baud rate = taxa de transmissão configurada</div>","a":"IoT, dashboards educacionais e protótipos de robótica podem usar comunicação serial ou rede.","en":"Questões podem pedir o papel da porta serial ou identificar qual parte do sistema interpreta os dados.","cu":"A Web Serial API depende do navegador e das permissões concedidas pelo usuário.","c":"Desenhe o caminho de uma leitura do sensor até aparecer em um gráfico no navegador.","r":"Não confunda comunicação serial com internet: serial é uma interface de comunicação; internet é uma rede.","f":["MDN — Web Serial API"]},"Q1":{"p":"Este módulo de Química ainda está reservado no planejamento da plataforma.","i":"O conteúdo ainda não foi definido na fonte original.","e":"<p>Este módulo foi marcado no projeto como <strong>reservado ao planejamento</strong>. Para não inventar conteúdo que a fonte não fornece, a aula permanece aguardando o planejamento da disciplina.</p><div class=&quot;destaque&quot;><strong>Quando o conteúdo for definido</strong>, esta etapa pode receber explicação conceitual, exemplos resolvidos, visualização, questão contextualizada e revisão.</div>","ap":"A definir conforme o planejamento da disciplina.","m":"Conteúdo ainda não definido.","a":"Aguardando planejamento.","en":"Aguardando planejamento.","cu":"Aguardando planejamento.","c":"Aguardando planejamento.","r":"Aguardando planejamento.","f":[]},"Q2":{"p":"Este módulo de Química ainda está reservado no planejamento da plataforma.","i":"O conteúdo ainda não foi definido na fonte original.","e":"<p>Este módulo foi marcado no projeto como <strong>reservado ao planejamento</strong>. Para não inventar conteúdo que a fonte não fornece, a aula permanece aguardando o planejamento da disciplina.</p><div class=&quot;destaque&quot;><strong>Quando o conteúdo for definido</strong>, esta etapa pode receber explicação conceitual, exemplos resolvidos, visualização, questão contextualizada e revisão.</div>","ap":"A definir conforme o planejamento da disciplina.","m":"Conteúdo ainda não definido.","a":"Aguardando planejamento.","en":"Aguardando planejamento.","cu":"Aguardando planejamento.","c":"Aguardando planejamento.","r":"Aguardando planejamento.","f":[]},"Q3":{"p":"Este módulo de Química ainda está reservado no planejamento da plataforma.","i":"O conteúdo ainda não foi definido na fonte original.","e":"<p>Este módulo foi marcado no projeto como <strong>reservado ao planejamento</strong>. Para não inventar conteúdo que a fonte não for