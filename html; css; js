    else if(has('Assassino')||has('Assassina')){stat='crit';label='Crítico';}
    else if(has('Suporte')){stat='hp';label='Vida';}
    else if(roles[0]===roles[1]&&roles[0]==='Tanque'){stat='def';label='Defesa';}
    const percent=Math.round(strength*100);
    out.push({a,b,name:`${ha.name} × ${hb.name}`,stat,label,strength,percent,affinity:Math.round(av),line:pool[Math.floor(Math.random()*pool.length)]});
  }
  return out;
}
function afkApplySynergyBonus(b,synergies){
  for(const s of (synergies||[])){
    if(s.stat==='crit') b.crit+=Math.max(2,Math.round(s.strength*100));
    else if(s.stat==='spd') b.spd*=1+s.strength;
    else if(s.stat==='hp') b.hp*=1+s.strength;
    else if(s.stat==='def') b.def*=1+s.strength;
    else b.atk*=1+s.strength;
  }
  return b;
}
