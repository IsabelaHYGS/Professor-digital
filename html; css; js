  document.getElementById('gameQuestion').classList.add('on');
}

function answerGameQuestion(idx){
  const q=GAME.currentQuestion,target=GAME.currentTarget;if(!q||!target)return;
  const btns=document.querySelectorAll('#gqOpts .gq-opt');
  btns.forEach((b,i)=>{b.disabled=true;if(i===q.c)b.classList.add('correct');if(i===idx&&idx!==q.c)b.classList.add('wrong');});
  const fb=document.getElementById('gqFeedback');
  fb.innerHTML=(idx===q.c)?`<strong>✔ Correto!</strong><br>${q.e}`:`<strong>✘ Errado.</strong><br>${q.e}`;
  fb.classList.add('on');
  setTimeout(()=>{
    document.getElementById('gameQuestion').classList.remove('on');GAME.questionOpen=false;
    if(idx===q.c){
      if(target.type==='enemy'){
        const e=target.target;
        if(e.isBoss){e.hp--;if(e.hp<=0){e.dead=true;GAME.score+=100;}else{e.x=e.minX-60;GAME.score+=20;}}
        else{e.dead=true;GAME.score+=50;}
        for(let i=0;i<10;i++)GAME.particles.push({x:e.x,y:e.y,vx:(Math.random()-0.5)*6,vy:-Math.random()*6,life:40,cor:'#A2CA8E'});
      }else if(target.type==='gate'){target.target.open=true;GAME.score+=30;}
      updateGameHUD();
    }else loseLife();
  },1400);
}

function loseLife(){
  GAME.lives--;updateGameHUD();
  if(GAME.player)GAME.player.invuln=90;
  if(GAME.lives<=0){
    showGameOverlay('💀 Game Over','Você ficou sem vidas. Tente a fase novamente.',[
      {label:'🔄 Tentar',cls:'pri',fn:'restartPhase()'},
      {label:'← Voltar',cls:'',fn:'closeGame()'}
    ]);
    return;
  }
  GAME.player.x=80;GAME.player.y=390;GAME.player.vx=0;GAME.player.vy=0;
}

function completePhase(){
  GAME.score+=100;updateGameHUD();
  const isLast=GAME.phaseIdx===GAME_TOTAL_FASES-1;
  if(isLast){
    const isLastIsl=GAME.islandIdx===GAME_ISLANDS.length-1;
    const prog=loadGameProgress();
    if(GAME.islandIdx+1>=prog.unlocked)prog.unlocked=GAME.islandIdx+2;
    if(GAME.score>prog.maxScore)prog.maxScore=GAME.score;
    saveGameProgress(prog);
    const s=loadStats(),before=new Set(s.achievements||[]);
    s.achievements=evaluateAchievements(s);
    const added=s.achievements.filter(a=>!before.has(a));saveStats(s);added.forEach(id=>queueAchievementNotif(id));
    if(isLastIsl)showGameOverlay('🏆 Você Venceu!',`${GAME.score} pontos!`,[{label:'← Voltar',cls:'pri',fn:'closeGame()'}]);
    else showGameOverlay('🎉 Ilha Completa!',`${GAME_ISLANDS[GAME.islandIdx].nome} · ${GAME.score} pts`,[
      {label:'▶ Próxima',cls:'pri',fn:'startGame('+(GAME.islandIdx+1)+')'},
      {label:'← Voltar',cls:'',fn:'closeGame()'}
    ]);
  }else{
    showGameOverlay('🏁 Fase Completa!',`Fase ${GAME.phaseIdx+1} · ⭐ ${GAME.score}`,[
      {label:'▶ Próxima',cls:'pri',fn:'nextPhase()'},
      {label:'🔄 Repetir',cls:'',fn:'restartPhase()'}
    ]);
  }
}

function nextPhase(){
  GAME.phaseIdx++;
  document.getElementById('gameOverlay').classList.remove('on');
