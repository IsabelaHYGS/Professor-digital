function afkDamage(attacker,target,mult=1,magic=false){
  const raw=attacker.atk*mult*(magic?1.08:1)*(Math.random()<((attacker.crit||0)/100)?1.75:1);
  const mitigation=magic?target.def*.35:target.def;
  const base=Math.max(1,Math.round(raw*(100/(100+mitigation))));
  if(target.shield){target.shield=0;return Math.max(1,Math.round(base*.55));}
  return base;
}
