.fc-deck .fc-deck-prog-bar{height:6px;background:var(--primary);border-radius:3px;overflow:hidden;margin-bottom:4px}
.fc-deck .fc-deck-prog-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));transition:width .4s}
