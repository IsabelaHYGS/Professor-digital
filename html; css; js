function todayKey(){ return new Date().toISOString().slice(0,10); }
function recordHistory(field, amount = 1){
  const s = loadStats(); s.history = s.history || {};
  const k = todayKey(); s.history[k] = s.history[k] || {quizCorrect:0, quizTotal:0, time:0, fcReviews:0};
  s.history[k][field] = (s.history[k][field]||0) + amount; saveStats(s);
