function pdEsc(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')}
function pdText(v){return String(v??'').replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim()}
function pdGuide(m){return PD_SLIDE_GUIDES[m.id]||{hook:m.objetivo||'Vamos entender este assunto.',core:pdText(m.objetivo)||'Observe as ideias principais e conecte-as ao problema.',visual:[m.titulo,'Conceito','Aplicação'],example:m.interatividade||'Explore a atividade do módulo.',mistake:'Decorar sem compreender o porquê.',application:'Relacione o conteúdo com uma situação concreta.'}}
