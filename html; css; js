function getDeckStats(mid){
  const cards = FLASHCARD_DB[mid] || [];
  if (isAdmin()) return { total: cards.length, seen: cards.length, mastered: cards.length, pct: 1 };
  let mastered=0, seen=0; const s=loadFC(); const d=s[mid]||{};
  cards.forEach((_,i)=>{ const c=d[i]; if (c&&c.attempts>0){ seen++; if (c.level>=3) mastered++; } });
  return { total: cards.length, seen, mastered, pct: cards.length>0?mastered/cards.length:0 };
