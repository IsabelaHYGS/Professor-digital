.fc-card-wrap{perspective:1400px;width:100%;max-width:560px;height:320px;position:relative}
.fc-card{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.2,.9,.4,1.1);cursor:pointer}
.fc-card.flipped{transform:rotateY(180deg)}
.fc-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:20px;border:2px solid var(--accent);padding:28px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;box-shadow:0 20px 50px rgba(0,0,0,.5);overflow:hidden}
.fc-face.front{background:linear-gradient(135deg,var(--surface),var(--primary))}
.fc-face.back{background:linear-gradient(135deg,#1a2c5c,#2a3a7c);transform:rotateY(180deg);border-color:var(--accent-l)}
.fc-face .fc-label{position:absolute;top:14px;left:16px;font-size:.66rem;color:var(--accent-l);font-weight:800;letter-spacing:1.4px}
.fc-face .fc-topic{position:absolute;top:14px;right:16px;font-size:.66rem;color:var(--muted);font-weight:600;background:rgba(0,0,0,.3);padding:3px 8px;border-radius:8px}
.fc-face .fc-question{font-size:1.1rem;color:var(--text);font-weight:600;line-height:1.5;max-width:95%}
.fc-face .fc-answer{font-size:.95rem;color:var(--text);line-height:1.65;max-width:95%;text-align:left}
.fc-face .fc-answer strong{color:var(--accent-l)}
.fc-face .fc-hint{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);font-size:.7rem;color:var(--muted);font-style:italic}
.fc-face .fc-hint-flip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);font-size:.7rem;color:var(--accent-l);font-weight:600}
.fc-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;width:100%;max-width:560px}
.fc-btn{padding:12px 22px;border-radius:12px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:700;cursor:pointer;font-size:.9rem;transition:.2s;display:flex;align-items:center;gap:6px;justify-content:center;flex:1;min-width:120px}
.fc-btn:hover:not(:disabled){transform:translateY(-2px)}
.fc-btn.wrong{border-color:#dc3232;color:#ff8888}
.fc-btn.hard{border-color:#EFAE78;color:#F5E19C}
.fc-btn.easy{border-color:#2ea043;color:#A2CA8E}
.fc-btn:disabled{opacity:.35;cursor:not-allowed}
.fc-footer{display:flex;justify-content:space-between;width:100%;max-width:560px;font-size:.84rem;color:var(--muted);margin-top:8px;align-items:center}
.fc-footer .fc-nav-btn{background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 14px;border-radius:8px;cursor:pointer;font:inherit;font-size:.82rem}
.fc-empty{text-align:center;padding:40px 20px;color:var(--muted)}
.fc-empty .icon{font-size:3rem;margin-bottom:10px;opacity:.6}

/* AUTH */
.auth-screen{position:fixed;inset:0;background:radial-gradient(circle at 50% 0%,rgba(255,152,0,.08),transparent 60%),var(--bg);display:none;align-items:center;justify-content:center;padding:20px;z-index:550;overflow-y:auto}
.auth-screen.on{display:flex}
.auth-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:32px;width:100%;max-width:420px;box-shadow:0 30px 80px rgba(0,0,0,.6)}
.auth-logo{text-align:center;margin-bottom:20px}
.auth-logo .big-cat{width:80px;height:80px;margin:0 auto 10px;display:block}
.auth-logo h1{font-size:1.6rem;margin-bottom:4px}
.auth-logo h1 span{color:var(--accent-l)}
.auth-logo p{font-size:.86rem;color:var(--muted);margin:0}
.auth-form{display:flex;flex-direction:column;gap:14px}
.auth-field{display:flex;flex-direction:column;gap:6px}
.auth-field label{font-size:.74rem;color:var(--accent-l);font-weight:700;letter-spacing:.5px}
.auth-field input{background:var(--bg);border:2px solid var(--border);color:var(--text);font:inherit;padding:11px 14px;border-radius:10px;outline:none;font-size:.92rem;transition:.2s;caret-color:var(--accent-l)}
.auth-field input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(255,152,0,.15)}
.auth-btn{padding:12px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--accent),var(--accent-l));color:var(--bg);font:inherit;font-weight:800;font-size:.95rem;cursor:pointer;transition:.2s;margin-top:6px}
.auth-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,152,0,.35)}
.auth-toggle{text-align:center;font-size:.85rem;color:var(--muted);margin-top:14px}
.auth-toggle a{color:var(--accent-l);cursor:pointer;font-weight:700}
.auth-error{background:rgba(220,50,50,.15);border:1px solid var(--err);color:#ff8888;padding:10px 14px;border-radius:8px;font-size:.84rem;display:none;margin-bottom:12px}
.auth-error.on{display:block}
.auth-info{background:rgba(255,204,80,.08);border-left:3px solid var(--accent-l);padding:10px 14px;border-radius:0 8px 8px 0;font-size:.8rem;color:var(--muted);margin-top:14px}
.auth-info strong{color:var(--accent-l)}

.user-chip{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);padding:4px 10px 4px 4px;border-radius:24px;cursor:pointer;transition:.2s;position:relative;margin-left:8px}
.user-chip:hover{border-color:var(--accent-l)}
.user-chip .avatar{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-l));display:flex;align-items:center;justify-content:center;font-size:16px}
.user-chip .name{font-size:.82rem;font-weight:700;color:var(--text)}
.user-chip .admin-tag{background:linear-gradient(135deg,#F5E19C,#EFAE78);color:#F5E19C;font-size:.6rem;font-weight:800;padding:1px 6px;border-radius:8px;letter-spacing:.6px}
.user-menu{position:absolute;top:calc(100% + 8px);right:0;background:var(--surface);border:1px solid var(--accent);border-radius:12px;padding:6px;min-width:200px;box-shadow:0 20px 50px rgba(0,0,0,.6);display:none;z-index:300}
.user-menu.open{display:block}
.user-menu button{display:flex;align-items:center;gap:10px;width:100%;background:transparent;border:none;color:var(--text);font:inherit;font-size:.86rem;text-align:left;padding:9px 12px;border-radius:8px;cursor:pointer;transition:.15s}
.user-menu button:hover{background:var(--primary);color:var(--accent-l)}
.user-menu button.danger:hover{background:rgba(220,50,50,.15);color:#ff8888}

.profile-header{background:linear-gradient(135deg,var(--surface),var(--primary));border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:22px;display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.profile-avatar{width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-l));display:flex;align-items:center;justify-content:center;font-size:52px;flex-shrink:0;border:4px solid var(--accent-l);box-shadow:0 8px 30px rgba(255,152,0,.4)}
.profile-info{flex:1;min-width:200px}
.profile-info h1{font-size:1.6rem;margin-bottom:4px}
.profile-info .email{font-size:.9rem;color:var(--accent-l);font-weight:700;margin-bottom:6px}
.profile-info .bio{font-size:.88rem;color:var(--muted)}
.profile-info .joined{font-size:.74rem;color:var(--muted);margin-top:6px}
.profile-actions{display:flex;gap:8px;flex-wrap:wrap}
.avatar-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:8px;margin-top:10px}
.avatar-picker button{background:var(--bg);border:2px solid var(--border);border-radius:12px;font-size:24px;padding:8px;cursor:pointer;transition:.2s}
.avatar-picker button:hover{border-color:var(--accent-l);transform:scale(1.05)}
.avatar-picker button.selected{border-color:var(--accent);background:rgba(255,152,0,.15);transform:scale(1.05)}

@media(max-width:640px){
  .hero{padding:20px}h1{font-size:1.4rem}main{padding:14px 10px 100px}.section{padding:16px}
  .mia-chat{width:calc(100vw - 24px);right:12px;height:calc(100vh - 120px)}
  .mia-btn{width:60px;height:60px;bottom:12px;right:12px}.mia-btn svg{width:48px;height:48px}
  .prof-sidebar{width:calc(100vw - 20px)}
  .pres-content{padding:70px 24px 60px}.pres-content h2{font-size:1.7rem}
  .slide-card{padding:30px 24px}.slide-card h1{font-size:1.7rem}.slide-card h2{font-size:1.4rem}
  .fc-card-wrap{height:260px}.fc-face .fc-question{font-size:.95rem}.fc-face .fc-answer{font-size:.85rem}
  .fc-btn{min-width:100px;font-size:.8rem;padding:10px 14px}
  .user-chip .name{display:none}
}


.afk-map{display:flex;flex-direction:column;gap:16px}.afk-map-region{border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px;background:rgba(0,0,30,.28)}.afk-map-region h3{margin:0 0 4px}.afk-map-track{display:grid;grid-template-columns:repeat(5,minmax(90px,1fr));gap:10px;margin-top:12px}.afk-map-node{position:relative;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:10px;min-height:88px;background:rgba(255,255,255,.025);cursor:pointer;transition:.18s}.afk-map-node:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.2)}.afk-map-node.current{border-color:var(--accent-l);box-shadow:0 0 0 1px rgba(255,255,255,.05) inset}.afk-map-node.done{opacity:.78}.afk-map-node.boss{background:linear-gradient(135deg,rgba(100,40,20,.35),rgba(70,20,60,.28));border-color:rgba(255,180,100,.35)}.afk-map-node.locked{opacity:.4;cursor:default}.afk-map-icon{font-size:1.35rem}.afk-map-stage{font-weight:800;margin-top:4px}.afk-map-small{font-size:.68rem;color:var(--muted);margin-top:3px}.afk-map-progress{height:8px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;margin-top:10px}.afk-map-progress span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));border-radius:99px}.afk-map-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:.72rem;color:var(--muted);margin-top:10px}.afk-map-legend span{display:inline-flex;align-items:center;gap:5px}.afk-map-reward{font-size:.67rem;color:var(--accent-l);margin-top:6px}.afk-map-current{font-size:.75rem;color:var(--text);padding:10px;border-radius:10px;background:rgba(255,255,255,.035);margin-top:10px}
/* ============ CRÔNICAS DO SABER / AFK ============ */
.afk-page{display:flex;flex-direction:column;gap:16px}
.afk-hero{background:linear-gradient(135deg,#66AF91,#4a1a6c 55%,#7a3b8f);border:1px solid rgba(255,204,80,.25);border-radius:18px;padding:24px;position:relative;overflow:hidden}
.afk-hero::after{content:'✦';position:absolute;right:28px;top:10px;font-size:8rem;color:rgba(255,204,80,.08);transform:rotate(18deg)}
.afk-hero h1{margin-bottom:6px}
.afk-hero p{max-width:720px}
.afk-resources{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px;position:relative;z-index:1}
.afk-resource{background:rgba(0,0,32,.45);border:1px solid var(--border);border-radius:12px;padding:12px;display:flex;align-items:center;gap:10px}
.afk-resource .r-icon{font-size:1.45rem}.afk-resource .r-val{font-size:1.15rem;font-weight:800;color:var(--accent-l);line-height:1}.afk-resource .r-label{font-size:.68rem;color:var(--muted);margin-top:2px}
.afk-tabs{display:flex;gap:6px;flex-wrap:wrap}.afk-tab{padding:8px 14px;border-radius:9px;border:1px solid var(--border);background:var(--surface);color:var(--muted);font:inherit;font-weight:700;cursor:pointer}.afk-tab.active{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.afk-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px}
.afk-panel h2,.afk-panel h3{color:var(--accent-l);margin-bottom:6px}.afk-panel .sub{font-size:.8rem;color:var(--muted);margin-bottom:14px}
.afk-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}
.afk-team{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}
.afk-hero-card{background:linear-gradient(145deg,#20245b,#F5E19C);border:1px solid var(--border);border-radius:13px;padding:9px;cursor:pointer;position:relative;overflow:hidden;transition:.2s;min-height:190px}
.afk-hero-card:hover{transform:translateY(-3px);border-color:var(--accent)}
.afk-hero-card.active{border:2px solid var(--accent-l);box-shadow:0 0 0 2px rgba(255,204,80,.08)}
.afk-hero-card.locked{opacity:.4;cursor:not-allowed;filter:grayscale(.5)}
.afk-hero-art{height:100px;border-radius:10px;background:radial-gradient(circle at 50% 35%,rgba(255,204,80,.18),transparent 55%),#101032;display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.afk-hero-art svg{width:90px;height:90px;display:block;filter:drop-shadow(0 5px 8px rgba(0,0,0,.35))}
.afk-hero-card .rarity{font-size:.61rem;color:var(--accent-l);font-weight:800;letter-spacing:.8px}.afk-hero-card h4{font-size:.82rem;margin:2px 0}.afk-hero-card .role{font-size:.66rem;color:var(--muted)}
.afk-hero-card .lvl{position:absolute;right:8px;bottom:8px;font-size:.65rem;background:rgba(0,0,0,.4);color:var(--accent-l);padding:2px 6px;border-radius:7px}
.afk-detail{display:grid;grid-template-columns:130px 1fr;gap:14px}.afk-detail-art{background:#0e0e30;border:1px solid var(--border);border-radius:14px;display:flex;align-items:center;justify-content:center;min-height:150px}.afk-detail-art svg{width:125px;height:125px}.afk-detail h2{font-size:1.25rem}.afk-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:10px 0}.afk-stat{background:rgba(0,0,32,.45);border-radius:8px;padding:7px}.afk-stat b{display:block;color:var(--accent-l);font-size:.8rem}.afk-stat span{font-size:.65rem;color:var(--muted)}
.afk-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.afk-actions .btn{font-size:.78rem;padding:7px 10px}
.afk-progress{height:8px;background:var(--primary);border-radius:4px;overflow:hidden;margin:6px 0}.afk-progress>div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));transition:width .3s}
.afk-expedition{background:linear-gradient(135deg,#0d1036,#24134c);border:1px solid rgba(255,204,80,.2);border-radius:14px;padding:18px;position:relative;overflow:hidden}.afk-expedition .enemy-row{display:flex;align-items:center;gap:12px;margin:14px 0}.afk-enemy{width:74px;height:74px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.2rem;background:rgba(220,50,50,.16);border:2px solid rgba(220,50,50,.45)}
.afk-power{display:flex;justify-content:space-between;gap:10px;font-size:.8rem;color:var(--muted)}.afk-power strong{color:var(--accent-l)}
.afk-log{background:#F5E19C;border:1px solid var(--border);border-radius:9px;padding:10px;min-height:88px;max-height:150px;overflow:auto;font-size:.72rem;color:var(--muted);line-height:1.5}.afk-log div{margin-bottom:3px}.afk-log .win{color:#A2CA8E}.afk-log .loss{color:#ff8888}
.afk-collection{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}.afk-summon{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.afk-summon .btn{padding:11px}
.afk-modal{position:fixed;inset:0;background:rgba(0,0,32,.9);z-index:700;display:none;align-items:center;justify-content:center;padding:20px}.afk-modal.open{display:flex}.afk-modal-box{width:100%;max-width:760px;max-height:90vh;overflow:auto;background:var(--surface);border:2px solid var(--accent);border-radius:18px;padding:20px}.afk-result{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:14px}.afk-result-card{background:#F5E19C;border:1px solid var(--border);border-radius:12px;padding:10px;text-align:center}.afk-result-card svg{width:76px;height:76px}.afk-result-card strong{display:block;color:var(--accent-l);font-size:.8rem}.afk-result-card span{font-size:.65rem;color:var(--muted)}
@media(max-width:900px){.afk-layout{grid-template-columns:1fr}.afk-team{grid-template-columns:repeat(2,1fr)}.afk-resources{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.afk-resources{grid-template-columns:1fr 1fr}.afk-detail{grid-template-columns:1fr}.afk-detail-art{min-height:120px}.afk-summon{grid-template-columns:1fr}.afk-hero-card{min-height:175px}}


/* Artes dos heróis */
.afk-hero-art.afk-image-art{padding:0;overflow:hidden;background:#0b0b28}
.afk-hero-art.afk-image-art img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .25s,filter .25s}
.afk-hero-card:hover .afk-image-art img{transform:scale(1.045)}
.afk-detail-art.afk-full-art{padding:0;overflow:hidden;background:#080817;min-height:260px;cursor:pointer}
.afk-detail-art.afk-full-art img{width:100%;height:100%;min-height:260px;object-fit:cover;display:block}
.afk-portrait-modal{position:fixed;inset:0;background:rgba(3,3,15,.94);z-index:850;display:none;align-items:center;justify-content:center;padding:20px}
.afk-portrait-modal.open{display:flex}
.afk-portrait-box{width:min(1120px,96vw);max-height:94vh;display:grid;grid-template-columns:minmax(280px,430px) 1fr;gap:22px;background:linear-gradient(145deg,#151535,#09091b);border:1px solid rgba(255,204,80,.45);border-radius:20px;padding:16px;box-shadow:0 25px 90px rgba(0,0,0,.65);overflow:auto}
.afk-portrait-image{background:#05050f;border-radius:14px;overflow:hidden;min-height:520px;display:flex;align-items:center;justify-content:center}
.afk-portrait-image img{width:100%;height:100%;max-height:78vh;object-fit:cover;display:block}
.afk-portrait-info{padding:12px 10px 12px 0;display:flex;flex-direction:column;justify-content:center}
.afk-portrait-info h2{font-size:2.2rem;margin:4px 0;color:var(--accent-l)}
.afk-portrait-sub{color:var(--muted);font-size:.9rem;margin-bottom:16px}
.afk-portrait-skill{background:rgba(255,204,80,.07);border:1px solid rgba(255,204,80,.2);border-radius:12px;padding:12px;margin:12px 0}
.afk-portrait-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.afk-portrait-stat{background:#F5E19C;border:1px solid var(--border);border-radius:10px;padding:10px}
.afk-formation{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
.afk-formation-side{background:#F5E19C;border:1px solid var(--border);border-radius:14px;padding:12px}
.afk-formation-side h3{font-size:.78rem;color:var(--accent-l);margin-bottom:8px;text-transform:uppercase;letter-spacing:.8px}
.afk-slots{display:grid;grid-template-columns:1fr 1fr;gap:8px}
