  for (let i=0;i<n;i++){ const a = -Math.PI/2+i*2*Math.PI/n; svg += `<line x1="${cx}" y1="${cy}" x2="${cx+Math.cos(a)*maxR}" y2="${cy+Math.sin(a)*maxR}" stroke="rgba(255,204,80,.15)"/><text x="${cx+Math.cos(a)*(maxR+24)}" y="${cy+Math.sin(a)*(maxR+24)}" fill="#fff" font-size="11" text-anchor="middle" dominant-baseline="middle" font-weight="600">${items[i].label}</text>`; }
  let p=''; for (let i=0;i<n;i++){ const a = -Math.PI/2+i*2*Math.PI/n; const r = maxR*Math.max(0.08,items[i].value); p += (i===0?'M':'L')+` ${(cx+Math.cos(a)*r).toFixed(1)} ${(cy+Math.sin(a)*r).toFixed(1)} `; } p+='Z';
  svg += `<path d="${p}" fill="rgba(255,152,0,.35)" stroke="#EFAE78" stroke-width="2"/>`;
  for (let i=0;i<n;i++){ const a = -Math.PI/2+i*2*Math.PI/n; const r = maxR*Math.max(0.08,items[i].value); svg += `<circle cx="${(cx+Math.cos(a)*r).toFixed(1)}" cy="${(cy+Math.sin(a)*r).toFixed(1)}" r="4" fill="${items[i].color}"/>`; }
