}

function drawPlayer(ctx){
  const p=GAME.player;if(!p)return;
  if(p.invuln>0&&Math.floor(p.invuln/4)%2===0)return;
  ctx.save();ctx.translate(p.x,p.y);ctx.scale(p.facing,1);
  ctx.fillStyle='rgba(0,0,0,.25)';ctx.beginPath();ctx.ellipse(0,20,16,4,0,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#F5E19C';roundRect(ctx,-14,-14,28,28,8);ctx.fill();
  ctx.fillStyle='#EFAE78';ctx.beginPath();ctx.moveTo(-12,-10);ctx.lineTo(-7,-22);ctx.lineTo(-2,-10);ctx.closePath();ctx.fill();ctx.beginPath();ctx.moveTo(2,-10);ctx.lineTo(7,-22);ctx.lineTo(12,-10);ctx.closePath();ctx.fill();
  ctx.fillStyle='#F5E19C';ctx.beginPath();ctx.arc(-5,-3,2.5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(5,-3,2.5,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(255,152,0,.4)';ctx.beginPath();ctx.arc(-8,2,3,0,Math.PI*2);ctx.arc(8,2,3,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#EFAE78';ctx.beginPath();ctx.moveTo(0,2);ctx.lineTo(-2,0);ctx.lineTo(2,0);ctx.closePath();ctx.fill();ctx.restore();
}

function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath();
}

function getGameQuestion(){
  const isl=GAME_ISLANDS[GAME.islandIdx];let pool=[];
  if(isl.disc==='final'){
    for(const k in DISCS)for(const m of DISCS[k].mods)if(m.quiz?.length)pool.push(...m.quiz.filter(q=>q.q?.length>10));
  }else{
    for(const m of (DISCS[isl.disc]?.mods||[]))if(m.quiz?.length)pool.push(...m.quiz.filter(q=>q.q?.length>10));
  }
  if(!pool.length)return {q:'Capital do Brasil?',o:['São Paulo','Rio de Janeiro','Brasília','Salvador'],c:2,e:'Brasília.'};
  return pool[Math.floor(Math.random()*pool.length)];
}

function openQuestion(target,type){
  GAME.questionOpen=true;GAME.currentTarget={target,type};GAME.keys.left=GAME.keys.right=GAME.keys.jump=false;
  const q=getGameQuestion();GAME.currentQuestion=q;
  const head=document.getElementById('gqHead'),qEl=document.getElementById('gqQ'),opts=document.getElementById('gqOpts'),fb=document.getElementById('gqFeedback');
  fb.classList.remove('on');fb.innerHTML='';
