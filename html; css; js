.cat-action .ca-emoji{font-size:1.4rem}
.cat-action .cooldown{font-size:.66rem;color:var(--muted);font-weight:500}
.cat-speech{margin-top:14px;background:rgba(0,0,0,.35);border-radius:12px;padding:12px;text-align:center;font-size:.88rem;color:var(--text);min-height:44px;display:flex;align-items:center;justify-content:center;font-style:italic}
.fc-hero{background:linear-gradient(135deg,var(--surface),var(--primary));border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:22px}
.fc-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:16px}
.fc-stat{background:rgba(0,0,32,.5);border:1px solid var(--border);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}
.fc-stat::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--accent)}
.fc-stat .fc-icon{font-size:1.4rem}
.fc-stat .fc-val{font-size:1.5rem;font-weight:800;color:var(--accent-l);line-height:1}
.fc-stat .fc-lbl{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;font-weight:600}
.fc-stat.green::before{background:#2ea043}.fc-stat.green .fc-val{color:#A2CA8E}
.fc-stat.red::before{background:#dc3232}.fc-stat.red .fc-val{color:#ff8888}
