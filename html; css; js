      const hits=alive.map(a=>{let dmg=Math.max(1,Math.round(actor.atk*.72*(100/(100+a.def))));if(a.guard){dmg=Math.max(1,Math.round(dmg*.58));a.guard=0;}if(a.evade){if(Math.random()<.7){a.evade=0;log.push(`🌫️ ${a.name} esquiva do Pulso da Fratura.`);return 0;}a.evade=0;}a.hp-=dmg;return dmg;});
