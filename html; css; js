}
const AFK_FSM_LABELS={READY:'Pronto',ATTACK:'Ataque básico',SKILL:'Habilidade',SUPPORT:'Suporte',STUNNED:'Atordoado',DEFEATED:'Derrotado'};
function afkFSMDecide(actor,team,enemies,log){
  const previous=actor.fsmState||'READY'; let next='ATTACK',action='basic';
  if(actor.dead||actor.hp<=0){next='DEFEATED';action='none';}
  else if(actor.stunned>0){next='STUNNED';action='none';}
  else {
    const lowAlly=team.filter(a=>!a.dead).sort((a,b)=>(a.hp/a.maxHp)-(b.hp/b.maxHp))[0];
    if(actor.role==='Suporte' && actor.energy>=100 && lowAlly && lowAlly.hp/lowAlly.maxHp<.72){next='SUPPORT';action='skill';}
    else if(actor.energy>=100){next='SKILL';action='skill';}
    else {next='ATTACK';action='basic';}
  }
  actor.fsmState=next;
  if(previous!==next && log){log.push(`🤖 ${actor.name}: ${AFK_FSM_LABELS[previous]||previous} → ${AFK_FSM_LABELS[next]||next}.`);}
  return {state:next,action};
}
