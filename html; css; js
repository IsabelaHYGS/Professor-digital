function getCurrentUser(){
  try {
    const s = JSON.parse(pdStorage.getItem(SESSION_KEY));
    if (!s) return null;
    return loadUsers().find(u => u.username === s.username) || null;
  } catch { return null; }
}
function isAdmin(){ const u = getCurrentUser(); return u && u.username === 'adm'; }
function login(username, password){
  const normalizedUser = String(username || '').trim().toLowerCase();

  // O administrador padrão é uma conta fixa de teste da plataforma.
  // Mesmo que um localStorage antigo esteja inconsistente/corrompido,
  // adm / adm12 deve sempre conseguir entrar.
  if (normalizedUser === 'adm' && String(password || '') === 'adm12') {
    const users = loadUsers();
    let idx = users.findIndex(u => String(u.username || '').trim().toLowerCase() === 'adm');
    if (idx === -1) {
      users.push({username:'adm', password:'adm12', email:'admin@professordigital.local', avatar:'👑', bio:'Administrador da plataforma', createdAt:Date.now(), isAdmin:true});
      idx = users.length - 1;
    } else {
      users[idx].username = 'adm';
      users[idx].password = 'adm12';
      users[idx].isAdmin = true;
      users[idx].email = users[idx].email || 'admin@professordigital.local';
      users[idx].avatar = users[idx].avatar || '👑';
      users[idx].bio = users[idx].bio || 'Administrador da plataforma';
    }
    saveUsers(users);
    const admin = users[idx];
    pdStorage.setItem(SESSION_KEY, JSON.stringify({ username:'adm', loginAt:Date.now() }));
    return { ok:true, user:admin };
  }

  const users = loadUsers();
  const user = users.find(u => String(u.username || '').trim().toLowerCase() === normalizedUser && String(u.password || '') === String(password || ''));
  if (!user) return { ok:false, error:'Usuário ou senha inválidos' };
  pdStorage.setItem(SESSION_KEY, JSON.stringify({ username: user.username, loginAt: Date.now() }));
  return { ok:true, user };
}
function signup(username, password, confirm, email){
  if (!username || !password) return { ok:false, error:'Preencha todos os campos' };
  if (username.length < 3) return { ok:false, error:'Usuário precisa ter 3+ caracteres' };
  if (password.length < 4) return { ok:false, error:'Senha precisa ter 4+ caracteres' };
  if (password !== confirm) return { ok:false, error:'Senhas não coincidem' };
  if (username.toLowerCase() === 'adm') return { ok:false, error:'Nome reservado' };
  const users = loadUsers();
  if (users.find(u => u.username.toLowerCase() === username.toLowerCase())) return { ok:false, error:'Usuário já existe' };
  const user = {username, password, email:email||'', avatar:'🐱', bio:'', createdAt:Date.now(), isAdmin:false};
  users.push(user); saveUsers(users);
  pdStorage.setItem(SESSION_KEY, JSON.stringify({ username, loginAt: Date.now() }));
  return { ok:true, user };
}
function logout(){
  pdStorage.removeItem(SESSION_KEY);
