F10:[{"q":"Pela lei do deslocamento de Wien, λmaxT = constante. Para um corpo com temperatura próxima de 5800 K, como a do Sol, qual comprimento de onda está aproximadamente associado ao máximo de emissão?","o":["500 nm","2000 nm","50 nm","5000 nm"],"c":0,"e":"λmax ≈ 2,9×10⁻³/5800 ≈ 5×10⁻⁷ m = 500 nm."},{"q":"De acordo com a lei de Stefan-Boltzmann, a potência irradiada por unidade de área de um corpo negro é proporcional a qual potência da temperatura absoluta?","o":["T","T²","T³","T⁴"],"c":3,"e":"P/A = σT⁴."},{"q":"Se a temperatura absoluta de um corpo negro dobra, o que acontece com o comprimento de onda de máxima emissão segundo a lei de Wien?","o":["Dobra","Cai pela metade","Permanece igual","Fica quatro vezes maior"],"c":1,"e":"Como λmax é inversamente proporcional a T, dobrar T reduz λmax à metade."}],
