function setupSVGDraw(which){
  const container = which==='slides'
    ? document.querySelector('.slide-stage')
    : document.getElementById('presOverlay');
  if (!container) return;

  let svg = container.querySelector('.draw-layer');
  if (!svg){
    svg=document.createElementNS('http://www.w3.org/2000/svg','svg');
    svg.setAttribute('class','draw-layer');
    svg.setAttribute('aria-label','Camada de anotações');
    svg.style.position='absolute';
    svg.style.inset='0';
    svg.style.width='100%';
    svg.style.height='100%';
    svg.style.zIndex=which==='slides'?'20':'352';
    container.appendChild(svg);
  }

  const ds=drawStates[which] || (drawStates[which]={svg,drawing:false,currentPath:null,eraser:false});
  ds.svg=svg;

  if (ds.bound) {
    restoreInk(which);
    return;
  }
  ds.bound=true;

  const pointFromEvent = e => {
    const r=svg.getBoundingClientRect();
    return {
      x: Math.max(0,Math.min(100,((e.clientX-r.left)/Math.max(1,r.width))*100)),
      y: Math.max(0,Math.min(100,((e.clientY-r.top)/Math.max(1,r.height))*100))
    };
  };

  const finish = e => {
    const stateDraw=drawStates[which];
    if (!stateDraw) return;
    if (stateDraw.drawing && stateDraw.currentPath && which==='slides'){
      saveCurrentSlideInk();
    }
    stateDraw.drawing=false;
    stateDraw.currentPath=null;
    try { if (e && svg.hasPointerCapture(e.pointerId)) svg.releasePointerCapture(e.pointerId); } catch(err){}
  };

  svg.addEventListener('pointerdown', e => {
    if (!svg.classList.contains('on')) return;
    e.preventDefault();
    e.stopPropagation();

    const pt=pointFromEvent(e);
    const stateDraw=drawStates[which];

    if (stateDraw.eraser){
      const target=e.target;
      if (target && target.tagName && target.tagName.toLowerCase()==='path'){
        target.remove();
        if (which==='slides') saveCurrentSlideInk();
      }
      return;
    }

    const p=document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('stroke',penColors[which]);
    p.setAttribute('stroke-width',String(penWidths[which]));
    p.setAttribute('fill','none');
    p.setAttribute('stroke-linecap','round');
    p.setAttribute('stroke-linejoin','round');
    p.setAttribute('vector-effect','non-scaling-stroke');
    p.dataset.points=`${pt.x},${pt.y}`;
    p.setAttribute('d',`M ${pt.x} ${pt.y}`);
    svg.appendChild(p);

    stateDraw.currentPath=p;
    stateDraw.drawing=true;
    try { svg.setPointerCapture(e.pointerId); } catch(err){}
  });

  svg.addEventListener('pointermove', e => {
    const stateDraw=drawStates[which];
    if (!stateDraw?.drawing || !stateDraw.currentPath) return;
    e.preventDefault();
    const pt=pointFromEvent(e);
    stateDraw.currentPath.dataset.points += ` ${pt.x},${pt.y}`;
    stateDraw.currentPath.setAttribute(
      'd',
      'M '+stateDraw.currentPath.dataset.points.split(' ').join(' L ')
    );
  });

  svg.addEventListener('pointerup', finish);
  svg.addEventListener('pointercancel', finish);
  svg.addEventListener('lostpointercapture', () => {
    const stateDraw=drawStates[which];
    if (stateDraw) {
      if (stateDraw.drawing && stateDraw.currentPath && which==='slides') saveCurrentSlideInk();
      stateDraw.drawing=false;
      stateDraw.currentPath=null;
    }
  });

  restoreInk(which);
}

function saveCurrentSlideInk(){
  const svg=drawStates.slides?.svg;
  if (!svg) return;
  slideInk[slideIdx]=Array.from(svg.querySelectorAll('path')).map(p => ({
    d:p.getAttribute('d'),
    stroke:p.getAttribute('stroke'),
    width:p.getAttribute('stroke-width')
  }));
}

function restoreInk(which){
  const ds=drawStates[which];
  if (!ds?.svg) return;
  const svg=ds.svg;
  svg.querySelectorAll('path').forEach(p=>p.remove());
  if (which!=='slides') return;
  (slideInk[slideIdx]||[]).forEach(item=>{
    const p=document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d',item.d);
    p.setAttribute('stroke',item.stroke);
    p.setAttribute('stroke-width',item.width);
    p.setAttribute('fill','none');
    p.setAttribute('stroke-linecap','round');
    p.setAttribute('stroke-linejoin','round');
    p.setAttribute('vector-effect','non-scaling-stroke');
    svg.appendChild(p);
  });
}

function stopDrawing(which){
  const ds=drawStates[which];
  if (!ds) return;
  if (which==='slides') saveCurrentSlideInk();
  ds.drawing=false;
  ds.currentPath=null;
}

function togglePen(which){
  const c=which==='slides'
    ? document.querySelector('.slide-stage')
    : document.getElementById('presOverlay');
  if (!c) return;
  const svg=c.querySelector('.draw-layer');
  const btn=document.getElementById(which==='slides'?'slidePenBtn':'presPenBtn');
  if (!svg||!btn) {
    setupSVGDraw(which);
    setTimeout(()=>togglePen(which),0);
    return;
  }
  const on=svg.classList.toggle('on');
  if (on){
    const ds=drawStates[which];
    if (ds) ds.eraser=false;
    document.getElementById(which==='slides'?'slideEraseBtn':'presEraseBtn')?.classList.remove('on');
  }
  btn.classList.toggle('on',on);
  toast(on?'✏️ Caneta ativada — agora você pode rabiscar':'Caneta desativada');
}

function toggleEraser(which){
  const c=which==='slides'
    ? document.querySelector('.slide-stage')
    : document.getElementById('presOverlay');
  const svg=c?.querySelector('.draw-layer');
  if (!svg) return;
  const ds=drawStates[which];
  ds.eraser=!ds.eraser;
  svg.classList.add('on');
  document.getElementById(which==='slides'?'slidePenBtn':'presPenBtn')?.classList.toggle('on',!ds.eraser);
  document.getElementById(which==='slides'?'slideEraseBtn':'presEraseBtn')?.classList.toggle('on',ds.eraser);
  toast(ds.eraser?'🧽 Borracha: clique no rabisco para apagar':'✏️ Caneta: desenhe normalmente');
}

function setPenColor(btn,color,which){
  const tb=btn.closest('.pres-toolbar, .slide-tools');
  tb?.querySelectorAll('.color-dot').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  penColors[which]=color;
  if (drawStates[which]) drawStates[which].eraser=false;
  document.getElementById(which==='slides'?'slidePenBtn':'presPenBtn')?.classList.add('on');
  document.getElementById(which==='slides'?'slideEraseBtn':'presEraseBtn')?.classList.remove('on');
}

function setPenWidth(width,which){
  penWidths[which]=width;
  if (drawStates[which]) drawStates[which].eraser=false;
  document.getElementById(which==='slides'?'slidePenBtn':'presPenBtn')?.classList.add('on');
  toast('Espessura do traço: '+width+' px');
}

function clearDraw(which){
  const c=which==='slides'
    ? document.querySelector('.slide-stage')
    : document.getElementById('presOverlay');
  const svg=c?.querySelector('.draw-layer');
  if (!svg) return;
  svg.querySelectorAll('path').forEach(p=>p.remove());
  if (which==='slides') slideInk[slideIdx]=[];
  toast('Anotações apagadas');
}


