  const routes=p.complete?`<section class="afk-book-endmatter"><div class="afk-book-end-kicker">FIM DA JORNADA</div><h3>⚖️ As três rotas</h3><p>As páginas finais agora pertencem ao leitor. Escolha uma rota para reler a consequência correspondente.</p><div class="afk-book-route-grid">${AFK_BOOK.routes.map((r,i)=>`<button class="afk-book-route-card" onclick="afkBookOpen('route',${i})"><span>${['🌑','🌿','📚'][i]}</span><strong>${r.title.replace(/^ROTA [ABC] — /,'Rota $1 — ')}</strong><small>Revelar esta rota</small></button>`).join('')}</div><button class="afk-book-epilogue" onclick="afkBookOpen('epilogue')">📖 Ler o epílogo</button></section>`:'';
  return `<section class="afk-panel afk-book-panel">
