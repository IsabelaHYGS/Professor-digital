function heatmapSVG(days=30){
  const cells=[]; const today = new Date(); const stats = loadStats();
  for (let i=days-1;i>=0;i--){ const d = new Date(today); d.setDate(d.getDate()-i); const k = d.toISOString().slice(0,10); const sec = (stats.timeSpent||{})[k]||0; let lvl = 0; if (sec>0&&sec<300) lvl=1; else if (sec<900) lvl=sec>0?2:0; else if (sec<1800) lvl=3; else if (sec>=1800) lvl=4; cells.push({k, sec, lvl}); }
  let html = '<div class="heatmap">';
  for (const c of cells){ const lbl = c.sec>0 ? `${c.k}: ${fmtTime(c.sec)}` : `${c.k}: sem estudo`; html += `<div class="heat-cell ${c.lvl>0?'lvl'+c.lvl:''}" title="${lbl}"></div>`; }
  html += '</div>';
  return html;
}
function lineChartSVG(){
  const days=14; const s = loadStats(); const hist = s.history||{};
  const points=[]; const today = new Date();
  for (let i=days-1;i>=0;i--){ const d = new Date(today); d.setDate(d.getDate()-i); const k = d.toISOString().slice(0,10); const h = hist[k]||{}; points.push({date:k.slice(5), accuracy:h.quizTotal>0?h.quizCorrect/h.quizTotal:null, time:(h.time||0)/60}); }
  const W=460,H=240,pad=44,right=20,bottom=34,top=20; const innerW = W-pad-right, innerH = H-top-bottom;
  const has = points.some(p => p.time > 0 || p.accuracy !== null);
  if (!has) return `<div style="text-align:center;padding:30px 20px;color:var(--muted);font-size:.88rem">📉 Sem dados ainda.</div>`;
  const maxTime = Math.max(30, ...points.map(p => p.time));
  let svg = `<svg viewBox="0 0 ${W} ${H}">`;
  for (let i=0;i<=4;i++){ const y = top+(i/4)*innerH; svg += `<line x1="${pad}" y1="${y}" x2="${W-right}" y2="${y}" stroke="rgba(255,204,80,.12)"/><text x="${pad-6}" y="${y+4}" fill="#2F5F5A" font-size="9" text-anchor="end">${100-i*25}%</text><text x="${W-right+4}" y="${y+4}" fill="#1466C3" font-size="9">${Math.round(maxTime-i*(maxTime/4))}m</text>`; }
  let tp=''; points.forEach((p,i)=>{ const x = pad+(i/(days-1))*innerW; const y = top+(1-p.time/maxTime)*innerH; tp += (i===0?'M':'L')+` ${x.toFixed(1)} ${y.toFixed(1)} `; });
  svg += `<path d="${tp}" fill="none" stroke="#1466C3" stroke-width="2" stroke-dasharray="4 3" opacity="0.7"/>`;
  let segs=[],cur=[]; points.forEach((p,i)=>{ if (p.accuracy !== null){ cur.push({x:pad+(i/(days-1))*innerW, y:top+(1-p.accuracy)*innerH}); } else if (cur.length){ segs.push(cur); cur=[]; } }); if (cur.length) segs.push(cur);
  for (const seg of segs){ if (seg.length===1) svg += `<circle cx="${seg[0].x}" cy="${seg[0].y}" r="4" fill="#EFAE78"/>`; else { const d = seg.map((pt,i)=>(i===0?'M':'L')+` ${pt.x.toFixed(1)} ${pt.y.toFixed(1)} `).join(''); svg += `<path d="${d}" fill="none" stroke="#EFAE78" stroke-width="2.5"/>`; for (const pt of seg) svg += `<circle cx="${pt.x.toFixed(1)}" cy="${pt.y.toFixed(1)}" r="3.5" fill="#EFAE78"/>`; } }
  points.forEach((p,i)=>{ if (i%2===0) svg += `<text x="${pad+(i/(days-1))*innerW}" y="${H-12}" fill="#2F5F5A" font-size="9" text-anchor="middle">${p.date}</text>`; });
  return svg + '</svg>';
}

/* ============ NAV / RENDER ============ */
function renderNav(){
  const nav = document.getElementById('nav'); if (!nav) return;
  const user = getCurrentUser();
  if (!user){ nav.innerHTML = ''; return; }
  const items = [['home','Início'],['fisica','Física'],['biologia','Biologia'],['quimica','Química'],['robotica','Robótica'],['flashcards','🃏 Flashcards'],['game','🎮 Games'],['afk','⚔️ Crônicas'],['progress','📊 Progresso']];
  const navHTML = items.map(([k,t]) => `<button class="${state.view===k?'active':''}" onclick="nav('${k}')">${t}</button>`).join('');
  const isAdm = user.username === 'adm';
  const chip = `<div class="user-chip" onclick="toggleUserMenu(event)"><div class="avatar">${user.avatar || '🐱'}</div><span class="name">${user.username}</span>${isAdm?'<span class="admin-tag">👑</span>':''}</div>`;
  nav.innerHTML = navHTML + chip;
}
function nav(v){
  state.view = v;
  state.disc = (v==='home'||v==='game'||v==='afk'||v==='progress'||v==='flashcards'||v==='profile') ? null : v;
  state.mod = null;
  document.getElementById('userMenu')?.classList.remove('open');
  hideViz(); render(); window.scrollTo({top:0,behavior:'smooth'});
}
function goHome(){ state.view='home'; state.disc=null; state.mod=null; hideViz(); render(); }
function openDisc(d){ state.view=d; state.disc=d; state.mod=null; hideViz(); render(); }
function openMod(m){
  state.mod = m; state.sec = 1; state.view = 'modulo';
  if (!state.steps[m.id]) state.steps[m.id] = new Array(13).fill(false);
  state.viz = {active:false, viz:m.viz, params:defParams(m.viz)};
  const s = loadStats();
  const before = new Set(s.achievements || []);
  s.achievements = evaluateAchievements(s);
  const added = s.achievements.filter(a => !before.has(a));
  saveStats(s); added.forEach(id => queueAchievementNotif(id));
  render(); window.scrollTo({top:0,behavior:'smooth'});
  setTimeout(() => { updateProfPanel(); carregarNotas(); }, 80);
}
function openSec(n){ state.sec = n; if (state.mod) state.steps[state.mod.id][n-1] = true; render(); setTimeout(updateProfPanel, 60); }

function render(){
  const user = getCurrentUser();
  if (!user){
    renderAuthScreen('login');
    renderNav();
    return;
  }
  hideAuthScreen();
  renderNav();
  const app = document.getElementById('app'); if (!app) return;
  if (state.view === 'home') app.innerHTML = viewHome();
  else if (state.view === 'modulo') renderMod();
  else if (state.view === 'game') renderGameHub();
  else if (state.view === 'afk') renderAFKHub();
  else if (state.view === 'progress') renderProgress();
  else if (state.view === 'flashcards') renderFlashcards();
  else if (state.view === 'profile') renderProfile();
  else app.innerHTML = viewDisc(state.view);
  if (state.view !== 'modulo') hideViz();
}

