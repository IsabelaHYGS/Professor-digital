}
function afkTeamSynergies(d){
  const ids=Array.isArray(d.team)?d.team.filter(Boolean):[]; const out=[];
  for(let i=0;i<ids.length;i++) for(let j=i+1;j<ids.length;j++){
    const a=ids[i],b=ids[j], pool=AFK_SYNERGY_LINES[a+'+'+b]||AFK_SYNERGY_LINES[b+'+'+a];
    if(!Array.isArray(pool)||!pool.length) continue;
    const ha=afkHero(a),hb=afkHero(b); if(!ha||!hb) continue;
    const av=((Number(d.affinity?.[a])||0)+(Number(d.affinity?.[b])||0))/2;
    const strength=.03 + Math.min(100,Math.max(0,av))*.0003;
