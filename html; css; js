    if(!force && Math.random()>0.32)return;
    const lineSet=banterPool.shift();
    if(!lineSet)return;
    log.push('💬 '+lineSet.join(' / ')); banterUsed++;
  };
  addBanter(true);
  while(rounds<24&&team.some(a=>!a.dead)&&enemies.some(e=>!e.dead)){
    rounds++; if(isBoss&&rounds>1&&rounds%3===1){enemies.forEach(e=>{if(!e.dead&&e.isBoss)e.shield=1;});log.push('🛡️ O chefe ergueu um escudo: o próximo ataque recebido terá dano reduzido.');}
    const order=[...team.filter(a=>!a.dead),...enemies.filter(e=>!e.dead)].sort((a,b)=>b.spd-a.spd||Math.random()-.5);
    let actions=0;
    for(const actor of order){if(actor.dead)continue;if(actor.stunned>0){actor.stunned--;log.push(`💫 ${actor.name} perde a vez.`);continue;}
      const isHero=team.includes(actor);if(isHero){const fsm=afkFSMDecide(actor,team,enemies,log);if(fsm.action==='skill')afkSkill(actor,team,enemies,log);else if(fsm.action==='basic')afkBasicAttack(actor,team,enemies,log);} else afkEnemyAttack(actor,team,log); actions++;
      team.forEach(a=>{if(a.hp<=0&&!a.dead){a.dead=true;a.hp=0;log.push(`💀 ${a.name} caiu.`);}});enemies.forEach(e=>{if(e.hp<=0&&!e.dead){e.dead=true;e.hp=0;log.push(`💥 ${e.name} foi derrotado.`);}});
      enemies.forEach(e=>{if(e.marked>0)e.marked--;});
      if(!team.some(a=>!a.dead)||!enemies.some(e=>!e.dead))break;
    }
    const aliveT=team.filter(a=>!a.dead),aliveE=enemies.filter(e=>!e.dead);log.push(`🔄 Rodada ${rounds} concluída — seu time: ${aliveT.length}/${team.length} vivos · inimigos: ${aliveE.length}/${enemies.length} vivos.`);
    if(aliveT.length>1 && aliveE.length && rounds<24) addBanter(false);
  }
  const win=enemies.every(e=>e.dead)&&team.some(a=>!a.dead);d.log=d.log||[];d.battleStats=d.battleStats||{wins:0,losses:0};
  if(win){const wonStage=d.stage;const coins=90+d.stage*28,essence=24+d.stage*7,xp=35+d.stage*8;d.coins+=coins;d.essence+=essence;afkStoryUnlockForStage(d,wonStage);d.stage++;d.team.forEach(id=>{if(d.heroes[id]){d.heroes[id].xp+=xp;afkGainAffinity(d,id,2,'vitória');}});d.battleStats.wins++;d.lastBattle={win:true,rounds,stage:d.stage-1,teamPower:battleTeamPower,enemyPower:battleEnemyPower,at:new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})};d.log.unshift(`<span class="win">✔ Vitória em ${rounds} rodadas — +${coins} 🪙 +${essence} 💧 +${xp} XP de combate.</span>`);}
  else {d.battleStats.losses++;d.lastBattle={win:false,rounds,stage:d.stage,teamPower:battleTeamPower,enemyPower:battleEnemyPower,at:new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})};d.log.unshift(`<span class="loss">✘ Derrota após ${rounds} rodadas. Reorganize o time ou fortaleça os heróis.</span>`);}
  d.log=d.log.slice(0,12);afkSave(d);afkShowBattleModal({win,rounds,team,enemies,log:log.slice(-34),stage:d.stage-(win?1:0),teamPower:battleTeamPower,enemyPower:battleEnemyPower});renderAFKHub();
}
function afkShowBattleModal(result){
  let el=document.getElementById('afkBattleModal');
  if(!el){el=document.createElement('div');el.id='afkBattleModal';el.className='afk-modal';document.body.appendChild(el);}
  const hpBar=(a)=>{const pct=Math.max(0,Math.min(100,Math.round((Math.max(0,a.hp)/Math.max(1,a.maxHp))*100)));return `<div class="afk-combat-hp"><span style="width:${pct}%"></span></div><div class="afk-combat-hptext">${Math.max(0,Math.round(a.hp))} / ${Math.round(a.maxHp)} PV</div>`;};
  const icon=(a,isEnemy)=>isEnemy?(a.isBoss?'👑':'👹'):(a.dead?'💀':'🧙');
  const card=(a,isEnemy)=>`<div class="afk-combatant ${a.dead?'fallen':''} ${a.isBoss?'boss':''}"><div class="afk-combatant-top"><div class="afk-combatant-icon">${icon(a,isEnemy)}</div><div class="afk-combatant-info"><strong>${a.name}</strong><span>${a.role||'Inimigo'} · ${a.position==='front'?'Frente':'Retaguarda'}</span></div>${a.shield?'<span class="afk-status-badge">🛡️ Escudo</span>':''}${!isEnemy&&a.fsmState?`<span class="afk-status-badge">◉ ${AFK_FSM_LABELS[a.fsmState]||a.fsmState}</span>`:''}</div>${hpBar(a)}<div class="afk-combatant-stats"><span>⚔️ ${Math.round(a.atk||0)}</span><span>🛡️ ${Math.round(a.def||0)}</span><span>⚡ ${Math.round(a.spd||0)}</span>${a.energy!=null?`<span>🔋 ${Math.round(a.energy)}%</span>`:''}</div></div>`;
  const rounds=(result.log||[]).filter(x=>x.includes('Rodada ')&&x.includes('concluída'));
  const dialogues=(result.log||[]).filter(x=>x.startsWith('💬'));
  const actions=(result.log||[]).filter(x=>!x.includes('Rodada ')||!x.includes('concluída')).filter(x=>!x.startsWith('💬')).slice(-28);
  const actionHtml=actions.map((x,i)=>`<div class="afk-combat-action"><span class="action-index">${i+1}</span><span>${x}</span></div>`).join('')||'<div class="afk-combat-action">Nenhuma ação registrada.</div>';
  const dialogueHtml=dialogues.map(x=>`<div class="afk-combat-action" style="background:rgba(139,92,246,.08);border-color:rgba(139,92,246,.22)"><span class="action-index">💬</span><span>${x.replace(/^💬 /,'')}</span></div>`).join('')||'<div class="afk-combat-action">Os heróis ficaram concentrados na luta desta vez.</div>';
  const roundHtml=rounds.map((x,i)=>`<div class="afk-round-row"><span>⚔️ ${i+1}</span><span>${x.replace(/.*Rodada /,'Rodada ')}</span></div>`).join('')||'<div class="afk-round-row">A batalha terminou antes de registrar rodadas.</div>';
  el.innerHTML=`<div class="afk-modal-box afk-battle-modal-box"><div class="afk-battle-modal-head"><div><div class="step-label">⚔️ CRÔNICAS DO SABER · COMBATE</div><h2 style="margin:0">${result.win?'🏆 Vitória!':'💀 Derrota'}</h2><p class="afk-battle-subtitle">Estágio ${result.stage} · ${result.rounds} rodadas · ${result.win?'Todos os inimigos foram derrotados.':'Seu grupo não conseguiu eliminar todos os inimigos.'}</p></div><button class="btn" onclick="document.getElementById('afkBattleModal')?.classList.remove('open')">×</button></div>
  <div class="afk-combat-score"><div><span>Seu poder</span><strong>${Math.round(result.teamPower)}</strong></div><div class="vs">VS</div><div><span>Poder inimigo</span><strong>${Math.round(result.enemyPower)}</strong></div></div>
  <div class="afk-combat-arena"><section><div class="afk-combat-side-title">🛡️ SEU GRUPO <span>${result.team.filter(a=>!a.dead).length}/${result.team.length} vivos</span></div>${result.team.map(a=>card(a,false)).join('')}</section><div class="afk-combat-divider">⚔️</div><section><div class="afk-combat-side-title enemy">👹 INIMIGOS <span>${result.enemies.filter(a=>!a.dead).length}/${result.enemies.length} vivos</span></div>${result.enemies.map(a=>card(a,true)).join('')}</section></div>
  <div class="afk-combat-panels"><div class="info-box"><strong>📊 Resumo por rodada</strong><div class="afk-round-list">${roundHtml}</div></div><div class="info-box"><strong>📜 Últimas ações</strong><div class="afk-action-list">${actionHtml}</div></div></div>
  <div class="info-box" style="margin-top:12px"><strong>💬 Conversas durante a luta</strong><div style="font-size:.68rem;color:var(--muted);margin:3px 0 8px">Os diálogos variam conforme a formação e são sorteados sem repetir a mesma fala nesta batalha.</div><div class="afk-action-list">${dialogueHtml}</div></div>
  <div class="afk-battle-explain">💡 <strong>Como ler o combate:</strong> ⚔️ ataque · 🛡️ defesa · ⚡ velocidade · 🔋 energia. Quando a energia chega a 100%, o herói usa a habilidade ativa automaticamente. Escudos reduzem o próximo dano recebido.</div>
  <div class="afk-actions" style="justify-content:flex-end;margin-top:14px"><button class="btn primary" onclick="document.getElementById('afkBattleModal')?.classList.remove('open')">Continuar</button></div></div>`;
  el.classList.add('open');
}

function afkSummon(n=1){const d=afkLoad(),cost=n===10?2700:300;if(!isAdmin()&&d.essence<cost){toast('💧 Essência insuficiente.');return;}if(!isAdmin())d.essence-=cost;const results=[];for(let k=0;k<n;k++){let roll=Math.random(),id;if(roll<.03||d.pity>=29){const locked=AFK_HEROES.filter(h=>!d.heroes[h.id].unlocked);id=(locked.length?locked:AFK_HEROES)[Math.floor(Math.random()*Math.max(1,locked.length||AFK_HEROES.length))].id;d.pity=0;}else{id=AFK_HEROES[Math.floor(Math.random()*AFK_HEROES.length)].id;d.pity++;}const x=d.heroes[id];if(x.unlocked){x.fragments=(x.fragments||0)+30;d.fragments+=30;results.push({id,dup:true});}else{x.unlocked=true;results.push({id,dup:false});}}afkSave(d);document.getElementById('afkSummonModal').classList.add('open');document.getElementById('afkSummonTitle').textContent=n===10?'✨ Invocação x10':'✨ Invocação';document.getElementById('afkSummonText').textContent=`${n} resultado${n>1?'s':''}. Pity atual: ${d.pity}/30.`;document.getElementById('afkSummonResults').innerHTML=results.map(r=>{const h=afkHero(r.id);return `<div class="afk-result-card"><div class="afk-hero-art afk-image-art" style="height:130px">${afkHeroSVG(h)}</div><strong>${h.name}</strong><span>${r.dup?'Duplicado · +30 fragmentos':'Novo herói · '+h.rarity}</span></div>`}).join('');}
function closeAFKModal(){document.getElementById('afkSummonModal')?.classList.remove('open');renderAFKHub();}

function renderAFKMap(d){
  const names=['Portão de Pedra-Negra','Minas de Ferro','Ruínas de Arcanum','Vulcão Gêmeo','Cidade Subterrânea','Gueto das Sombras','Santuário da Fratura'];
  const icons=['🏰','⛏️','📜','🌋','🕳️','🌆','🌀'];
  const region=Math.min(names.length-1,Math.floor((Math.max(1,d.stage)-1)/10));
  const start=region*10+1,end=start+9;
  const pct=Math.min(100,Math.round(((Math.min(d.stage,end)-start+1)/10)*100));
  let nodes='';
  for(let i=0;i<10;i++){
    const st=start+i,done=st<d.stage,current=st===d.stage,boss=st%10===0,locked=st>d.stage;
    const action=locked?'':`onclick="afkMapGo(${st})"`;
    nodes+=`<div class="afk-map-node ${done?'done':''} ${current?'current':''} ${boss?'boss':''} ${locked?'locked':''}" ${action}><div class="afk-map-icon">${boss?'👑':done?'✓':current?'⚔️':'🔒'}</div><div class="afk-map-stage">Estágio ${st}</div><div class="afk-map-small">${boss?'Marco do Guardião':done?'Concluído':current?'Batalha atual':'Bloqueado'}</div>${boss?'<div class="afk-map-reward">🎁 Recompensa de marco</div>':''}</div>`;
  }
  return `<section class="afk-panel"><div class="step-label">🗺️ CAMPANHA</div><h2 style="margin-top:4px">Mapa das Crônicas</h2><div class="sub">Avance pelos estágios, encontre marcos e enfrente um Guardião da Fratura a cada 10 etapas.</div><div class="afk-map-current"><strong>📍 Você está em:</strong> ${names[region]} · estágio ${d.stage}<br><span style="color:var(--muted)">${d.stage%10===0?'👑 Marco de chefe alcançado.':'Próximo marco: estágio '+(Math.floor((d.stage-1)/10)*10+10)}</span></div><div class="afk-map-progress"><span style="width:${pct}%"></span></div><div class="afk-map-small">Progresso da região: ${pct}% · Estágios ${start}–${end}</div><div class="afk-map"><div class="afk-map-region"><h3>${icons[region]} ${names[region]}</h3><div class="afk-map-small">Região atual · os estágios vencidos ficam registrados no caminho.</div><div class="afk-map-track">${nodes}</div></div>${region<names.length-1?`<div class="afk-map-region"><h3>🔒 Próxima região: ${names[region+1]}</h3><div class="afk-map-small">Desbloqueie ao concluir o estágio ${end}.</div></div>`:''}</div><div class="afk-map-legend"><span>⚔️ Atual</span><span>✓ Concluído</span><span>👑 Chefe</span><span>🔒 Bloqueado</span></div><div class="afk-actions" style="margin-top:14px"><button class="btn primary" onclick="afkBattle()" ${window.afkBattleRunning?'disabled':''}>${window.afkBattleRunning?'⚔️ Batalha em andamento...':'⚔️ Lutar estágio '+d.stage}</button><button class="btn" onclick="afkSetTab('formacao')">⚔️ Ajustar formação</button><button class="btn" onclick="afkSetTab('expedicao')">🌙 Voltar à expedição</button></div></section>`;
}

function afkMapGo(stage){const d=afkGet();if(Number(stage)!==Number(d.stage)){if(Number(stage)<Number(d.stage)){d.stage=Number(stage);afkSave(d);}else{return;} }afkSetTab('expedicao');renderAFKHub();}

const AFK_BOOK = {"title":"Crônicas do Saber","subtitle":"Livro I — O Livro do Esquecimento","prologue":{"title":"PRÓLOGO — O NOME QUE NINGUÉM LEMBRA","html":"<p>Houve um tempo em que o mundo tinha nome.</p>\n<p>Não era um nome bonito. Não era um nome que se escrevia em poemas. Era um nome que se dizia baixinho, antes de dormir, como se diz o nome de uma mãe ou de uma casa. Um nome que existia porque alguém, em algum lugar, tinha decidido que aquilo precisava ser chamado de alguma coisa.</p>\n<p>Ninguém mais lembra qual era.</p>\n<p>O esquecimento começou devagar, como todas as coisas terríveis. Primeiro, as pessoas esqueceram os nomes das ruas. Depois esqueceram os nomes dos vizinhos. Depois esqueceram os nomes dos filhos mais novos. Depois esqueceram que tinham filhos. Depois esqueceram que tinham tido filhos. Depois esqueceram que tinham tido algo.</p>\n<p>E então sumiram.</p>\n<p>Não morreram — morrer deixa corpo, deixa lápide, deixa lembrança. <strong>Sumiram.</strong> Como uma vela que se apaga sem fumaça. Como uma palavra que estava na ponta da língua e nunca mais volta. Como uma pessoa que você jurava conhecer e agora não sabe se existiu.</p>\n<p>As cidades ficaram menores. Depois ficaram menores de novo. Depois ficaram só ruas vazias e casas fechadas e camas arrumadas onde ninguém dorme.</p>\n<p>E ninguém chorou.</p>\n<p>Porque ninguém lembrava de quem teria que ser chorado.</p>\n<hr>\n<p>A isso, deram o nome de <strong>Fratura</strong>.</p>\n<p>Uma rachadura no ar. Como se o mundo fosse vidro e alguém tivesse batido com muita força. Através dela, pode-se ver uma luz que não é luz, um silêncio que não é silêncio, uma coisa que não tem nome e que não se pode olhar por muito tempo.</p>\n<p>Quem entra, esquece. Quem olha demais, esquece também. Quem mora perto, começa a esquecer as coisas pequenas primeiro — o nome do cachorro, o sabor do pão, o rosto do filho. Depois esquece as coisas grandes. Depois esquece de si.</p>\n<p>E então some.</p>\n<p>Isso começou há muito tempo. Não se sabe quando exatamente — os registros foram apagados. Mas há uma lenda. Uma lenda que ninguém mais conta, porque ninguém mais lembra dela.</p>\n<p>A lenda diz que a Fratura não nasceu de uma guerra. Não nasceu de um deus irritado. Não nasceu de um cataclismo. Não nasceu de nada que valha a pena contar em histórias de heroísmo.</p>\n<p>A Fratura nasceu de um <strong>contrato</strong>.</p>\n<p>E o contrato foi assinado por um homem chamado <strong>Erwin Schrödinger</strong>.</p>\n<p>E quem escreveu o contrato... ainda está vivo.</p>\n<p>Ele tem 300 anos. Ele tem chifres. Ele tem asas negras que ele esconde sob um terno formal. Ele tem um gato chamado Kira que existe em todas as realidades ao mesmo tempo. E ele tem uma culpa que ele carrega há três séculos, como um homem carrega uma pedra no sapato — sem poder parar para tirá-la, sem poder esquecer que ela está ali.</p>\n<p>O nome dele é <strong>Lucien</strong>.</p>\n<p>E ele ainda não sabe que vai morrer.</p>\n<p>Ou melhor: ele sabe. Ele só não sabe quando.</p>\n<p>Ou melhor ainda: ele sabe quando. Ele só não sabe que ainda tem tempo de mudar de ideia.</p>\n<hr>"},"chapters":[{"n":1,"title":"O Bilhete","part":"PARTE UM — O DESPERTAR","html":"<p>O Arquivo Central estava vazio há três semanas.</p>\n<p>Não é um lugar que costuma ficar vazio. O Arquivo Central é uma biblioteca-viva, feita de estantes que crescem sozinhas e livros que escrevem a si mesmos. É onde a memória do mundo é guardada. É onde as pessoas vão quando esquecem algo importante. É onde as histórias dormem.</p>\n<p>Mas há três semanas, ninguém entra. Ninguém sai. Ninguém atende.</p>\n<p>E há três semanas, sobre a mesa principal do salão de leitura, há um bilhete.</p>\n<p>O bilhete é curto. A letra é firme, mas tremida — como se a mão que escreveu estivesse cansada. Ou assustada. Ou as duas coisas ao mesmo tempo.</p>\n<p>Diz assim:</p>\n<blockquote><em>\"Se alguém encontrar isto, é porque eu falhei.</em>  <em>Procure os oito. Eles ainda lembram de si.</em>  <em>Ainda.</em>  <em>Mas não sei por quanto tempo.</em>  <em>E não sei o que fazer se eles esquecerem.</em>  <em>Desculpe.\"</em></blockquote>\n<p>Não tem assinatura.</p>\n<p>O bilhete foi encontrado por uma pessoa que não sabia o que estava procurando. Uma pessoa sem nome, sem rosto, sem história. Alguém que entrou no Arquivo por acaso — porque a porta estava aberta, porque a chuva estava forte, porque estava fugindo de alguma coisa.</p>\n<p>Essa pessoa é você.</p>\n<p>E você acabou de ler o bilhete.</p>\n<p>E pela primeira vez em três semanas, o Arquivo Central <strong>respira</strong>.</p>\n<p>As estantes estalam. Os livros sussurram. Uma vela acende sozinha, no canto, como se alguém tivesse acabado de entrar.</p>\n<p>Você não sabe o que fazer. Você não sabe para onde ir. Você não sabe quem são os oito, nem onde encontrá-los, nem por que um bilhete sem assinatura mudaria alguma coisa na sua vida.</p>\n<p>Mas você sente — no fundo do peito, no lugar onde as coisas importantes acontecem antes de serem pensadas — que esse bilhete foi escrito <strong>para você</strong>.</p>\n<p>E você está certo.</p>\n<hr>"},{"n":2,"title":"A Mulher Que Não Corria","part":"PARTE UM — O DESPERTAR","html":"<p>A primeira coisa que você vê quando sai do Arquivo é uma cidade que não existe mais.</p>\n<p>Você não sabe disso ainda. Você acha que é uma cidade normal, com ruas normais, pessoas normais. Mas as pessoas estão andando com o olhar perdido. Algumas param no meio da rua e olham para as mãos, como se não soubessem para que servem. Outras choram sem motivo. Outras riem sem motivo. Outras simplesmente param, no meio da calçada, e ficam olhando para um ponto no ar por minutos a fio, como se estivessem esperando uma resposta que nunca vem.</p>\n<p>Você não entende. Ainda.</p>\n<p>Você caminha. A chuva continua. Você não sabe para onde está indo. O bilhete está no seu bolso. As palavras do bilhete estão na sua cabeça. <em>Procure os oito.</em></p>\n<p>Você não sabe quem são os oito.</p>\n<p>Você continua andando. E depois de algumas horas, você chega a uma cidade destruída.</p>\n<p>Não é uma cidade grande. É uma cidade pequena, com casas de pedra e uma praça central e um portão de madeira que já foi bonito. Agora o portão está quebrado. Metade dele está no chão. A outra metade ainda está de pé, mas torta, como se alguém tivesse tentado arrancar e desistido no meio.</p>\n<p>E na frente do portão, parada, há uma mulher.</p>\n<p>Ela é alta. Mais alta que qualquer mulher que você já viu. Os ombros dela são largos, os braços são grossos, a postura é reta como uma coluna de pedra. Ela usa uma armadura de placas, prateada com detalhes em dourado, e nas costas carrega um escudo enorme — retangular, quase da altura dela, com o relevo de um leão rampante no centro. Na mão direita, um machado de guerra. Na mão esquerda, nada. Porque a mão esquerda está apoiada no portão quebrado, como se estivesse segurando.</p>\n<p>Ela não se move. Você fica olhando por um tempo. Ela não se move. Você se aproxima. Ela não se move.</p>\n<p>Você está a três passos dela quando ela finalmente fala. Sem se virar. Sem mudar a postura. Sem levantar a voz.</p>\n<p>— Você não sabe quem eu sou — diz ela. — Eu também não sei quem você é. Vamos fingir que sabemos e seguir.</p>\n<p>Você para. Ela continua sem se virar.</p>\n<p>— Meu nome é Valda. Eu era capitã da guarda desta cidade.</p>\n<p>Ela faz uma pausa.</p>\n<p>— Desta cidade que ninguém mais lembra o nome. Desta cidade que eu segurei sozinha por três dias, enquanto os civis evacuavam. Desta cidade que eu não consegui salvar.</p>\n<p>Ela finalmente se vira. Os olhos dela são escuros, cansados, e têm uma coisa que você não sabe nomear. Uma coisa que não é tristeza. Uma coisa que não é raiva. Uma coisa que é as duas, misturadas, e endurecidas, e presas dentro de um peito que aprendeu a não chorar.</p>\n<p>— Você tem cara de quem carrega um bilhete — diz ela.</p>\n<p>Você tira o bilhete do bolso. Ela lê. Devagar. Quando termina, ela fecha os olhos por um segundo.</p>\n<p>— Eu conheço essa letra — diz ela. — É do guardião do Arquivo.</p>\n<p>— Você o conhece?</p>\n<p>— Conhecia.</p>\n<p>Ela abre os olhos.</p>\n<p>— Agora ninguém conhece. Ninguém lembra dele. Isso é o que a Fratura faz. Ela apaga as pessoas e depois apaga a lembrança das pessoas. É como um incêndio que apaga a própria fumaça.</p>\n<p>Ela estende a mão. Você hesita. Ela espera. Você aperta a mão dela. A mão dela é quente e áspera e firme.</p>\n<p>— Eu vou com você — diz ela. — Mas com uma condição.</p>\n<p>— Qual?</p>\n<p>— Se você me pedir pra largar esta cidade, eu largo você primeiro.</p>\n<p>Você concorda. Ela solta sua mão. Olha para o portão quebrado uma última vez. E depois vira as costas para ele e começa a andar.</p>\n<p>Você a segue. Você não sabe para onde está indo. Você não sabe o que está fazendo. Você só sabe que tem um bilhete no bolso e uma mulher estranha ao seu lado e um mundo que está esquecendo de si mesmo.</p>\n<p>E é o suficiente. Por enquanto.</p>\n<hr>\n<p><strong>O PASSADO DE VALDA</strong></p>\n<p>Ela não conta isso pra você. Não ainda. Mas enquanto vocês caminham, você percebe coisas.</p>\n<p>Você percebe que ela não dorme. Ou finge não dormir. Todas as noites, ela fica sentada, virada para fora do acampamento, olhando para o escuro. Como se estivesse esperando um ataque. Como se estivesse esperando uma resposta.</p>\n<p>Você percebe que ela toca o escudo. Não com carinho. Com necessidade. Como se o escudo fosse uma parte do corpo que ela precisa conferir de vez em quando, pra ter certeza de que ainda está lá.</p>\n<p>Você percebe que ela nunca fala da família.</p>\n<p>Uma vez, num acaso, você pergunta:</p>\n<p>— Você tem irmãos?</p>\n<p>Ela demora pra responder. Depois diz:</p>\n<p>— Tinha.</p>\n<p>E não fala mais nada.</p>\n<p>Naquela noite, você a vê. Você finge estar dormindo. Ela está sentada perto do fogo, olhando para as chamas. E ela está chorando. Não com soluço. Não com drama. Só com lágrimas caindo, sem expressão no rosto, como se nem percebesse.</p>\n<p>Você nunca conta pra ninguém que viu isso. Nem pra ela. Especialmente pra ela.</p>\n<hr>\n<p><strong>A IRMÃ</strong></p>\n<p>Muito tempo depois, quando o grupo já está junto há semanas, Valda conta. Não porque quer. Porque precisa.</p>\n<p>Estão todos sentados ao redor do fogo. Ninguém perguntou nada. Foi ela quem começou.</p>\n<p>— Eu tinha uma irmã. Mais nova. Dois anos. O nome dela era Cora.</p>\n<p>Silêncio.</p>\n<p>— Ela era... diferente de mim. Tudo que eu era forte, ela era graciosa. Tudo que eu era dura, ela era gentil. Ela tinha um riso que enchia a casa. Ela gostava de flores. Ela sabia os nomes de todas as flores do campo. Todas. Ela me ensinou a reconhecer cada uma. Eu nunca decorei. Mas eu lembro que ela sabia.</p>\n<p>Silêncio.</p>\n<p>— Quando o cerco começou, eu era capitã. Eu tinha que proteger o portão. Eu tinha que proteger a cidade inteira. Eu não podia proteger uma pessoa só. Isso é o que eu disse pra mim mesma. Isso é o que eu ainda digo.</p>\n<p>Silêncio.</p>\n<p>— Ela morreu no terceiro dia. Levou uma flechada que era pra mim. Ela estava atrás de mim. Ela não devia estar ali. Eu não sei por que ela estava ali. Eu nunca vou saber.</p>\n<p>Valda passa a mão no rosto.</p>\n<p>— Eu segurei o portão por três dias. Eu não dormi. Eu não comi. Eu só segurei. Quando acabou, eu tinha sangue nas mãos. E não era meu.</p>\n<p>Silêncio.</p>\n<p>— Eu nunca chorei por ela. Não no enterro. Não depois. Eu não conseguia. Eu tinha que ser forte. Capitã não chora na frente da tropa. Capitã <strong>engole</strong>.</p>\n<p>Ela para.</p>\n<p>— Mas eu choro agora. Às vezes. Quando ninguém tá olhando. Eu choro pela Cora. E choro por mim. Porque eu não consegui ser humana o suficiente pra chorar na hora certa.</p>\n<p>Ninguém fala.</p>\n<p>Depois de um tempo, Magnus coloca a mão no ombro dela. Sem falar. Só a mão.</p>\n<p>E Valda, pela primeira vez em anos, <strong>encosta</strong> na mão. Não se afasta. Não endurece. Só encosta.</p>\n<p>E fica assim por muito tempo.</p>\n<hr>"},{"n":3,"title":"O Titã que Ria Demais","part":"PARTE UM — O DESPERTAR","html":"<p>A taverna está no meio do nada.</p>\n<p>Você e Valda andam por dois dias até chegar lá. É uma construção de madeira, pequena, com uma placa torta que diz <em>\"A Última Parada\"</em>. A porta está aberta. Vocês entram.</p>\n<p>O lugar está quase vazio. Há mesas, cadeiras, um balcão, um homem atrás do balcão. E há mesas com bebidas servidas, cadeiras puxadas, pratos com comida intocada — como se as pessoas estivessem ali, mas não estivessem. Como se alguém tivesse apagado metade do restaurante sem apagar o restaurante.</p>\n<p>O homem atrás do balcão é enorme. Não é alto como Valda — é largo. Ombros de urso, braços de tronco, uma barba ruiva longa com três anéis de ferro trançados. Ele está servindo bebida para uma cadeira vazia. E está rindo.</p>\n<p>— E aí, meu amigo! — diz ele, para a cadeira. — Mais uma cerveja?</p>\n<p>Ele serve. A cerveja fica na mesa, intocada. Ele ri.</p>\n<p>— Você bebe devagar, hein? Tudo bem. Eu também.</p>\n<p>Ele serve outra mesa. Outra cadeira vazia. Ri de novo. E é um riso alto, verdadeiro, que enche o ambiente, que faz você quase acreditar que tem alguém ali.</p>\n<p>Valda para na porta. Olha para o homem. Os olhos dela mudam. Você não sabe o que está vendo, mas sabe que está vendo algo importante.</p>\n<p>— Magnus — diz ela.</p>\n<p>O homem para de rir. Por dois segundos. Depois ri mais alto ainda.</p>\n<p>— Valda! — diz ele. — Quanto tempo, capitã! Vem cá, senta, toma uma cerveja!</p>\n<p>— Magnus.</p>\n<p>— Senta, Valda.</p>\n<p>— Magnus.</p>\n<p>— <strong>Senta, Valda.</strong></p>\n<p>Ela senta. Você senta também. O homem — Magnus — serve três cervejas. Uma para ele, uma para Valda, uma para você. Ele não olha para nenhum de vocês. Ele olha para a cadeira vazia do lado.</p>\n<p>— Vocês sabiam — diz ele — que eu tinha uma filha?</p>\n<p>Silêncio.</p>\n<p>— Ela tinha oito anos. Cabelo vermelho igual ao meu. — Ele ri. — Ela ria de tudo. <strong>De tudo mesmo.</strong> Uma vez ela riu tanto de um macaco que caiu da cadeira.</p>\n<p>Ele levanta a cerveja. Brinda para o vazio.</p>\n<p>— Se ela me esqueceu, tudo bem. Eu ainda lembro. É assim que funciona, né? Um lado segura o outro.</p>\n<p>Valda coloca a mão no braço dele.</p>\n<p>— Não — diz ela. — Um lado <strong>escolhe</strong> segurar o outro. Não é automático.</p>\n<p>Magnus para de rir.</p>\n<p>Olha para Valda.</p>\n<p>E pela primeira vez desde que vocês entraram, ele fica quieto. Não por dois segundos. Não por um minuto. Por muito tempo. Você não sabe quanto. Talvez cinco minutos. Talvez mais.</p>\n<p>Depois ele fala. Baixo. Sem olhar para ninguém.</p>\n<p>— Você tá certa, capitã. — Ele encosta na cadeira. — Você tá sempre certa. É por isso que eu te odeio um pouco.</p>\n<p>— Eu sei.</p>\n<p>— Mas eu te amo mais.</p>\n<p>— Eu sei.</p>\n<p>Ele se levanta. Pega o martelo enorme que estava apoiado na parede — você não tinha notado até agora. Um martelo de duas mãos, com um núcleo incandescente pulsando dentro da cabeça de metal. Ele o joga no ombro.</p>\n<p>— Vamos, então — diz ele. — Me conta o que tá acontecendo.</p>\n<p>— Você não vai perguntar?</p>\n<p>— Pra quê? Você é a Valda. Se você tá aqui, é porque tá ruim. <strong>E se tá ruim, eu vou.</strong></p>\n<p>Ele passa por vocês e sai pela porta. Vocês o seguem. E a taverna fica para trás, com suas mesas servidas e suas cadeiras vazias e sua comida intocada, e ninguém nunca mais vai entrar lá.</p>\n<hr>\n<p><strong>O PASSADO DE MAGNUS</strong></p>\n<p>Ele não fala sobre isso. Não diretamente. Mas o tempo todo, você percebe coisas.</p>\n<p>Você percebe que ele <strong>nunca para de falar</strong>. Ele conta piadas ruins. Ele conta histórias de batalhas. Ele conta sobre a vez que ele tentou cozinhar e queimou a cozinha inteira. Ele fala, fala, fala. Como se o silêncio fosse uma coisa que ele não pode permitir.</p>\n<p>Você percebe que, quando ele acha que ninguém está olhando, ele para. E fica olhando para o vazio. Com uma expressão que você nunca vê de dia.</p>\n<p>Você percebe que ele toca a botina. Sempre a mesma botina. Sempre o mesmo lugar — na altura do tornozelo. Como se tivesse algo guardado ali.</p>\n<p>Uma vez, você pergunta:</p>\n<p>— O que você tem na botina?</p>\n<p>Ele demora pra responder. Depois:</p>\n<p>— Uma foto.</p>\n<p>— De quem?</p>\n<p>— Da minha filha.</p>\n<p>Ele não fala mais nada. E você não pergunta mais.</p>\n<hr>\n<p><strong>A FILHA</strong></p>\n<p>Ele conta por acidente.</p>\n<p>Estão todos bêbados — ou fingindo estar — ao redor do fogo. Alguém — Soren, provavelmente — pergunta qual é a pior coisa que já aconteceu com cada um.</p>\n<p>— A pior coisa que já me aconteceu — diz Soren — foi matar meu irmão.</p>\n<p>Silêncio.</p>\n<p>— A pior coisa que já me aconteceu — diz Kaelen — foi vencer meu pai.</p>\n<p>Silêncio.</p>\n<p>— A pior coisa que já me aconteceu — diz Vespera — foi ser expulsa de Arcanum.</p>\n<p>Silêncio.</p>\n<p>Todos olham para Magnus. Ele está rindo. Claro que está. Ele está sempre rindo.</p>\n<p>— A pior coisa que já me aconteceu — diz ele — foi rir no enterro da minha filha.</p>\n<p>Silêncio. Profundo.</p>\n<p>— Eu ri. <strong>Na frente de todo mundo.</strong> As pessoas acharam que eu era louco. Ou que eu não amava ela. Ou que eu tava em choque.</p>\n<p>Ele levanta a garrafa. Bebe.</p>\n<p>— Eu ri porque, se eu não risse, eu ia ter que sentir. E se eu sentisse, eu ia morrer ali mesmo. <strong>Eu ia morrer ali mesmo.</strong></p>\n<p>Ele baixa a garrafa.</p>\n<p>— Então eu ri. E ri. E ri. E enterrei ela rindo. E depois, quando cheguei em casa, eu chorei por três dias. <strong>Três dias inteiros.</strong> Ninguém viu. <strong>Ninguém nunca vai ver.</strong></p>\n<p>Ele olha para o grupo.</p>\n<p>— Vocês acham que eu sou o engraçado. O bobo. O grandão que ri de tudo. — Ele balança a cabeça. — Eu sou o homem que aprendeu a rir pra não morrer. <strong>É diferente.</strong></p>\n<p>Silêncio.</p>\n<p>Depois de um tempo, Valda fala:</p>\n<p>— Qual era o nome dela?</p>\n<p>— Ysolde.</p>\n<p>— Ysolde.</p>\n<p>— Era um nome bonito. — Ele olha para o fogo. — Ela escolheu sozinha. Tinha cinco anos. Disse que queria um nome que ninguém mais tinha. <strong>Ela conseguiu.</strong></p>\n<p>Silêncio.</p>\n<p>— Ela era igual a você, Valda.</p>\n<p>— Como?</p>\n<p>— Teimosa. Não aceitava não. Sabia o que queria. — Ele ri. — Uma vez ela quis um gato. Um gato específico. Um gato preto de uma vizinha. Eu disse não. Ela passou três dias sem falar comigo. <strong>Três dias.</strong> No quarto, eu fui comprar o gato.</p>\n<p>— E o que aconteceu?</p>\n<p>— Nada. O gato fugiu no primeiro dia. — Ele ri de novo. Mas é um riso diferente. Mais baixo. Mais verdadeiro. — Mas ela ficou feliz por três dias. <strong>Valeu a pena.</strong></p>\n<p>Silêncio.</p>\n<p>— Você ainda tem a foto dela?</p>\n<p>— Tenho.</p>\n<p>— Posso ver?</p>\n<p>Ele tira a botina. Tira uma fotografia de dentro. Estende pra Valda. Valda olha. Depois passa pro resto do grupo.</p>\n<p>A menina na foto tem uns oito anos. Cabelo vermelho, igual ao do pai. Sorriso enorme. Olhos que parecem rir sozinhos.</p>\n<p>Quando chega a sua vez, você segura a foto por um tempo maior do que os outros. Não quer soltar. Não sabe por quê.</p>\n<p>Magnus pega de volta. Guarda na botina. Calça.</p>\n<p>— Ela tá em algum lugar — diz ele. — Talvez em outra linha. Talvez em outra realidade. Talvez em um mundo onde a Fratura nunca existiu. <strong>Ela tá em algum lugar.</strong></p>\n<p>Ele olha para o fogo.</p>\n<p>— E enquanto ela estiver em algum lugar, eu vou continuar rindo. <strong>Porque é isso que ela ia querer.</strong> Ela ia querer que o pai dela fosse feliz. Mesmo sem ela. <strong>Especialmente sem ela.</strong></p>\n<p>Silêncio.</p>\n<p>Ninguém fala.</p>\n<p>E naquela noite, pela primeira vez em anos, Magnus não ri enquanto dorme.</p>\n<hr>"},{"n":4,"title":"O Que Sobrou de Arcanum","part":"PARTE UM — O DESPERTAR","html":"<p>Vocês caminham por cinco dias. Magnus fala o tempo todo. Conta piadas ruins, histórias de batalhas, histórias de cerveja. Valda responde em monossílabos. Você ouve.</p>\n<p>No sexto dia, vocês chegam em Arcanum.</p>\n<p>Você não sabe o que esperava. Uma cidade? Um palácio? Uma torre? O que você vê é pior. O que você vê são ruínas — mas não ruínas normais. Ruínas que estão se reconstruindo.</p>\n<p>Há paredes que se levantam sozinhas. Telhados que se refazem. Escadas que se constroem de baixo para cima, degrau por degrau, no ar, sem apoio. É como assistir uma cidade voltar ao passado, em câmera lenta.</p>\n<p>No centro das ruínas, há uma biblioteca.</p>\n<p>A biblioteca está intacta. Mais do que intacta — está viva. As estantes respiram. Os livros sussurram. Alguns flutuam no ar, abertos, com páginas virando sozinhas. Outros empilham-se em torres que mudam de forma quando você desvia o olhar.</p>\n<p>E no meio de tudo isso, sentada em uma mesa, escrevendo em um livro que reescreve a si mesmo, há uma mulher.</p>\n<p>Ela é esguia, alta, com cabelo negro longo que flutua levemente como se estivesse submerso em água. Uma mecha branca discreta cai sobre o olho direito. Ela usa um robe assimétrico preto e roxo, com o ombro esquerdo exposto, bordado com constelações em fio prateado que se movem lentamente pelo tecido. Há um orbe de energia escura flutuando ao lado dela, com runas girando em órbita.</p>\n<p>Ela não se vira quando vocês entram. Só fala, sem parar de escrever:</p>\n<p>— Vocês acham que a Fratura é um monstro. Não é. É uma <strong>pergunta mal feita</strong>. E eu vou descobrir quem fez.</p>\n<p>Valda dá um passo à frente.</p>\n<p>— Você é Vespera.</p>\n<p>— Sou.</p>\n<p>— Expulsa de Arcanum.</p>\n<p>— Expulsa é uma palavra forte. — Ela continua escrevendo. — Eu diria \"liberada da obrigação de conviver com idiotas\".</p>\n<p>Magnus ri. Alto. Vespera finalmente para de escrever. Vira-se. Olha para ele. Depois para Valda. Depois para você. Demora em você. Não diz por quê.</p>\n<p>— Vocês vieram por causa do bilhete — diz ela.</p>\n<p>— Como você sabe?</p>\n<p>— Porque eu recebi um também.</p>\n<p>Ela pega um papel amassado do bolso do robe. Mostra. É a mesma letra. Sem assinatura.</p>\n<p>— O guardião do Arquivo me procurou antes de desaparecer. — Ela dobra o papel. — Ele me disse que eu era a única pessoa que poderia entender. <strong>Eu ainda não entendi o quê.</strong></p>\n<p>— Você vai com a gente?</p>\n<p>— Vou. — Ela se levanta. — Mas não por bondade. Vou porque <strong>quero respostas</strong>. E se eu não gostar das respostas, eu vou embora.</p>\n<p>Ela pega o orbe no ar. Ele flutua até a mão dela. Ela o encaixa em um suporte no pulso.</p>\n<p>— Uma coisa antes. — Ela olha para você. — Você sabe o que é um contrato?</p>\n<p>— Sim.</p>\n<p>— Não, você não sabe. — Ela sorri. Um sorriso fino. — Mas vai aprender.</p>\n<hr>\n<p><strong>O PASSADO DE VESPERA</strong></p>\n<p>Ela não fala do passado. Nunca. Mas você percebe coisas.</p>\n<p>Você percebe que ela nunca dorme sem um livro ao lado. Nunca. Nem quando está exausta. Nem quando está ferida. O livro está sempre ali, como uma arma, como um escudo, como uma segunda pele.</p>\n<p>Você percebe que ela escreve. Sempre escreve. Em qualquer superfície — papel, pergaminho, casca de árvore, ar. Como se estivesse com medo de esquecer. Como se, se ela parar de escrever, algo dentro dela morre.</p>\n<p>Você percebe que ela nunca fala de Arcanum. Quando o assunto surge, ela muda. Rapidamente. Com jeito. Sempre.</p>\n<p>Uma vez, Magnus pergunta diretamente:</p>\n<p>— O que aconteceu em Arcanum?</p>\n<p>E ela responde:</p>\n<p>— Aconteceu que eu disse a verdade. E ninguém gostou.</p>\n<p>E não fala mais nada.</p>\n<hr>\n<p><strong>A VERDADE</strong></p>\n<p>Ela conta no septuagésimo dia. Depois de encontrar o arquivo. Depois de ler a ficha.</p>\n<p>Estão todos ao redor do fogo. Ela está segurando o papel. O papel está amassado de tanto que ela segurou.</p>\n<p>— Eu tinha uma mentora. — A voz dela é baixa. — O nome dela era Mira.</p>\n<p>Silêncio.</p>\n<p>— Mira me ensinou tudo. Magia. História. Lógica. Ela era... — Vespera para. — Ela era como uma mãe. Eu não tive mãe. Eu tive Mira.</p>\n<p>Silêncio.</p>\n<p>— Quando eu comecei a pesquisar magia proibida, Mira me apoiou. Ela me deu livros. Ela me deu acesso. Ela me deu <strong>permissão</strong>.</p>\n<p>Silêncio.</p>\n<p>— Quando os arquimagos descobriram, Mira negou tudo. Disse que eu tinha roubado os livros. Disse que eu tinha invadido os arquivos. Disse que ela nunca tinha me apoiado.</p>\n<p>Silêncio.</p>\n<p>— Eu fui expulsa por sedição. Mas o <strong>motivo real</strong> era diferente. Eu tava pesquisando uma coisa que ninguém queria que ninguém pesquisasse.</p>\n<p>— O que você tava pesquisando?</p>\n<p>— A Fratura. — Ela olha para o grupo. — Eu descobri a Fratura antes dela acontecer. Eu vi os sinais. Eu vi os padrões. Eu escrevi 200 páginas sobre o que estava vindo.</p>\n<p>— E ninguém acreditou?</p>\n<p>— Ninguém. — Ela ri. Sem humor. — Eu era jovem. Eu era mulher. Eu era \"rebelde\". Eles preferiram me expulsar a <strong>admitir que eu tava certa</strong>.</p>\n<p>Silêncio.</p>\n<p>— Mira morreu três anos depois. — Vespera olha para o fogo. — De causas naturais. Ela nunca me procurou. Ela nunca se desculpou. Ela nunca admitiu o que fez.</p>\n<p>— E você?</p>\n<p>— Eu passei 20 anos odiando ela. — Ela encolhe os ombros. — Hoje eu só... não sinto nada.</p>\n<p>Silêncio.</p>\n<p>— Mas tem uma coisa — diz Vespera.</p>\n<p>— O quê?</p>\n<p>— Elara. — Ela olha para a menina, que está dormindo no colo de Nyx. — Quando a Elara falou da sombra atrás de mim. A sombra que chora.</p>\n<p>Silêncio.</p>\n<p>— Eu acho que era a Mira.</p>\n<p>Silêncio.</p>\n<p>— Eu acho que ela tá tentando falar comigo. <strong>Desde que ela morreu.</strong></p>\n<p>Ninguém fala.</p>\n<p>— E eu não sei o que ela quer dizer.</p>\n<p>Ela fecha o livro. Levanta. Vai embora.</p>\n<p>Ninguém a segue.</p>\n<hr>"},{"n":5,"title":"Fogo Frio","part":"PARTE UM — O DESPERTAR","html":"<p>O quinto dia depois de Arcanum.</p>\n<p>Vocês estão caminhando quando veem, ao longe, uma zona fraturada. É como um rasgo no céu — uma linha brilhante, irregular, como se o mundo fosse um tecido e alguém tivesse passado uma faca. Perto dela, o ar vibra. As árvores ao redor estão cinzas. Algumas estão desaparecendo, devagar, como se estivessem sendo apagadas por uma borracha invisível.</p>\n<p>E do centro da zona fraturada, saindo dela, há uma pessoa.</p>\n<p>Um homem. Jovem. Vinte e poucos anos. Cabelo vermelho-alaranjado espetado, com pontas que parecem fumegar. Marca de queimadura em espiral no lado direito do rosto. Ele anda — não corre — e a cada passo deixa uma pegada de brasa no chão. Ele está pálido. Muito pálido. O corpo dele fumega.</p>\n<p>Ele olha para vocês como se estivesse vendo pessoas pela primeira vez.</p>\n<p>— Vocês... — Ele para. Cambaleia. — Vocês são reais?</p>\n<p>Ninguém responde. Ele dá mais um passo. Cai de joelhos.</p>\n<p>— Vocês são <strong>reais</strong>?</p>\n<p>Vespera se aproxima. Analisa. Você vê o rosto dela mudar — reconhecimento. Algo que ela não esperava.</p>\n<p>— Ignis — diz ela.</p>\n<p>Ele olha para ela. E algo passa no rosto dele também. <strong>Ele lembra dela.</strong> Mas não diz.</p>\n<p>— Como você saiu? — pergunta Vespera. — Ninguém sai.</p>\n<p>— Eu ouvi a voz dele. — Ignis olha para o chão. — Ele não foi apagado. Ele está <strong>dentro</strong>.</p>\n<p>— Quem?</p>\n<p>— Meu irmão. — Ele fecha os olhos. — Kael.</p>\n<p>Ele desmaia. Vespera o segura antes de cair. Fica com ele no colo por um segundo. Um segundo só. Depois o entrega para Magnus.</p>\n<p>— Carrega ele.</p>\n<p>— Por quê?</p>\n<p>— Porque eu não posso.</p>\n<p>Magnus carrega Ignis nas costas. Vocês seguem viagem. E ninguém comenta o que viu no rosto de Vespera.</p>\n<hr>\n<p><strong>O PASSADO DE IGNIS</strong></p>\n<p>Ele acorda três dias depois.</p>\n<p>Não fala. Não ri. Não explode. Fica sentado, olhando para o fogo, por horas. Como se estivesse processando algo. Como se estivesse lembrando de algo.</p>\n<p>No quarto dia, ele finalmente fala. Para ninguém em particular. Para o vazio.</p>\n<p>— Eu tinha um irmão gêmeo. — A voz dele é baixa. — Ele se chamava Kael.</p>\n<p>Silêncio.</p>\n<p>— A gente nasceu na mesma hora. No mesmo minuto. A gente cresceu junto. A gente aprendeu a andar junto. A gente aprendeu a falar junto. A gente aprendeu a lutar junto.</p>\n<p>Silêncio.</p>\n<p>— Quando o ritual do vulcão aconteceu, a gente foi junto. Era um ritual de bênção. Pra quem quisesse se tornar piromante. A gente queria. <strong>Os dois.</strong></p>\n<p>Silêncio.</p>\n<p>— O ritual é assim: você entra no vulcão. Você morre. E você renasce. Se você for forte o bastante.</p>\n<p>Silêncio.</p>\n<p>— Eu fui forte o bastante. — Ele olha para as próprias mãos. — O Kael não.</p>\n<p>Silêncio.</p>\n<p>— Eu saí do vulcão sozinho. — Ele fecha os olhos. — Eu saí e ele ficou.</p>\n<p>Silêncio.</p>\n<p>— E o pior é que eu <strong>sabia</strong>. Eu sabia que ele não ia conseguir. Eu sabia que ele era mais fraco. Eu sabia que eu ia sair sozinho. <strong>E eu fui mesmo assim.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu fui mesmo assim. <strong>Porque eu queria ser piromante.</strong> Eu queria o poder. Eu queria o fogo. Eu queria ser especial. <strong>E eu escolhi isso em vez do meu irmão.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu passei 24 anos me odiando por isso. <strong>24 anos.</strong> Sem parar. Todo dia. Toda noite.</p>\n<p>Ele levanta a cabeça. Olha para o grupo.</p>\n<p>— E aí eu ouvi ele. Dentro da Fratura. Ele tá vivo. De um jeito. <strong>Ele tá vivo.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu não vou descansar até tirar ele de lá. — Ele se levanta. — E se eu morrer tentando, <strong>que seja</strong>. Já devia ter sido eu mesmo.</p>\n<p>Ele vira as costas. Vai para longe.</p>\n<p>Ninguém o segue.</p>\n<p>Mas naquela noite, Vespera senta do lado dele. Sem falar. Só senta.</p>\n<p>E ele, pela primeira vez desde que acordou, <strong>não se afasta</strong>.</p>\n<hr>"},{"n":6,"title":"A Ponte que Ninguém Atravessava","part":"PARTE UM — O DESPERTAR","html":"<p>Vocês chegam à ponte no nono dia.</p>\n<p>É uma ponte de pedra, antiga, arqueada, sobre um rio que talvez um dia tenha sido largo e agora é um fio de água. Do outro lado da ponte, há uma cidade — ou o que restou de uma cidade. Prédios altos, torres, muralhas. Viva? Talvez. Difícil dizer.</p>\n<p>No meio da ponte, há um homem.</p>\n<p>Ele é jovem — vinte e cinco, talvez. Cabelo loiro-acinzentado preso elegantemente atrás, uma mecha rebelde caindo sobre a testa. Armadura de duelo preta e prata, ajustada ao corpo. Capa azul-real. Duas rapieiras nas mãos.</p>\n<p>Ele está parado. Imóvel. Não olha para vocês quando vocês se aproximam. Olha para a cidade do outro lado.</p>\n<p>— Você está aí há quanto tempo? — pergunta Valda.</p>\n<p>— Três dias.</p>\n<p>— Por quê?</p>\n<p>Ele finalmente olha para ela. E você vê. Do outro lado da ponte, no portão da cidade, há uma figura. Um homem mais velho. Ele está acenando. Ele está sorrindo.</p>\n<p>— Quem é ele?</p>\n<p>— Meu pai.</p>\n<p>Silêncio.</p>\n<p>— Ele morreu há dez anos. — Kaelen volta a olhar para a cidade. — Isso é ilusão. Eu sei. <strong>Eu sei.</strong> Mas enquanto eu não atravessar, ele tá vivo.</p>\n<p>— Kaelen.</p>\n<p>— Vocês podem passar. — Ele dá um passo ao lado, liberando a ponte. — Eu não vou.</p>\n<p>Valda não passa. Ela fica.</p>\n<p>— Eu tinha uma irmã — diz ela.</p>\n<p>Kaelen olha para ela.</p>\n<p>— Ela morreu no Portão Sul. Ela morreu na frente de mim. Eu segurei o portão por três dias, porque se eu parasse, todos morreriam. E ela morreu. E eu continuei segurando. <strong>Porque era o que tinha que ser feito.</strong></p>\n<p>Kaelen não fala.</p>\n<p>— Eu não escolhi não saber. — Valda dá um passo à frente. — Eu <strong>vi</strong>. E eu carrego isso. Toda noite. Toda manhã. Todo segundo em que eu não estou fazendo nada.</p>\n<p>— ...</p>\n<p>— Você pode ficar aqui olhando pro seu pai pra sempre. — Ela estende a mão. — Ou você pode vir com a gente, ver o que tá acontecendo no mundo, e <strong>talvez</strong> descobrir que tem mais coisa pra fazer do que olhar.</p>\n<p>Kaelen olha para a mão dela. Olha para o pai. Olha para a mão dela de novo.</p>\n<p>Ele dá um passo.</p>\n<p>Depois outro. Ele atravessa a ponte. Quando chega do outro lado, o pai desaparece. Ele não olha para trás. A mão dele encontra a de Valda, por um segundo, e depois solta.</p>\n<p>— Eu vou — diz ele. — Mas eu não vou falar do meu pai.</p>\n<p>— Ninguém pediu.</p>\n<p>— Ninguém pediu. — Ele olha para o grupo. Olha para você. — Meu nome é Kaelen. Herdeiro da escola de esgrima de Vauclaire. Vocês não conhecem. Vão conhecer.</p>\n<p>Ele se junta ao grupo. Ninguém comenta o que aconteceu. Ninguém precisa.</p>\n<hr>\n<p><strong>O PASSADO DE KAELEN</strong></p>\n<p>Ele é fechado. Muito. Mais fechado que Valda. Mais fechado que Vespera. Ele fala quando precisa. Ri quando é educado. Luta quando é necessário. Mas ele nunca, nunca, <strong>se abre</strong>.</p>\n<p>Mas você percebe.</p>\n<p>Você percebe que ele treina. Todo dia. Toda noite. Sempre que tem um minuto. Ele treina. Sozinho. Ele desenha formas no ar com as rapieiras. Ele repete movimentos. Ele refina. <strong>Ele nunca para.</strong></p>\n<p>Você percebe que ele olha para Soren. Não de forma óbvia. Mas olha. Como se visse algo em Soren que ele não quer ver. Como se Soren fosse um espelho.</p>\n<p>Você percebe que ele carrega uma carta. No bolso interno do casaco. Ele nunca abre. Mas ele toca. Sempre. Como se a carta estivesse quente.</p>\n<hr>\n<p><strong>O DUELO</strong></p>\n<p>Ele conta. Não porque quer. Porque Soren pergunta. Diretamente. No meio de uma noite.</p>\n<p>— Por que você não abre a carta?</p>\n<p>— Porque não.</p>\n<p>— Por que não?</p>\n<p>— Porque não.</p>\n<p>— Kaelen.</p>\n<p>— <strong>Soren.</strong></p>\n<p>— Kaelen.</p>\n<p>Silêncio.</p>\n<p>— Tá. — Kaelen fecha os olhos. — Eu vou contar. Mas você não vai comentar.</p>\n<p>— Não vou comentar.</p>\n<p>— <strong>Promete.</strong></p>\n<p>— Prometo.</p>\n<p>Kaelen respira.</p>\n<p>— Eu venci meu pai num duelo. Eu tinha vinte anos. Ele tinha sessenta. Era o duelo mais importante da minha vida. <strong>E eu venci.</strong></p>\n<p>Silêncio.</p>\n<p>— Ele me olhou depois. Não com orgulho. Não com raiva. Com... — Kaelen para. — Não sei. Com algo que eu nunca entendi.</p>\n<p>Silêncio.</p>\n<p>— Ele me deu a carta. Disse: \"Lê quando você perder\". E foi embora.</p>\n<p>Silêncio.</p>\n<p>— Eu nunca perdi. Nunca. <strong>Até hoje.</strong></p>\n<p>Silêncio.</p>\n<p>— E eu tô com medo de ler. Porque se eu ler, eu vou ter que admitir que perdi. E eu não sei perder. <strong>Eu nunca aprendi.</strong></p>\n<p>Silêncio.</p>\n<p>— E se eu não sei perder, eu não sei viver. Porque a vida é perder. <strong>É perder tempo, perder gente, perder coisas.</strong> E eu não sei fazer isso.</p>\n<p>Ele olha para Soren.</p>\n<p>— Você sabe. Você perdeu tudo. Seu irmão. Sua guilda. Seus amigos. E você tá aqui. <strong>Você sabe perder.</strong></p>\n<p>Soren não fala.</p>\n<p>— Me ensina. — Kaelen olha para ele. — Me ensina a perder.</p>\n<p>Silêncio.</p>\n<p>— Eu não sei ensinar — diz Soren. — Mas eu posso... <strong>ficar com você enquanto você aprende.</strong></p>\n<p>— Tá bom.</p>\n<p>Eles ficam. Sem falar. Só ficam.</p>\n<p>E naquela noite, quando todos estão dormindo, Kaelen abre a carta.</p>\n<p>Ele lê. Devagar. Ele chora. Devagar.</p>\n<p>E ele guarda a carta de volta no bolso. Mas dessa vez, ele não toca mais. <strong>Ele sabe o que a carta diz.</strong></p>\n<p>E ele sabe que, agora, ele pode perder. Porque ele já sabe o que o pai queria dizer.</p>\n<hr>"},{"n":7,"title":"A Menina que Salvou uma Criança","part":"PARTE UM — O DESPERTAR","html":"<p>No décimo terceiro dia, vocês chegam a uma cidade pequena.</p>\n<p>A cidade está vazia. Não apagada — <strong>vazia</strong>. Como se as pessoas tivessem ido embora com pressa. Portas abertas, comidas na mesa, brinquedos no chão. E silêncio.</p>\n<p>Vocês andam pelas ruas. Kaelen vai na frente. Magnus carrega Ignis (que ainda não acordou). Vespera observa. Valda fica na retaguarda.</p>\n<p>Vocês chegam em uma escola.</p>\n<p>A escola tem um pátio, e no pátio há uma menina de uns sete anos, sentada no chão, desenhando com giz. Ela está calma. Ela está cantando baixinho. Ela não parece notar que a cidade está vazia.</p>\n<p>E no telhado da escola, sentada na beirada, com os pés balançando, há uma mulher.</p>\n<p>Ela é esguia, pequena, com cabelo escuro em trança complexa, capuz abaixado, couro preto ajustado. Nas mãos, duas adagas curvas. Aos pés dela, uma névoa de sombra.</p>\n<p>Ela não se vira.</p>\n<p>— Se vocês chegarem perto dela, eu mato vocês.</p>\n<p>Magnus ri. Alto.</p>\n<p>— Amigável.</p>\n<p>Ela olha para ele. E você vê. <strong>Ela reconhece.</strong> Algo passa no rosto dela — culpa, medo, uma coisa antiga. Mas ela não diz nada.</p>\n<p>— A gente não vai machucar a criança — diz Valda. — Pode descer.</p>\n<p>— Não posso.</p>\n<p>— Por quê?</p>\n<p>— Porque se eu descer, eu tenho que olhar pra vocês. E se eu olhar pra vocês, eu tenho que <strong>lembrar</strong>. E eu não quero lembrar.</p>\n<p>Valda espera.</p>\n<p>— Eu protejo essa criança há dois meses — diz a mulher. — O nome dela é Elara. A Fratura passou por aqui. Apagou todo mundo. Menos ela.</p>\n<p>— Por que menos ela?</p>\n<p>— Porque eu <strong>escolhi não esquecer</strong>. — Ela finalmente vira. Olha para Valda. Depois para Magnus. Demora em Magnus. — Eu não sei por que ela. Eu não sei por que essa criança. Eu só sei que quando eu olhei pra ela, eu <strong>soube</strong> que ela não podia ser apagada.</p>\n<p>— E você é...?</p>\n<p>— Nyx. — Ela desce do telhado. De um jeito que parece impossível — ela simplesmente <strong>desaparece</strong> e <strong>reaparece</strong> no chão. — Eu vou com vocês. Mas a Elara vai junto.</p>\n<p>— Não podemos levar uma criança pra uma missão perigosa.</p>\n<p>— Então eu não vou.</p>\n<p>Valda olha para Elara. Elara olha para Valda. E então Elara fala, pela primeira vez, com uma voz fina e clara:</p>\n<p>— Eu quero ir.</p>\n<p>Silêncio.</p>\n<p>— Aonde vocês vão, tem um homem de chapéu?</p>\n<p>Ninguém entende.</p>\n<p>— Um homem de chapéu. — Elara aponta para o vazio, para um ponto no ar entre Valda e Magnus. — Ali tinha um. Ele sorria pra mim.</p>\n<p>Ninguém vê nada. Só Elara.</p>\n<p>— A menina vê coisas — diz Nyx. — Coisas que a Fratura deixou. Coisas que ninguém mais vê. <strong>Ela é útil.</strong></p>\n<p>— Ela é uma criança.</p>\n<p>— Ela é a <strong>única</strong> que lembra. — Nyx olha para Valda. — Vocês entenderam o que isso significa?</p>\n<p>Valda demora pra responder.</p>\n<p>— Significa que ela é a chave.</p>\n<p>— Significa que ela é <strong>a única coisa que a Fratura não pode apagar</strong>. — Nyx estende a mão para Elara. A menina levanta e segura a mão dela. — E isso, querendo ou não, faz ela a pessoa mais importante desse grupo.</p>\n<p>Magnus fala:</p>\n<p>— Ela vai com a gente.</p>\n<p>— Magnus...</p>\n<p>— Ela vai com a gente. — Ele olha para Valda. — Você já decidiu pior, capitã.</p>\n<p>Valda suspira. Concorda. O grupo segue.</p>\n<hr>\n<p><strong>O PASSADO DE NYX</strong></p>\n<p>Nyx fala pouco. Mas quando fala, você escuta.</p>\n<p>Uma noite, sentada ao lado de Elara, que está dormindo, ela começa a falar. Sem olhar pra ninguém.</p>\n<p>— Eu fui criada nos subterrâneos. — A voz dela é baixa. — Por uma ordem clandestina de assassinos. Eu não tive infância. Eu não tive família. Eu tive <strong>treinamento</strong>.</p>\n<p>Silêncio.</p>\n<p>— Eu matei meu primeiro aos doze anos. Um homem que devia dinheiro. Eu não sabia o nome dele. Não sabia se tinha filhos. Não sabia nada. <strong>Só matei.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu matei vinte e três pessoas entre os doze e os vinte e cinco. Vinte e três. <strong>Eu contei.</strong> Todas por contrato. Todas sem escolha.</p>\n<p>Silêncio.</p>\n<p>— Aos vinte e cinco, eu recebi um contrato. Uma criança. Oito anos. <strong>Filho de um mercador.</strong> O contratante queria que o mercador sofresse. E a melhor forma de fazer um pai sofrer é matar o filho.</p>\n<p>Silêncio.</p>\n<p>— Eu aceitei o contrato. Eu fui até a casa. Eu entrei. Eu subi até o quarto da criança. <strong>E eu abri a porta.</strong></p>\n<p>Silêncio.</p>\n<p>— E eu vi o menino. <strong>Dormindo.</strong> Com um ursinho de pelúcia. E ele era... — Ela para. — Ele era só um menino. <strong>Só um menino.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu não consegui. <strong>Eu não consegui.</strong> Eu fechei a porta. Eu saí. Eu voltei pra ordem. E eu matei o mestre que me mandou. <strong>Com as próprias mãos.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu fugi. E nunca mais matei por contrato. <strong>Nunca mais.</strong> Só matei por escolha. <strong>Minhas escolhas.</strong></p>\n<p>Silêncio.</p>\n<p>— E hoje... — Ela olha pra Elara. — Hoje eu protejo essa menina. Porque ela me lembra daquele menino. <strong>E eu não vou falhar de novo.</strong></p>\n<p>Ela para.</p>\n<p>Silêncio.</p>\n<p>— Eu nunca contei isso pra ninguém. — Ela olha para o grupo. — Vocês são os primeiros.</p>\n<p>Ninguém fala.</p>\n<p>Depois de um tempo, Magnus fala:</p>\n<p>— Nyx.</p>\n<p>— O quê?</p>\n<p>— Qual era o nome do menino?</p>\n<p>— Eu nunca soube. — Ela olha pra ele. — Nunca perguntei.</p>\n<p>Silêncio.</p>\n<p>— Mas se eu te contar uma coisa... — Magnus fala devagar. — Você promete não surtar?</p>\n<p>— O quê?</p>\n<p>— Aelric.</p>\n<p>Nyx para.</p>\n<p>— O quê?</p>\n<p>— Meu filho. O nome dele é Aelric. — Magnus olha pra ela. — Ele tem dezoito anos agora. Cabelo vermelho igual ao meu. Olhos verdes.</p>\n<p>Silêncio.</p>\n<p>— Ele foi salvo por uma assassina que recusou um contrato. Há dez anos.</p>\n<p>Silêncio.</p>\n<p>— <strong>Foi você?</strong></p>\n<p>Nyx não responde. Mas ela não precisa.</p>\n<p>Magnus levanta. Vai até ela. E a abraça.</p>\n<p>E Nyx, pela primeira vez em anos, <strong>chora</strong>.</p>\n<hr>"},{"n":8,"title":"O Homem que Ri de Tudo","part":"PARTE UM — O DESPERTAR","html":"<p>No décimo oitavo dia, vocês chegam a um cemitério.</p>\n<p>É um cemitério fresco. Covas recentes, marcadas com pedras simples, algumas com flores murchas, outras com nada. Não é um cemitério antigo. Não é um cemitério de guerra. É um cemitério de gente que morreu ontem, ou anteontem, ou há uma semana, e que ninguém teve tempo de enterrar direito.</p>\n<p>E no meio do cemitério, sentado em cima de uma lápide, com uma garrafa de vinho na mão, há um homem.</p>\n<p>Ele é jovem. Vinte e dois anos, talvez. Cabelo escuro bagunçado com mechas prateadas. Cicatriz horizontal atravessando o nariz. Uma jaqueta de couro urbano com faixas. Um cachecol vermelho-desbotado no pescoço. Ele está rindo.</p>\n<p>Não para ninguém. Não para o grupo. Para o vazio. Como se o vazio tivesse contado uma piada.</p>\n<p>Quando o grupo se aproxima, ele para de rir. <strong>Na hora.</strong> Como se alguém tivesse desligado um interruptor.</p>\n<p>— Opa — diz ele. — Chegou gente.</p>\n<p>Ele levanta. Cambaleia. Não cai. Ele nunca cai.</p>\n<p>— Vocês são reais?</p>\n<p>— Somos — diz Valda.</p>\n<p>— Que pena. — Ele volta a rir. — Tava mais divertido com os mortos.</p>\n<p>Magnus ri. Alto.</p>\n<p>— Esse eu gostei.</p>\n<p>— É claro que você gostou, grandão. — O rapaz — Soren — pula da lápide. — Você tem cara de quem ri na hora errada.</p>\n<p>— Tenho.</p>\n<p>— Eu também.</p>\n<p>Eles se encaram por um segundo. Depois Soren fala:</p>\n<p>— A guilda. — Ele aponta para o cemitério. — Trinta e sete pessoas. Todas morreram numa noite. Todas por minha causa.</p>\n<p>Silêncio.</p>\n<p>— Eu contei. Trinta e sete. — Ele levanta a garrafa. Brinda. — Eu tô enterrando todos. Um por um. Vai levar mais três dias.</p>\n<p>— A gente pode ajudar.</p>\n<p>— Não. — Ele é firme. — <strong>Eu</strong> enterro. É o único jeito de continuar. Se vocês enterrarem, eu não sei quem tá onde.</p>\n<p>Ele dá mais um gole. Depois:</p>\n<p>— Vocês vão pra onde?</p>\n<p>— Pro Arquivo Central.</p>\n<p>— O Arquivo tá vazio.</p>\n<p>— Tá.</p>\n<p>— E vocês vão pra lá.</p>\n<p>— Vamos.</p>\n<p>Soren pensa. Depois ri. Depois para de rir.</p>\n<p>— Então eu vou com vocês. — Ele joga a garrafa no chão. Ela quebra. — Porque se eu ficar aqui, eu vou acabar enterrando mais trinta e sete.</p>\n<p>Ele se junta ao grupo. Não pergunta nada. Não explica nada. Ele simplesmente <strong>vai</strong>.</p>\n<p>E o cemitério fica pra trás, com suas trinta e sete covas, e nenhuma delas tem nome.</p>\n<hr>\n<p><strong>O PASSADO DE SOREN</strong></p>\n<p>Ele fala. Muito. Sobre tudo. Menos sobre o irmão.</p>\n<p>Uma noite, alguém pergunta. Diretamente. Foi Kaelen.</p>\n<p>— Como seu irmão morreu?</p>\n<p>Soren para. A garrafa para no meio do caminho. Ele fica olhando para o fogo por muito tempo.</p>\n<p>— Ele não morreu. — A voz dele é baixa. — Ele foi morto. <strong>Por mim.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu era mensageiro dos guetos. Eu levava recados entre gangues. Era um trabalho fácil. Rápido. Ninguém percebia. — Ele bebe. — Eu tinha um irmão. Mais novo. Dois anos. O nome dele era Cael.</p>\n<p>Silêncio.</p>\n<p>— Cael queria ser como eu. Queria ser mensageiro. Queria ser rápido. Queria ser invisível. <strong>Queria ser eu.</strong></p>\n<p>Silêncio.</p>\n<p>— Um dia, ele me seguiu. Sem eu saber. Ele queria ver como eu fazia. <strong>Ele queria aprender.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu tava entregando um recado numa casa. Um recado ruim. Um recado que a gangue não queria que chegasse. Quando eu saí, a casa explodiu. <strong>Uma bomba.</strong></p>\n<p>Silêncio.</p>\n<p>— E o Cael tava lá dentro.</p>\n<p>Silêncio.</p>\n<p>— Ele morreu no hospital. Três horas depois. Ele não acordou. Ele só... — Soren para. — Ele só parou de respirar.</p>\n<p>Silêncio.</p>\n<p>— Eu matei meu irmão. <strong>Por acidente.</strong> Porque eu era rápido demais. Porque eu não olhei para trás. Porque eu não pensei que ele poderia estar me seguindo.</p>\n<p>Silêncio.</p>\n<p>— Eu fugi. Da gangue. Do luto. De tudo. <strong>Eu fugi.</strong></p>\n<p>Silêncio.</p>\n<p>— E aí eu entrei na ordem clandestina. E aí eu aprendi a matar. E aí eu matei mais gente. E aí eu construí um cemitério inteiro. <strong>E agora eu tô aqui.</strong></p>\n<p>Ele olha para o grupo.</p>\n<p>— Vocês sabem o que é carregar trinta e sete nomes? — Ele ri. Sem humor. — Nem eu. <strong>Eu perdi a conta.</strong></p>\n<p>Silêncio.</p>\n<p>— Mas eu tenho uma lista. <strong>Escrita.</strong> Na minha cabeça. Todos os nomes. Todos os que eu matei. <strong>Todos.</strong></p>\n<p>Silêncio.</p>\n<p>— E eu falo todos. <strong>Toda noite.</strong> Antes de dormir. Pra que eles não sejam esquecidos. <strong>Pra que eu não me esqueça.</strong></p>\n<p>Silêncio.</p>\n<p>— É a única coisa que eu posso fazer. <strong>Lembrar.</strong></p>\n<p>Kaelen se aproxima. Senta ao lado dele. Sem falar.</p>\n<p>E fica.</p>\n<p>Por muito tempo.</p>\n<hr>\n<h3>PARTE DOIS — A DESCIDA</h3>"},{"n":9,"title":"A Porta de Vidro","part":"PARTE DOIS — A DESCIDA","html":"<p>No vigésimo quinto dia, vocês chegam à Fratura.</p>\n<p>Você não sabe o que esperava. Uma parede de luz? Um portal? Um buraco no céu? O que você vê é <strong>vidro</strong>. O mundo, à frente, é como uma janela rachada. Há uma linha fina, brilhante, irregular, que corta o ar da esquerda para a direita. Através dela, você vê algo. Não é o que está atrás. É <strong>outra coisa</strong>.</p>\n<p>Os heróis param.</p>\n<p>— Nós vamos entrar? — pergunta Kaelen.</p>\n<p>— Vamos — diz Valda.</p>\n<p>— Isso é... seguro?</p>\n<p>— Não.</p>\n<p>— Ótimo.</p>\n<p>Eles atravessam.</p>\n<p>E do outro lado, o mundo é o mesmo — mas não é. O ar é mais pesado. As cores são mais opacas. O silêncio é mais fundo. E vocês não estão sozinhos.</p>\n<p>Há <strong>pessoas</strong>. Muitas pessoas. Pessoas que se parecem com vocês. Pessoas que se parecem com <strong>versões</strong> de vocês.</p>\n<p>Valda vê uma Valda que abandonou a guarda, que está sentada no chão, chorando, sem armadura.</p>\n<p>Magnus vê um Magnus que nunca saiu das minas, que está com um martelo de forja, não de guerra.</p>\n<p>Vespera vê uma Vespera que ficou em Arcanum, que usa um robe branco, que sorri.</p>\n<p>Ignis vê um Ignis que nunca saiu do vulcão, que está queimado até o osso, que está morto.</p>\n<p>Kaelen vê um Kaelen que perdeu o duelo contra o pai, que está ajoelhado, derrotado.</p>\n<p>Nyx vê uma Nyx que nunca saiu da ordem clandestina, que está com a adaga levantada, pronta para matar.</p>\n<p>Soren vê um Soren que nunca riu, que está sentado no chão, com o rosto molhado de lágrimas.</p>\n<p>E você? Você vê a si mesmo. Uma versão sua que nunca entrou no Arquivo Central. Uma versão sua que está na cama, dormindo, sem saber de nada. Uma versão sua que não tem bilhete no bolso, que não tem missão, que não tem nada.</p>\n<p>Ela é mais feliz que você.</p>\n<p>Vespera fala:</p>\n<p>— Isso não é ilusão. É <strong>branching real</strong>. Cada escolha que não fizemos tem uma versão viva aqui dentro.</p>\n<p>— Eles são reais? — pergunta Magnus.</p>\n<p>— Tão reais quanto nós.</p>\n<p>— E eles vão nos atacar?</p>\n<p>— Provavelmente.</p>\n<p>Eles atacam.</p>\n<hr>"},{"n":10,"title":"A Criança que Lembra","part":"PARTE DOIS — A DESCIDA","html":"<p>A batalha é longa. Vocês vencem, mas custa. Quando termina, o grupo está exausto. Senta no chão. Respira.</p>\n<p>Elara está no colo de Nyx. A menina está calma. Ela está olhando ao redor, para os lugares vazios.</p>\n<p>— Ali tinha uma árvore — diz ela, apontando.</p>\n<p>— O quê? — pergunta Nyx.</p>\n<p>— Ali. — Elara aponta para o vazio. — Tinha uma árvore. Grande. Com flores rosas.</p>\n<p>Ninguém vê nada. Só ela.</p>\n<p>— Ali tinha um homem de chapéu. — Ela aponta para outro ponto. — Ele sorria pra mim.</p>\n<p>— Elara...</p>\n<p>— Ali tinha uma fonte. — Ela aponta. — Com água. Eu bebi.</p>\n<p>— <strong>Elara.</strong></p>\n<p>A menina olha para Nyx. Sem entender a urgência na voz.</p>\n<p>— Como você lembra dessas coisas?</p>\n<p>— Eu nunca esqueci. — Elara é simples. Direta. — Vocês é que pararam de olhar.</p>\n<p>Silêncio.</p>\n<p>Vespera se aproxima. Se agacha. Olha Elara nos olhos.</p>\n<p>— Elara. Quando você olha pra mim, o que você vê?</p>\n<p>Elara olha. Demora.</p>\n<p>— Você tá com uma sombra atrás. — Ela aponta para trás de Vespera. — Uma sombra que não é sua. Uma sombra que... chora.</p>\n<p>Vespera fica branca.</p>\n<p>— Que sombra?</p>\n<p>— Uma mulher. — Elara franze a testa. — Ela tá tentando falar com você. Mas você não ouve.</p>\n<p>Vespera se levanta. Rápido. Vira as costas.</p>\n<p>— Vespera — chama Valda.</p>\n<p>— Não. — Ela não vira. — <strong>Não.</strong></p>\n<p>Ela caminha para longe. Ninguém a segue. Ninguém sabe o que dizer.</p>\n<p>Mais tarde, naquela noite, quando todos estão dormindo, você a vê sentada sozinha, olhando para o vazio, com os olhos molhados. Ela não chora. Ela <strong>não</strong> chora. Mas ela olha para o vazio como se esperasse uma resposta.</p>\n<p>E pela primeira vez, você ouve ela falar. Baixinho. Para ninguém.</p>\n<p>— Mira. <strong>Se for você... me deixa em paz.</strong></p>\n<p>Silêncio.</p>\n<p>Nada responde.</p>\n<hr>"},{"n":11,"title":"Os Nomes Gravados","part":"PARTE DOIS — A DESCIDA","html":"<p>No trigésimo dia, vocês encontram a parede.</p>\n<p>É uma parede de pedra, alta, larga, antiga. Cobre o horizonte. Está coberta de nomes. Milhares. Talvez milhões. Escritos com cuidado, um por um, cada um com uma data abaixo.</p>\n<p>Vocês se aproximam. Valda encontra o nome dela.</p>\n<p><strong>\"Valda — capitã da guarda de Pedra-Negra. Morta aos 38.\"</strong></p>\n<p>Ela tem 38 anos.</p>\n<p>Ela passa o dedo pelo nome. Não diz nada.</p>\n<p>Magnus encontra o dele. <strong>\"Magnus — o Titã de Ferro. Morto aos 42.\"</strong> Ele tem 42.</p>\n<p>Kaelen encontra o dele. <strong>\"Kaelen — a Lâmina Veloz. Morto aos 24.\"</strong> Ele tem 25.</p>\n<p>Vespera encontra o dela. <strong>\"Vespera — a Sombra Devoradora. Morta aos 29.\"</strong> Ela tem 29.</p>\n<p>Ignis encontra o dele. <strong>\"Ignis — o Flagelo Flamejante. Morto aos 24.\"</strong> Ele tem 24.</p>\n<p>Nyx encontra o dela. <strong>\"Nyx — a Névoa Noturna. Morta aos 31.\"</strong> Ela tem 31.</p>\n<p>Soren encontra o dele. <strong>\"Soren — o Vento Silencioso. Morto aos 22.\"</strong> Ele tem 22.</p>\n<p>Todos os heróis estão ali. Cada um com a data da própria morte.</p>\n<p>Kaelen fala primeiro:</p>\n<p>— Se eu morri aos 24... então eu não sou eu?</p>\n<p>— Você é — diz Vespera. — Mas talvez tenha morrido em outra linha. E essa linha esteja tentando se fechar.</p>\n<p>— Isso significa que...</p>\n<p>— Significa que estamos todos mortos em algum lugar.</p>\n<p>Silêncio.</p>\n<p>Você olha para a parede. Você procura o seu nome. <strong>Não tem.</strong> Não tem o seu nome em lugar nenhum. Você não morreu em nenhuma linha. Você não existe em nenhuma linha. Você é... novo.</p>\n<p>Valda fala:</p>\n<p>— Tem alguém faltando.</p>\n<p>Todos olham.</p>\n<p>— Tem oito pessoas na profecia. O bilhete diz \"procure os oito\". Tem eu, Magnus, Vespera, Ignis, Kaelen, Nyx e Soren. <strong>Sete.</strong> Falta um.</p>\n<p>— E o oitavo?</p>\n<p>— Não sei.</p>\n<p>Ninguém vê, mas você vê. Você vê que na parede, no canto esquerdo, tem um nome <strong>riscado</strong>. Um nome que foi escrito, e depois apagado, e depois escrito de novo, e depois apagado de novo. Um nome que a Fratura tentou apagar várias vezes e <strong>não conseguiu</strong>.</p>\n<p>E o nome é:</p>\n<p><strong>LUCIEN.</strong></p>\n<p>Você não conta para ninguém. Ainda.</p>\n<p>Mas naquela noite, você sonha com ele. Um homem alto, de terno preto, com chifres finos e cachos caramelos. Ele está escrevendo no ar. Ele está chorando. E ele está dizendo, baixinho:</p>\n<p>— Me desculpa. <strong>Me desculpa.</strong></p>\n<hr>"},{"n":12,"title":"O Irmão que Sobrou","part":"PARTE DOIS — A DESCIDA","html":"<p>No trigésimo quinto dia, Ignis para de andar.</p>\n<p>— Ignis?</p>\n<p>Ele não responde. Olha para o vazio. Ele <strong>ouviu</strong> algo.</p>\n<p>— Ignis, o que foi?</p>\n<p>— Ele tá aqui.</p>\n<p>— Quem?</p>\n<p>— Kael. — Ignis começa a correr. Sozinho. O grupo não consegue acompanhar.</p>\n<p>Ele corre por minutos. Por uma área de névoa. Por um campo aberto. E para.</p>\n<p>Na frente dele, há uma figura.</p>\n<p>É um homem jovem, igual a ele — mesmo cabelo vermelho-alaranjado, mesmo rosto, mesmas marcas. Mas ele é feito de <strong>fumaça</strong>. Ele é translúcido. Ele respira, mas não respira. Ele existe, mas não existe.</p>\n<p>— Ignis — diz a figura.</p>\n<p>— Kael.</p>\n<p>— Você não devia ter vindo. — A voz é um sussurro. — Aqui é onde as coisas param.</p>\n<p>Ignis estende a mão. A mão atravessa.</p>\n<p>— Se você para, eu também paro.</p>\n<p>— Ignis...</p>\n<p>— <strong>Se você para, eu também paro.</strong></p>\n<p>Eles ficam parados por muito tempo. Não se tocam. Não podem. Mas ficam.</p>\n<p>O grupo chega. Vespera puxa Ignis.</p>\n<p>— Ignis. Vamos. Ele não é ele.</p>\n<p>— Ele é o que sobrou. — Ignis não olha para ela. — Isso é o suficiente.</p>\n<p>— <strong>Ignis.</strong></p>\n<p>Ele finalmente olha. Os olhos dele estão molhados. Pela primeira vez.</p>\n<p>— Vamos.</p>\n<p>Ele vira as costas para Kael. E Kael sussurra, atrás dele:</p>\n<p>— Eu tô esperando, irmão.</p>\n<p>Ignis não olha para trás. Mas você vê — ele ouve.</p>\n<hr>"},{"n":13,"title":"A Cidade Sem Nome","part":"PARTE DOIS — A DESCIDA","html":"<p>No quadragésimo dia, vocês chegam a uma cidade em ruínas.</p>\n<p>Valda para.</p>\n<p>— Vocês podem ir na frente — diz ela. — Eu encontro vocês depois.</p>\n<p>— Você tá bem?</p>\n<p>— Tô.</p>\n<p>Ela não está. Mas ninguém insiste.</p>\n<p>Ela anda sozinha pelas ruas. Ruas que ela não reconhece. Prédios que ela não reconhece. Nada. Não sente nada. Nenhuma memória.</p>\n<p>Até que Magnus fala, atrás dela:</p>\n<p>— Aqui você morou.</p>\n<p>Ela para.</p>\n<p>— O quê?</p>\n<p>— Aqui. — Ele aponta para uma casa em ruínas, na esquina. — Você morou aqui. Tinha uma janela no quarto. Você olhava pra rua. Você me falou isso em 1147. Antes da Fratura.</p>\n<p>— Como você sabe?</p>\n<p>— Porque eu <strong>lembro por você</strong>.</p>\n<p>Valda olha para a casa. Ainda não sente nada. Mas algo aperta no peito.</p>\n<p>— Como você lembra?</p>\n<p>— Eu não sei. — Magnus se aproxima. — A Fratura não me pegou direito. Acho que eu sou teimoso demais.</p>\n<p>Ela ri. Baixinho. É a primeira vez no jogo.</p>\n<p>— Você é.</p>\n<p>— Eu sei.</p>\n<p>Eles ficam parados na frente da casa. Não entram. Não precisam. Depois de um minuto, Valda fala:</p>\n<p>— Obrigada.</p>\n<p>— De nada, capitã.</p>\n<p>— Não me chama de capitã.</p>\n<p>— Tá. <strong>Valda.</strong></p>\n<p>Ela olha para ele. Os olhos dela estão diferentes. Mais... humanos. Menos muro.</p>\n<p>— Vamos — diz ela.</p>\n<p>Eles voltam para o grupo. E ninguém comenta nada.</p>\n<p>Mas naquela noite, você vê. Valda está sentada ao lado de Magnus. Ela está encostada nele. Só um pouco. Só o ombro. Mas está encostada.</p>\n<p>E Magnus está sorrindo. Um sorriso que não é o sorriso dele. Um sorriso mais quieto. Mais verdadeiro.</p>\n<hr>"},{"n":14,"title":"O Contrato Original","part":"PARTE DOIS — A DESCIDA","html":"<p>No quadragésimo quinto dia, algo acontece.</p>\n<p>Vocês estão andando quando <strong>alguém aparece do nada</strong>.</p>\n<p>É um homem. Alto. Musculoso. Cachos caramelos bagunçados, olhos âmbar com pupila levemente felina. Dois chifres finos e curtos despontando do cabelo, discretos. Uma capa preta formal com detalhes dourados. E no ombro esquerdo, um gato preto com um olho âmbar e um olho prateado.</p>\n<p>Ele sorri. Um sorriso torto.</p>\n<p>— Olá — diz ele. — Meu nome é Lucien. E eu tenho um contrato pra vocês.</p>\n<p>Valda saca a espada.</p>\n<p>— Quem é você?</p>\n<p>— Alguém que sabe o que vocês precisam. — Ele tira uma caneta do bolso. Uma caneta-tinteiro elegante, com a ponta sangrando uma tinta vermelha que evapora no ar. — Alguém que sabe onde vocês estão indo. E alguém que <strong>pode ajudar</strong>. Em troca de três coisas.</p>\n<p>— Que coisas?</p>\n<p>— Ainda não sei. — Ele gira a caneta entre os dedos. — Vou descobrir durante a jornada.</p>\n<p>Vespera fala:</p>\n<p>— Isso é chantagem.</p>\n<p>— É a definição de <strong>vida adulta</strong>, querida.</p>\n<p>O gato mia. Lucien olha para ele.</p>\n<p>— Sim, eu sei. Eles ainda não confiam.</p>\n<p>Ele olha para você. Direto nos olhos. E por um segundo, você jura que ele <strong>reconheceu</strong> você. Como se já tivesse visto você antes. Mas ele não diz nada.</p>\n<p>Kaelen dá um passo à frente.</p>\n<p>— Por que devemos confiar em você?</p>\n<p>— Você não deve. — Lucien guarda a caneta. — Confiança é uma coisa que se dá. Não se pede. Não se exige. <strong>Se dá.</strong> E eu não vou pedir que vocês me dêem.</p>\n<p>— Então por que você tá aqui?</p>\n<p>— Porque eu <strong>quero ajudar</strong>. — Ele olha para o gato. — E porque a Kira me disse pra vir.</p>\n<p>O gato mia. Como se estivesse confirmando.</p>\n<p>Ninguém entende. Mas ninguém questiona. O grupo segue. E Lucien segue com o grupo.</p>\n<p>Ele não fala muito nos primeiros dias. Fica na retaguarda, escrevendo no ar com a caneta. O gato fica no ombro dele, ou então circulando pelos pés dos heróis, mia às vezes, olha às vezes. Às vezes, ele senta do lado de alguém.</p>\n<p>Ele senta do lado de Nyx primeiro. Depois do lado de Valda. Depois do lado de Kaelen. Depois do lado de Soren.</p>\n<p>E quando senta do lado de alguém, a pessoa se sente... vista. Sem julgamento. Vista.</p>\n<p>Lucien nunca explica por quê.</p>\n<hr>\n<p><strong>O PRIMEIRO SEGREDO</strong></p>\n<p>Na primeira noite com o grupo, Lucien não dorme.</p>\n<p>Ele fica acordado. Escrevendo. Sempre escrevendo. Kira no colo.</p>\n<p>Você se aproxima.</p>\n<p>— Você não dorme?</p>\n<p>— Não.</p>\n<p>— Por quê?</p>\n<p>— Porque eu tenho medo do que eu vou ver.</p>\n<p>Você senta ao lado dele. Ele não olha para você. Continua escrevendo.</p>\n<p>— O que você tá escrevendo?</p>\n<p>— Uma carta.</p>\n<p>— Pra quem?</p>\n<p>— Pra alguém que eu matei.</p>\n<p>Silêncio.</p>\n<p>— Você matou alguém?</p>\n<p>— Matei. — Ele continua escrevendo. — Um homem chamado Erwin. Um cientista. Ele queria provar que o mundo é estranho. <strong>Ele tava certo.</strong> Mas ele precisava de um contrato. Eu escrevi. Ele assinou. E ele morreu.</p>\n<p>— Por quê?</p>\n<p>— Porque eu escrevi os termos errados. — Ele finalmente olha para você. — Ou certos, dependendo do ponto de vista.</p>\n<p>— Você se arrepende?</p>\n<p>— Todo dia. — Ele volta a escrever. — Mas eu me arrependo do jeito, não da escolha. <strong>O gato tá vivo.</strong> Isso é o que importa.</p>\n<p>Ele aponta para Kira. Kira mia.</p>\n<p>— <strong>Esse gato?</strong></p>\n<p>— Esse gato.</p>\n<p>— Valeu a pena?</p>\n<p>Lucien para de escrever. Olha para Kira. Kira olha para ele. Depois de muito tempo, ele fala:</p>\n<p>— Sim.</p>\n<p>E continua escrevendo. Você volta a dormir. E pela primeira vez, você tem um sonho.</p>\n<p>Você sonha com um homem que escreve cartas para os mortos. Você sonha com um gato que existe em todas as realidades. Você sonha com uma menina que vê coisas que ninguém vê. Você sonha com um bilhete sem assinatura. Você sonha com a Fratura.</p>\n<p>E quando você acorda, você não lembra de nada.</p>\n<p>Mas algo mudou. Você não sabe o quê. Ainda.</p>\n<hr>"},{"n":15,"title":"A Pergunta do Gato","part":"PARTE DOIS — A DESCIDA","html":"<p>Na terceira noite com o grupo, Lucien fala.</p>\n<p>Eles estão sentados ao redor do fogo. O gato — Kira — está no colo dele. A caneta está no ar, escrevendo sozinha.</p>\n<p>— Vocês acham que a Fratura é um acidente — diz ele.</p>\n<p>Todos olham.</p>\n<p>— Não é. É <strong>consequência</strong>. — Ele para de escrever. — Um contrato foi assinado. Há muito tempo. E o contratado sobreviveu de forma errada.</p>\n<p>— Que contratado?</p>\n<p>— O contratado não importa. — Ele olha para o fogo. — O que importa é quem <strong>assinou</strong>.</p>\n<p>— E quem assinou?</p>\n<p>Lucien demora.</p>\n<p>— Eu não sei.</p>\n<p>Ele está mentindo. Você vê. Soren vê. Kira vê. Mas ninguém fala.</p>\n<p>— Vamos dormir — diz Valda.</p>\n<p>Todos se deitam. Lucien fica acordado. Olhando para o fogo. Escrevendo.</p>\n<p>No meio da noite, você acorda. Lucien ainda está acordado. Você se aproxima.</p>\n<p>— Você não dorme?</p>\n<p>— Já falei.</p>\n<p>— Já. — Você senta. — Mas eu quero perguntar outra coisa.</p>\n<p>— O quê?</p>\n<p>— Por que você tem chifres?</p>\n<p>Lucien sorri. Um sorriso triste.</p>\n<p>— Porque eu caí.</p>\n<p>— Caiu de onde?</p>\n<p>— Do céu.</p>\n<p>— Você era anjo?</p>\n<p>— Era.</p>\n<p>— E agora?</p>\n<p>— Agora eu sou o que sobrou. — Ele olha para Kira. — Um anjo caído. Um demônio do contrato. Um cuidador de gato.</p>\n<p>— Você não é só isso.</p>\n<p>Lucien olha para você. Surpreso.</p>\n<p>— Não?</p>\n<p>— Não. — Você olha para ele. — Você é alguém que escreve cartas pra gente que matou. Você é alguém que cuida de um gato que existe em todas as realidades. Você é alguém que <strong>escolheu ajudar</strong> um grupo de estranhos sem motivo.</p>\n<p>Silêncio.</p>\n<p>— Você é alguém que <strong>se importa</strong>. Isso não é pouco.</p>\n<p>Lucien fica em silêncio por muito tempo.</p>\n<p>Depois ele ri. Baixinho. E é um som que você nunca ouviu antes — um riso sem sarcasmo.</p>\n<p>— Você me lembra alguém.</p>\n<p>— Quem?</p>\n<p>— Alguém que eu amei. — Ele olha para o fogo. — Há muito tempo. Há muito tempo.</p>\n<p>— Você ama?</p>\n<p>— Amei. — Ele volta a escrever. — Sete vezes. Todas foram a última.</p>\n<p>Silêncio.</p>\n<p>— Você quer falar sobre isso?</p>\n<p>— Não. — Ele sorri. — Ainda não.</p>\n<p>Ele volta a escrever. Você volta a dormir.</p>\n<p>E naquela noite, você sonha com sete figuras. Um anjo. Uma mulher com pão. Um marinheiro. Uma freira. Um médico. Uma menina. Um rapaz. Todos sorrindo para um homem de terno preto que chora.</p>\n<p>E quando você acorda, você entende.</p>\n<p><strong>Sete amores. Sete perdas. Um gato.</strong></p>\n<hr>"},{"n":16,"title":"O Que Kira Vê","part":"PARTE DOIS — A DESCIDA","html":"<p>No quinquagésimo dia, Kira mia.</p>\n<p>Mia alto. Mia para um ponto no ar. Um ponto específico, na frente do grupo.</p>\n<p>Lucien olha. Fica pálido.</p>\n<p>— O que foi? — pergunta Valda.</p>\n<p>Lucien não responde. Ele levanta. Vai até o ponto. Passa a mão. <strong>Não tem nada.</strong> Mas Kira continua miando.</p>\n<p>— Lucien.</p>\n<p>— Kira vê coisas que ninguém vê. — Ele se ajoelha. Passa a mão no chão. — Ela tá vendo o selo.</p>\n<p>— Que selo?</p>\n<p>— O selo original. O selo que abriu a Fratura.</p>\n<p>Ele para. Olha para o grupo. Nos olhos de cada um.</p>\n<p>— Está reativando. A Fratura. — Ele se levanta. — E o único jeito de parar é alguém carregar o selo.</p>\n<p>— Quem?</p>\n<p>Lucien olha para você.</p>\n<p>— Você.</p>\n<p>Você não entende.</p>\n<p>— Por quê eu?</p>\n<p>— Porque você é o Portador. — Ele sorri. Um sorriso triste. — Você não tem passado na Fratura. Você não existe na parede. Você é o único que pode carregar o selo <strong>sem se apagar</strong>.</p>\n<p>— E se eu não quiser?</p>\n<p>— Aí a Fratura engole o mundo. — Ele dá de ombros. — Simples.</p>\n<p>— Você tá me dizendo que eu preciso me sacrificar?</p>\n<p>— Eu não tô te dizendo nada. — Ele guarda a caneta. — Eu tô te contando o que <strong>é</strong>. O que você faz com isso... é seu.</p>\n<p>Ele vira as costas. O grupo fica em silêncio. Você fica em silêncio.</p>\n<p>E pela primeira vez, você sente o peso da missão. Não é um bilhete no bolso. Não é uma mulher estranha ao lado. Não é um mundo que está esquecendo.</p>\n<p>É <strong>você</strong>. Você é a única que pode fazer algo.</p>\n<p>E isso é mais assustador do que tudo.</p>\n<hr>\n<h3>PARTE TRÊS — A FRATURA SE ABRE</h3>"},{"n":17,"title":"Os Primeiros a Esquecer","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No sexagésimo dia, vocês chegam a uma cidade com doze templos.</p>\n<p>Todos vazios.</p>\n<p>Não abandonados — <strong>vazios</strong>. Limpos, cuidados, com velas acesas, com flores frescas nos altares. Mas ninguém está lá. As pessoas da cidade rezam. Todos os dias. Rezam para ninguém.</p>\n<p>— Como assim? — pergunta Magnus.</p>\n<p>— Eles esqueceram — diz Vespera. — Esqueceram quem eles rezam. Mas continuam rezando. Porque o corpo lembra.</p>\n<p>Ela entra em um templo. Olha para o altar. Não tem estátua. Não tem nome. Não tem nada.</p>\n<p>— Os deuses foram apagados. — Ela passa o dedo pelo altar. — E ninguém percebeu porque a própria ideia de deus foi apagada junto.</p>\n<p>Lucien está atrás dela. Em silêncio.</p>\n<p>— Você tá bem? — ela pergunta.</p>\n<p>— ... Eu conheci um. — Ele olha para o altar. — Um deles. Antes.</p>\n<p>— Antes do quê?</p>\n<p>— Antes de cair.</p>\n<p>Silêncio.</p>\n<p>— Você era anjo? — pergunta Kaelen.</p>\n<p>— Era.</p>\n<p>— E agora?</p>\n<p>— Agora eu sou o que sobrou. — Lucien sai do templo. — Vamos. Não tem nada aqui.</p>\n<p>Eles vão. Mas você vê — Vespera olha para o altar uma última vez, como se esperasse uma resposta. Não tem resposta. Só o silêncio.</p>\n<hr>\n<p><strong>A HISTÓRIA DE DEUS</strong></p>\n<p>Naquela noite, Lucien fala. Sem ser perguntado.</p>\n<p>Estão todos ao redor do fogo. Ele está olhando para as chamas.</p>\n<p>— Eu conheci Deus uma vez. — A voz dele é baixa. — Ele não é o que vocês pensam.</p>\n<p>Silêncio.</p>\n<p>— Ele não é velho. Não é barbudo. Não é nada disso. — Lucien olha para o grupo. — Ele é... um homem cansado. Como eu. Como vocês.</p>\n<p>Silêncio.</p>\n<p>— Eu conversei com ele uma vez. Antes de cair. Ele me disse que tava cansado de escrever regras. Que ele queria parar. Que ele queria descansar.</p>\n<p>Silêncio.</p>\n<p>— Eu perguntei por que ele não parava. Ele disse: \"Porque se eu paro, tudo para. <strong>E eu não sei o que acontece depois.</strong>\"</p>\n<p>Silêncio.</p>\n<p>— Eu perguntei se ele tinha medo. Ele disse: \"Todo dia.\"</p>\n<p>Silêncio.</p>\n<p>— Eu perguntei se ele me amava. Ele não respondeu. — Lucien olha para o fogo. — Ele só me abraçou. E eu chorei. E ele chorou também.</p>\n<p>Silêncio.</p>\n<p>— Ele não me expulsou com raiva. <strong>Ele me expulsou com tristeza.</strong> Ele disse: \"Você fez o que eu não tive coragem de fazer. Você salvou um animal. <strong>Você escolheu o amor em vez da regra.</strong> Por isso você não pode ficar aqui. Porque aqui, a regra é maior que o amor.\"</p>\n<p>Silêncio.</p>\n<p>— E eu caí. E eu chorei. E eu não olhei pra trás. <strong>Porque se eu olhasse, eu ia querer voltar.</strong></p>\n<p>Silêncio.</p>\n<p>— Mas eu ainda amo ele. — Lucien olha para o céu. — Todo dia. Mesmo depois de tudo. <strong>Eu ainda amo.</strong></p>\n<p>Ninguém fala.</p>\n<p>Depois de um tempo, Soren pergunta:</p>\n<p>— Você acha que ele ainda te ama?</p>\n<p>— Não sei. — Lucien sorri. — Mas ele manda flores.</p>\n<p>— Flores?</p>\n<p>— Uma vez por ano. Uma flor no meu jardim. <strong>Toda vez.</strong> Sem bilhete. Sem nome. <strong>Só a flor.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu acho que é ele. Ou pode ser o Ariel. <strong>Nunca vou saber.</strong></p>\n<p>— Quem é Ariel?</p>\n<p>Lucien não responde. Ele volta a escrever.</p>\n<hr>"},{"n":18,"title":"A Viúva do Alquimista","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No sexagésimo quinto dia, Kaelen encontra uma caixa.</p>\n<p>Está escondida num armário, num cômodo abandonado, numa casa em ruínas. É uma caixa de madeira, pequena, com uma fechadura. Ele a abre com facilidade — está destrancada.</p>\n<p>Dentro, há uma carta. Endereçada a ele. Com a caligrafia do pai.</p>\n<p>Ele segura a carta por muito tempo. Não abre.</p>\n<p>— Você não vai abrir? — pergunta Soren.</p>\n<p>— Não.</p>\n<p>— Por quê?</p>\n<p>— Porque se eu abrir, eu tenho que responder. — Ele guarda a carta no bolso interno do casaco. — E eu não sei o que dizer.</p>\n<p>— Ele tá morto, Kaelen.</p>\n<p>— Eu sei. — Kaelen vira as costas. — Mas a carta <strong>não está</strong>.</p>\n<p>Ele carrega a carta por três capítulos. Não abre. Não fala dela. Mas você vê — ele toca o bolso de vez em quando. Como se a carta estivesse quente.</p>\n<p>E naquela noite, quando todos estão dormindo, ele abre. Só um pouco. Só pra ler as primeiras palavras.</p>\n<p>E ele chora. Pela primeira vez em anos. Ele chora sem soluço. Sem drama. Só com lágrimas caindo, sem expressão no rosto, como se nem percebesse.</p>\n<p>Ele fecha a carta. Guarda.</p>\n<p>E na manhã seguinte, ele está diferente. Mais leve. Mais presente.</p>\n<p>Ninguém comenta.</p>\n<hr>"},{"n":19,"title":"O Último Registro de Arcanum","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No septuagésimo dia, Vespera encontra a ficha de exílio.</p>\n<p>Ela está nos arquivos da Academia — ou no que restou dela. Um cômodo pequeno, com estantes tombadas, papéis espalhados. Ela procura por horas. Encontra.</p>\n<p>Lê.</p>\n<p>Fica branca.</p>\n<p>— Não foi magia proibida — diz ela.</p>\n<p>O grupo olha.</p>\n<p>— Eles me expulsaram por <strong>sedição</strong>. — Ela fecha o arquivo. — Por dizer que a hipótese cosmológica vigente tava errada.</p>\n<p>— E tava? — pergunta Ignis.</p>\n<p>— Estava. — Ela olha para ele. — Está. <strong>Sempre esteve.</strong></p>\n<p>Silêncio.</p>\n<p>— Eu passei a vida achando que era rebelde. — Ela guarda o arquivo. — Eu era só correta. Isso é pior.</p>\n<p>Ignis se aproxima. Fica ao lado dela. Não fala. Só fica.</p>\n<p>— Você sabia? — pergunta ela.</p>\n<p>— Não.</p>\n<p>— Você me defendeu quando eu fui expulsa?</p>\n<p>— ... Não.</p>\n<p>— Por quê?</p>\n<p>— Porque eu era burro. — Ele olha para ela. — E porque eu tinha medo.</p>\n<p>— Medo de quê?</p>\n<p>— De perder você.</p>\n<p>Vespera olha para ele. Por muito tempo.</p>\n<p>— Você me perdeu de qualquer jeito — diz ela.</p>\n<p>— Eu sei.</p>\n<p>Ela não responde. Mas ela não se afasta.</p>\n<p>E naquela noite, quando todos estão dormindo, ela senta ao lado dele. E ela encosta a cabeça no ombro dele.</p>\n<p>E ele não se move.</p>\n<hr>"},{"n":20,"title":"O Filho de Magnus","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No septuagésimo quinto dia, eles encontram o jovem.</p>\n<p>Está sentado no chão, no meio da Fratura. É um rapaz de uns dezoito anos. Cabelo vermelho. Rosto vago. Apagado.</p>\n<p>Magnus para.</p>\n<p>— Quem é esse? — pergunta.</p>\n<p>Ninguém responde. Magnus olha para o jovem. Não reconhece. Mas algo aperta no peito.</p>\n<p>Nyx está ao lado. Fechou os olhos. Não fala.</p>\n<p>— Nyx.</p>\n<p>— ...</p>\n<p>— <strong>Nyx.</strong></p>\n<p>Ela abre os olhos. Olha para ele.</p>\n<p>— Fui eu que recusei o contrato. — A voz dela é baixa. — Dez anos atrás.</p>\n<p>Silêncio.</p>\n<p>— Foi por isso que ele sobreviveu.</p>\n<p>Magnus fica parado. Não fala. Por muito tempo.</p>\n<p>— O nome dele é Aelric — diz ele, por fim.</p>\n<p>Nyx treme.</p>\n<p>— Cabelo vermelho igual ao meu. Oito anos na época. Hoje é dezoito.</p>\n<p>Silêncio.</p>\n<p>— Obrigado.</p>\n<p>Nyx olha para ele. Incrédula.</p>\n<p>— Eu salvei sem saber.</p>\n<p>— Você salvou. — Magnus olha para ela. — Isso é o que importa.</p>\n<p>Ela não fala. Ele não fala. Eles ficam parados ali, na frente do jovem apagado, por muito tempo.</p>\n<p>Depois, Magnus se ajoelha. Pega a mão do jovem.</p>\n<p>— Eu vou te levar pra casa — diz ele. — Não sei onde é. Mas eu vou.</p>\n<p>O jovem não responde. Magnus o carrega. E o grupo segue.</p>\n<hr>\n<p><strong>O REENCONTRO</strong></p>\n<p>Eles encontram Aelric de verdade três dias depois.</p>\n<p>Não o apagado. O <strong>real</strong>. Um rapaz de dezoito anos, cabelo vermelho, olhos verdes, com uma expressão que é ao mesmo tempo do pai e da mãe. Ele está sentado numa clareira, com um livro no colo.</p>\n<p>Magnus para a vinte passos.</p>\n<p>— Aelric.</p>\n<p>O rapaz olha. Vê o pai. E o rosto dele se ilumina.</p>\n<p>— Pai?</p>\n<p>Magnus não consegue falar. Ele só anda. Devagar. Um passo de cada vez. Como se estivesse com medo de quebrar alguma coisa.</p>\n<p>Ele chega perto. Ajoelha. E abraça o filho.</p>\n<p>E chora. Pela primeira vez em anos, <strong>chora</strong>.</p>\n<p>— Meu filho. — Ele aperta. — Meu filho.</p>\n<p>— Pai, o que tá acontecendo?</p>\n<p>— Nada. — Magnus ri. Entre lágrimas. — Nada. <strong>Só tô com saudade.</strong></p>\n<p>Nyx está atrás, parada. Sem saber o que fazer. Aelric olha para ela.</p>\n<p>— Quem é ela?</p>\n<p>Magnus olha para trás. Olha para Nyx.</p>\n<p>— Ela é... — Ele para. — Ela é a pessoa que salvou você.</p>\n<p>Aelric franze a testa.</p>\n<p>— Salvou?</p>\n<p>— Ela recusou um contrato. — Magnus olha para Nyx. — Um contrato contra você. Há dez anos.</p>\n<p>Silêncio.</p>\n<p>Aelric olha para Nyx. Por muito tempo.</p>\n<p>— Por que você recusou?</p>\n<p>Nyx não responde. Ela não sabe responder. Ela só sabe que, naquele momento, ela olhou para uma criança dormindo e não conseguiu.</p>\n<p>— Porque você era uma criança — diz ela, por fim. — E eu não conseguia.</p>\n<p>Aelric fica em silêncio.</p>\n<p>Depois ele levanta. Vai até ela. E estende a mão.</p>\n<p>— Obrigado.</p>\n<p>Nyx olha para a mão. Olha para Magnus. Olha para a mão de novo.</p>\n<p>Ela aperta.</p>\n<p>— Não me agradeça — diz ela. — Só... <strong>fica vivo.</strong></p>\n<p>— Vou tentar. — Aelric sorri. — Tenho um pai pra cuidar.</p>\n<hr>"},{"n":21,"title":"A Fúria de Ignis","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No octogésimo dia, Ignis ataca.</p>\n<p>Não é ele. É a Fratura. Ela entrou nele. Ela o controla. E agora ele está vindo para cima do grupo.</p>\n<p>O fogo é real. As explosões são reais. Ignis é real. E Ignis está tentando matar.</p>\n<p>— Ele não tá no controle! — grita Vespera.</p>\n<p>Valda se posiciona.</p>\n<p>— Ninguém mata ele.</p>\n<p>— <strong>Valda!</strong></p>\n<p>— Ninguém. Mata. Ele.</p>\n<p>A batalha começa. É difícil. Ignis é forte. Ignis é fogo. Ignis é raiva. E Ignis não consegue ouvir.</p>\n<p>Mas então Lucien aparece.</p>\n<p>Ele está escrevendo no ar. A caneta sangra. O gato está no ombro.</p>\n<p>— Ignis — diz ele.</p>\n<p>Ignis para. Olha para ele.</p>\n<p>— Eu faço um contrato com você.</p>\n<p>— ...</p>\n<p>— <strong>Não com a coisa que tá usando você.</strong> Com <strong>você</strong>.</p>\n<p>Ignis pisca. O fogo diminui.</p>\n<p>— Kael... — diz ele.</p>\n<p>— Kael tá esperando. — Lucien dá um passo à frente. — Mas não hoje.</p>\n<p>Lucien fecha o contrato. A caneta para de escrever. Ignis cai de joelhos. O fogo desaparece.</p>\n<p>— Vai — diz Lucien. — Vai ver o teu irmão.</p>\n<p>Ignis olha para ele. Confuso. Depois acena. Depois dorme.</p>\n<p>Vespera se aproxima.</p>\n<p>— Como você fez isso?</p>\n<p>— Eu escrevi um contrato com <strong>ele</strong>. — Lucien guarda a caneta. — Com o Ignis de verdade.</p>\n<p>— E a coisa que tava usando ele?</p>\n<p>— Ela aceitou os termos. — Ele sorri. — Contratos funcionam assim. Todo mundo aceita. E ninguém lê.</p>\n<hr>"},{"n":22,"title":"Soren Para de Rir","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No octogésimo quinto dia, Soren para de rir.</p>\n<p>Está no meio de uma batalha. Não é uma batalha grande — é uma escaramuça. Mas Soren para.</p>\n<p>Ele senta no chão.</p>\n<p>E não levanta.</p>\n<p>— Soren.</p>\n<p>— ...</p>\n<p>— Soren, levanta.</p>\n<p>— Não consigo mais. — A voz dele é baixa. — Eu tô cansado de lembrar sozinho.</p>\n<p>O grupo para. Os inimigos também. Todo mundo olha para o rapaz sentado no chão, no meio do campo de batalha, com a lâmina no colo.</p>\n<p>Kaelen se aproxima. Se abaixa.</p>\n<p>— Vem — diz ele.</p>\n<p>— Não.</p>\n<p>— Vem.</p>\n<p>Ele pega Soren no colo. Carrega.</p>\n<p>— Você carregou o cemitério inteiro — diz Kaelen. — Agora é minha vez.</p>\n<p>— Eu não pedi.</p>\n<p>— Eu sei. — Kaelen ajusta o peso. — Eu escolhi.</p>\n<p>Ele carrega Soren por três dias. Sem reclamar. Sem parar. Soren não fala. Soren não ri. Soren só dorme.</p>\n<p>No quarto dia, Soren acorda.</p>\n<p>— Kaelen.</p>\n<p>— O quê?</p>\n<p>— Obrigado.</p>\n<p>— Não me agradeça. — Kaelen continua andando. — Só não morre.</p>\n<p>— ... Tá bom.</p>\n<p>— <strong>Promete.</strong></p>\n<p>— ... Prometo.</p>\n<p>Eles seguem.</p>\n<hr>"},{"n":23,"title":"O Gato Sempre Esteve Aqui","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>No nonagésimo dia, Kira desaparece.</p>\n<p>Lucien fica branco. Ele para. Olha ao redor.</p>\n<p>— Kira?</p>\n<p>Nada.</p>\n<p>— <strong>Kira?</strong></p>\n<p>Nada.</p>\n<p>— Kira, onde você tá?</p>\n<p>O ar muda. A temperatura cai. E algo <strong>aparece</strong>.</p>\n<p>Não é gato. É algo maior. Uma figura. Dois olhos. Um âmbar. Um prateado. Em todas as realidades.</p>\n<p>E ela <strong>fala</strong>. Não com voz. Com <strong>vozes</strong>.</p>\n<p>— Eu escolhi ficar com ele. — As vozes são muitas, são uma, são todas. — Não porque ele é bom. Porque ele foi o único que se importou comigo <strong>antes de me usar</strong>.</p>\n<p>Lucien cai de joelhos.</p>\n<p>— Kira...</p>\n<p>— Eu não vou embora. — A figura desaparece. O gato reaparece. Senta no colo dele. — Nunca.</p>\n<p>Lucien chora. Pela primeira vez em 300 anos.</p>\n<p>Ninguém fala. Ninguém se aproxima. Todos entendem que aquilo é entre eles dois.</p>\n<p>Depois de um tempo, Lucien levanta. Limpa o rosto.</p>\n<p>— Vamos — diz ele. — Temos um mundo pra salvar.</p>\n<p>O grupo segue.</p>\n<hr>"},{"n":24,"title":"A Verdade de Lucien","part":"PARTE TRÊS — A FRATURA SE ABRE","html":"<p>Naquela noite, Lucien conta tudo.</p>\n<p>Estão todos ao redor do fogo. Kira no colo dele. Ele fala sem sarcasmo. Pela primeira vez.</p>\n<p>— Eu matei o Erwin.</p>\n<p>Silêncio.</p>\n<p>— Fui eu. Há 300 anos. Um contrato. Ele assinou sem ler. Eu escrevi os termos mais cruéis que consegui.</p>\n<p>Silêncio.</p>\n<p>— A Fratura é consequência disso. — Ele olha para o fogo. — Eu sabia há meses. Escondi de vocês.</p>\n<p>Ninguém fala.</p>\n<p>— Vocês deviam me odiar.</p>\n<p>Valda se aproxima.</p>\n<p>— Você fez o certo?</p>\n<p>— Eu não sei mais o que é certo.</p>\n<p>— Você salvou o gato?</p>\n<p>— Salvei.</p>\n<p>— Então tá resolvido.</p>\n<p>— <strong>Valda.</strong></p>\n<p>— Eu não tô te perdoando. — Ela se senta ao lado dele. — Eu tô te <strong>entendendo</strong>. É diferente.</p>\n<p>Magnus fala:</p>\n<p>— Você vai se sacrificar.</p>\n<p>— ... Sim.</p>\n<p>— Quando?</p>\n<p>— Quando for a hora.</p>\n<p>— E a gente vai deixar?</p>\n<p>— Vocês não têm escolha.</p>\n<p>— A gente sempre tem escolha. — Magnus olha para ele. — Sempre.</p>\n<p>Lucien não responde. Ele escreve.</p>\n<hr>\n<p><strong>OS SETE AMORES</strong></p>\n<p>Ele conta depois. Só pra você. Só porque você perguntou.</p>\n<p>Estão os dois sentados longe do grupo. Kira no colo dele. A caneta no ar.</p>\n<p>— Eu amei sete vezes em 300 anos. — A voz dele é baixa. — Todas foram a última.</p>\n<p>Silêncio.</p>\n<p>— A primeira foi Ariel. Um anjo. Ele plantava jardins. Ele deixava flores no banco onde eu sentava. Eu demorei 40 anos pra falar com ele. <strong>40 anos.</strong> E quando eu falei, ele riu. E eu me apaixonei. E ele não caiu comigo. E eu nunca perdoei ele por isso.</p>\n<p>Silêncio.</p>\n<p>— A segunda foi Helena. Uma viúva em Avignon. Ela me deu pão. Eu fiquei 7 anos na vila dela. Ela tinha duas filhas. A mais velha me chamava de \"tio escuro\". Eu deixava. <strong>Eu tinha uma família.</strong> E a peste levou todos. <strong>Todos.</strong> Em uma semana.</p>\n<p>Silêncio.</p>\n<p>— A terceira foi Tomás. Um marinheiro em Sevilha. Ele via coisas que não existiam. Ou existiam. <strong>Ninguém sabia.</strong> Ele me reconheceu na hora. Disse: \"Você é anjo caído, né?\" Eu quase cuspi o vinho. Ficamos 4 anos juntos. Ele me ensinou a brigar. Eu ensinei ele a ler. E um dia, caçadores de demônios invadiram a taverna onde a gente tava. Ele se colocou na frente. Ele morreu com uma estaca no peito. <strong>E eu fugi.</strong> Eu fugi e ele morreu.</p>\n<p>Silêncio.</p>\n<p>— A quarta foi Ysabel. Uma freira nos Alpes. Ela cuidava de órfãos e de animais abandonados. Ela me encontrou ferido no estábulo. Disse: \"Você não vai morrer hoje. Levanta.\" Fiquei 11 anos no convento. Nunca a toquei. Nunca a beijei. <strong>Foi o amor mais casto da minha vida.</strong> Ela morreu de câncer nos meus braços. Antes de morrer, ela disse: \"Lucien. Você é bom. Nunca duvide disso.\" <strong>Eu ainda duvido.</strong></p>\n<p>Silêncio.</p>\n<p>— A quinta foi Marcus. Um médico em Londres. Ateu convicto. Ele viu minhas asas e <strong>mediu, anotou, catalogou.</strong> Por dois anos. Ele queria me curar. Me fazer humano. <strong>Eu não quis.</strong> Ele foi embora. <strong>Não morreu. Só foi.</strong> Isso é pior que morrer.</p>\n<p>Silêncio.</p>\n<p>— A sexta foi Aurélie. Uma criança. <strong>Seis anos.</strong> Eu a encontrei em Paris. Ela tinha sido parcialmente apagada pela Fratura. Ninguém a via. Só eu. Só Kira. <strong>Eu a criei por 27 anos.</strong> Ela me chamava de \"tio Lu\". Ela virou professora. Casou. Teve filhos. E em 1935, ela foi <strong>apagada completamente.</strong> Não morreu. <strong>Nunca existiu.</strong> Eu escrevi o nome dela num contrato. Só pra ter. <strong>Só pra ter.</strong></p>\n<p>Silêncio.</p>\n<p>— A sétima foi Théo. Um estudante de física no Brasil. <strong>Se parecia com o Erwin.</strong> Fisicamente. Eu achei que era uma segunda chance. Não era. Fiquei um ano com ele. Ele achava que eu era cosplay. Eu deixei ele achar. <strong>Eu precisava ser amado por algo que eu não era.</strong> E aí eu fui embora. Pra proteger ele. <strong>Ele nunca soube.</strong></p>\n<p>Silêncio.</p>\n<p>— Essas são as sete. — Lucien olha para você. — Todas foram a última.</p>\n<p>Você não fala.</p>\n<p>— Eu nunca contei isso pra ninguém. — Ele olha para Kira. — Nunca. Nem pra Kira. <strong>Você é a primeira.</strong></p>\n<p>— Por quê?</p>\n<p>— Porque você perguntou. — Ele sorri. — Ninguém nunca pergunta.</p>\n<p>Silêncio.</p>\n<p>— Você vai amar de novo?</p>\n<p>— Não. — Ele balança a cabeça. — Não porque eu não quero. Porque eu <strong>escolhi parar.</strong> Toda vez que eu amo, alguém morre. Ou é apagado. Ou é deixado. <strong>Eu não quero mais isso.</strong></p>\n<p>Silêncio.</p>\n<p>— Mas você ainda ama eles?</p>\n<p>— Todo dia. — Ele olha para o fogo. — Eu falo o nome deles toda noite. Antes de dormir. <strong>Todos.</strong></p>\n<p>— Quais são?</p>\n<p>— Ariel. Helena. Tomás. Ysabel. Marcus. Aurélie. Théo. — Ele respira. — Sete nomes. <strong>Sete noites.</strong> Uma semana inteira.</p>\n<p>Silêncio.</p>\n<p>— Você nunca esquece nenhum?</p>\n<p>— Nunca. — Ele olha para você. — Esquecer é a coisa que eu mais temo. Mais que morrer. Mais que cair. Mais que tudo.</p>\n<p>Silêncio.</p>\n<p>— Eu carrego os mortos. <strong>Sempre.</strong> Porque se eu não carrego, ninguém carrega. E se ninguém carrega, eles desaparecem. <strong>E eu me recuso a deixar isso acontecer.</strong></p>\n<p>Ele para.</p>\n<p>— Você entende?</p>\n<p>— Entendo.</p>\n<p>— Obrigado.</p>\n<p>Ele volta a escrever.</p>\n<p>Você volta a dormir.</p>\n<p>E naquela noite, você sonha com sete figuras. Um anjo. Uma mulher com pão. Um marinheiro. Uma freira. Um médico. Uma menina. Um rapaz. Todos sorrindo. Todos dizendo, com vozes diferentes:</p>\n<p>— Obrigado por lembrar.</p>\n<hr>\n<h3>PARTE QUATRO — A ESCOLHA</h3>"},{"n":25,"title":"A Porta Que Se Abre","part":"PARTE QUATRO — A ESCOLHA","html":"<p>No centésimo dia, o céu se racha.</p>\n<p>Não é uma Fratura pequena. É uma Fratura <strong>imensa</strong>. Uma rachadura que atravessa o céu de ponta a ponta, como se o mundo fosse um prato e alguém tivesse batido com força.</p>\n<p>Cidades começam a desaparecer.</p>\n<p>Não devagar. <strong>Em tempo real.</strong> Você vê prédios sumindo, árvores sumindo, pessoas sumindo. Você vê famílias se despedindo sem saber que estão se despedindo. Você vê mães chamando filhos que já não existem.</p>\n<p>Vocês têm <strong>72 horas</strong>.</p>\n<p>— Vamos — diz Valda. — Vamos pro centro.</p>\n<hr>"},{"n":26,"title":"A Oitava Peça","part":"PARTE QUATRO — A ESCOLHA","html":"<p>No centro da Fratura, há uma porta.</p>\n<p>Não é uma porta física. É uma porta <strong>metafórica</strong>. Uma porta que só o Portador pode atravessar. Uma porta que existe em todos os lugares ao mesmo tempo.</p>\n<p>E vocês percebem, juntos, que falta uma peça.</p>\n<p>— Tem oito pessoas na profecia — diz Vespera. — Mas só tem sete aqui.</p>\n<p>— O oitavo é o Portador. — Lucien olha para você. — É você.</p>\n<p>Silêncio.</p>\n<p>— Eu não sou ninguém — você diz.</p>\n<p>— Você é o único que não tem passado na Fratura. — Lucien se aproxima. — O único que pode carregar o selo sem se apagar. <strong>O único.</strong></p>\n<p>— E se eu não quiser?</p>\n<p>— Aí o mundo acaba. — Ele dá de ombros. — Simples.</p>\n<p>— Você tá me dizendo que eu tenho que escolher entre viver e salvar o mundo?</p>\n<p>— Não. — Ele sorri. Um sorriso triste. — Eu tô te dizendo que <strong>eu</strong> vou escolher. Você só vai assinar.</p>\n<p>— Como assim?</p>\n<p>— Eu vou escrever o contrato. — Ele tira a caneta. — Você só vai assinar.</p>\n<p>— E o que o contrato diz?</p>\n<p>— Que <strong>eu</strong> me apago. — Ele olha para você. — Que a Fratura fecha. Que a Kira vive.</p>\n<p>Silêncio.</p>\n<p>— Você vai se matar.</p>\n<p>— Vou me apagar. — Ele corrige. — É diferente.</p>\n<p>— Lucien...</p>\n<p>— Não. — Ele levanta a mão. — Não me chama assim. <strong>Não ainda.</strong></p>\n<p>Ele vira as costas. Vai para longe. Kira o segue.</p>\n<hr>"},{"n":27,"title":"O Portão de Vidro","part":"PARTE QUATRO — A ESCOLHA","html":"<p>Você entra sozinho.</p>\n<p>A porta é como vidro — você a atravessa, e do outro lado há <strong>nada</strong>. Um vazio branco. Um silêncio absoluto. Uma solidão que você nunca sentiu.</p>\n<p>E no meio do vazio, há um homem.</p>\n<p>Ele está sentado no chão, de costas. Cabelo escuro bagunçado. Terno formal, desbotado. Um homem cansado.</p>\n<p>Ele não se vira quando você chega.</p>\n<p>— Você demorou — diz ele.</p>\n<hr>"},{"n":28,"title":"Erwin","part":"PARTE QUATRO — A ESCOLHA","html":"<p>— Você é o Erwin?</p>\n<p>— Sou.</p>\n<p>Ele finalmente se vira. Os olhos dele são calmos. Cansados. Confusos. Como se ele não soubesse onde está.</p>\n<p>— Onde está meu gato?</p>\n<p>— Seu gato...?</p>\n<p>— O gato. — Ele olha ao redor. — O gato do experimento. Ele tá bem?</p>\n<p>Você não sabe o que dizer.</p>\n<p>— Ele tá bem — você diz.</p>\n<p>Erwin sorri. Um sorriso pequeno. Um sorriso de alívio.</p>\n<p>— Então talvez eu possa parar.</p>\n<p>— Parar o quê?</p>\n<p>— De existir. — Ele olha para as próprias mãos. — Eu tô aqui há muito tempo. Não sei quanto. Não sei por quê. Só sei que eu não consigo parar.</p>\n<p>— Você tá preso?</p>\n<p>— Preso? — Ele ri. — Não. Eu tô <strong>esperando</strong>.</p>\n<p>— Esperando o quê?</p>\n<p>— Que alguém me diga que ele tá bem.</p>\n<p>Silêncio.</p>\n<p>— Ele tá bem — você repete.</p>\n<p>— Obrigado. — Erwin se levanta. — Agora eu posso ir.</p>\n<p>E ele desaparece.</p>\n<hr>"},{"n":29,"title":"A Pergunta Certa","part":"PARTE QUATRO — A ESCOLHA","html":"<p>Você volta.</p>\n<p>O grupo está esperando. Lucien está com a caneta na mão. Kira no ombro.</p>\n<p>— Você viu ele? — pergunta Lucien.</p>\n<p>— Vi.</p>\n<p>— Ele tá bem?</p>\n<p>— Tá.</p>\n<p>— Obrigado.</p>\n<p>Ele se aproxima. A caneta está pronta. O contrato está pronto.</p>\n<p>— Você só precisa assinar — diz ele. — Eu escrevo. Você assina. <strong>Fim.</strong></p>\n<p>— Espera.</p>\n<p>— O quê?</p>\n<p>— Você não pode fazer isso.</p>\n<p>— Eu <strong>posso</strong>.</p>\n<p>— Você <strong>não pode</strong>. — Você dá um passo à frente. — Você passou 300 anos carregando culpa. 300 anos escrevendo cartas pra gente morta. 300 anos se odiando. <strong>Isso não é justiça. Isso é fuga.</strong></p>\n<p>Lucien fica parado.</p>\n<p>— Você não quer morrer — você continua. — Você quer <strong>descansar</strong>. É diferente.</p>\n<p>— ...</p>\n<p>— E eu não vou deixar você descansar sozinho.</p>\n<p>Lucien olha para você. Nos olhos. Por muito tempo.</p>\n<p>— O que você tá dizendo?</p>\n<p>— Que tem <strong>três</strong> escolhas. Não uma.</p>\n<p>— Quais?</p>\n<p>— <strong>Uma:</strong> você se apaga. A Fratura fecha. O mundo esquece de você. Fim.</p>\n<p>— ...</p>\n<p>— <strong>Duas:</strong> você não se apaga. A Fratura fica aberta. O mundo aprende a carregar memória um do outro. Ninguém esquece ninguém.</p>\n<p>— ...</p>\n<p>— <strong>Três:</strong> você compartilha. — Você olha para o grupo. — Você escreve um contrato com todos nós. Cada um carrega um pedaço. Ninguém se apaga. Ninguém esquece. <strong>Ninguém fica sozinho.</strong></p>\n<p>Lucien fica em silêncio.</p>\n<p>Depois ele ri. Baixinho.</p>\n<p>— Você é o primeiro em 300 anos que me oferece uma terceira opção.</p>\n<p>— É a única certa.</p>\n<p>— Não é. — Ele balança a cabeça. — É a mais difícil. Mas é a mais bonita.</p>\n<p>Ele olha para o grupo. Todos estão olhando para ele. Valda. Magnus. Vespera. Ignis. Kaelen. Nyx. Soren.</p>\n<p>Kira mia.</p>\n<p>— Eu aceito — diz ele. — A terceira.</p>\n<hr>"},{"n":30,"title":"Crônicas do Saber","part":"PARTE QUATRO — A ESCOLHA","html":"<p>Lucien escreve.</p>\n<p>O contrato é longo. É complexo. É bonito. Ele escreve com a caneta de sangue, e cada palavra que sai da caneta brilha no ar, e cada nome que ele escreve é um nome que ele conhece.</p>\n<p>Valda. Magnus. Vespera. Ignis. Kaelen. Nyx. Soren. Você.</p>\n<p>E no fim, ele escreve o próprio nome.</p>\n<p><strong>Lucien.</strong></p>\n<p>E o contrato se fecha.</p>\n<p>E a Fratura se fecha.</p>\n<p>E o mundo <strong>não</strong> muda.</p>\n<p>Não há explosão. Não há luz. Não há nada. Só o silêncio. O silêncio que ele tanto queria. E que agora ele finalmente tem.</p>\n<hr>"}],"routes":[{"title":"ROTA A — O SILÊNCIO","html":"<p><strong>Lucien se apaga.</strong></p>\n<p>O contrato é simples. Um termo. <strong>\"Lucien se apaga. Fratura fecha. Kira vive.\"</strong></p>\n<p>Ele assina. Kira mia. Ele não olha para trás.</p>\n<p>A Fratura fecha. O mundo volta ao normal. As cidades voltam. As pessoas voltam. Todos voltam.</p>\n<p><strong>Menos ele.</strong></p>\n<p>Ninguém lembra.</p>\n<p>Valda acorda numa manhã e sente um vazio no peito. Não sabe de quem. Magnus senta ao redor do fogo e sente falta de uma piada que ele não sabe qual é. Vespera olha para o próprio grimório e vê uma página em branco que não deveria estar em branco. Ignis sente falta de um irmão que ele não tem. Kaelen sente falta de alguém pra ensinar a perder. Nyx sente falta de um gato que ela nunca teve. Soren sente falta de um riso que não é o dele.</p>\n<p>Todos sentem falta de alguém. Ninguém sabe de quem.</p>\n<p>Mas tem um gato.</p>\n<p>Um gato preto com um olho âmbar e um olho prateado. Ele senta no meio do acampamento. No lugar vazio. E mia.</p>\n<p>— Miau.</p>\n<p>E o mundo continua.</p>\n<p>E naquele lugar, naquela noite, quando todos estão dormindo, uma flor nasce. Pequena. Amarela. Ninguém sabe de onde veio.</p>\n<p><strong>Fim da Rota A.</strong></p>\n<hr>"},{"title":"ROTA B — O MUNDO FRATURADO","html":"<p><strong>Lucien sobrevive.</strong></p>\n<p>Ele escreve o contrato. Mas o contrato é diferente. <strong>\"Lucien vive. Fratura fica aberta. Mundo aprende a carregar memória.\"</strong></p>\n<p>Ele assina. Kira mia. Ele olha para trás.</p>\n<p>A Fratura não fecha. Ela <strong>fica</strong>. Mas agora as pessoas sabem. Agora as pessoas entendem. Agora as pessoas <strong>escolhem</strong> carregar memória uma da outra.</p>\n<p>O mundo fica mais lento. Mais quieto. Mais atento. As pessoas param de esquecer. As pessoas param de sumir. As pessoas param de morrer de vazio.</p>\n<p>E Lucien fica.</p>\n<p>Ele fica com o grupo. Ele fica com Kira. Ele fica com os amigos que ele fez. Ele fica com a culpa que ele carrega. Ele fica com o riso que ele agora consegue dar.</p>\n<p>Ele não está curado. Ele nunca vai estar curado. Mas ele está <strong>acompanhado</strong>. E isso, pra ele, é mais do que ele teve em 300 anos.</p>\n<p>Um dia, ele senta ao lado do fogo. Kira no colo. Ele escreve. Não um contrato. Uma carta. Pra ninguém. Só por escrever.</p>\n<p>Valda se aproxima.</p>\n<p>— O que você tá escrevendo?</p>\n<p>— Uma carta.</p>\n<p>— Pra quem?</p>\n<p>— Pra mim mesmo. — Ele sorri. — Pra lembrar que eu tô vivo.</p>\n<p>— Você tá?</p>\n<p>— Tô. — Ele olha para ela. — <strong>Pela primeira vez em 300 anos, eu tô.</strong></p>\n<p><strong>Fim da Rota B.</strong></p>\n<hr>"},{"title":"ROTA C — O CORO","html":"<p><strong>Lucien sobrevive. A Fratura vira biblioteca.</strong></p>\n<p>O contrato é diferente. <strong>\"Lucien vive. Fratura vira biblioteca. Memórias podem ser depositadas.\"</strong></p>\n<p>Ele assina. Kira mia. Ele olha para trás.</p>\n<p>A Fratura não fecha. Ela <strong>muda</strong>. Vira uma biblioteca-viva. Um lugar onde as pessoas podem depositar memórias, e ler memórias, e compartilhar memórias. Um lugar onde ninguém esquece. Um lugar onde ninguém some.</p>\n<p>O Arquivo Central se expande. As estantes crescem. Os livros escrevem a si mesmos. E no centro de tudo, sentado numa mesa, com um gato no colo, está Lucien.</p>\n<p>Ele é o guardião. Ele é o bibliotecário. Ele é o escriba.</p>\n<p>Ele passa os dias escrevendo. Não contratos. <strong>Histórias.</strong> Histórias das pessoas que ele amou. Histórias dos amigos que ele fez. Histórias do mundo que ele salvou.</p>\n<p>Valda visita às vezes. Magnus traz cerveja. Vespera traz livros. Ignis traz fogo. Kaelen traz rapieiras. Nyx traz silêncio. Soren traz riso.</p>\n<p>E cada vez que alguém visita, Lucien escreve um pouco mais. E cada vez que alguém vai embora, Lucien escreve um pouco mais.</p>\n<p>Um dia, ele escreve a última palavra. E fecha o livro. E olha para Kira.</p>\n<p>— Pronto — diz ele. — Tá tudo aqui.</p>\n<p>Kira mia.</p>\n<p>— Tudo que eu vivi. Tudo que eu amei. Tudo que eu perdi. <strong>Tudo.</strong></p>\n<p>Ele acaricia a capa do livro. A capa diz:</p>\n<p><strong>CRÔNICAS DO SABER.</strong></p>\n<p>E embaixo:</p>\n<p><strong>Por Lucien, o Anjo Caído.</strong></p>\n<p>Ele sorri.</p>\n<p>— Agora ninguém esquece. — Ele olha para Kira. — <strong>Nunca mais.</strong></p>\n<p><strong>Fim da Rota C.</strong></p>\n<hr>"}],"epilogue":{"title":"EPÍLOGO — O ACAMPAMENTO","html":"<p><em>(Este epílogo acontece em todas as três rotas, com variações.)</em></p>\n<p>Está tudo calmo.</p>\n<p>A Fratura se fechou há três dias. Ou virou biblioteca. Ou ficou aberta. Depende da escolha. Mas está tudo calmo.</p>\n<p>Vocês estão acampados numa clareira. Todos os heróis vivos. Valda, Magnus, Vespera, Ignis, Kaelen, Nyx, Soren.</p>\n<p>E, se a rota permitir, Lucien.</p>\n<p>Na Rota A, tem um lugar vazio. Ninguém sabe de quem. Kira senta nele.</p>\n<p>Na Rota B, Lucien está sentado ao redor do fogo. Ele está escrevendo. Ele está sorrindo. Ele está vivo.</p>\n<p>Na Rota C, Lucien está no centro da biblioteca. Ele está escrevendo. Ele está em casa. Ele está vivo.</p>\n<p>E Kira mia.</p>\n<p>E o mundo está calmo.</p>\n<p>E pela primeira vez em 300 anos, Lucien <strong>fica</strong>.</p>\n<p>Ou não fica.</p>\n<p>Mas a história, de um jeito ou de outro, <strong>foi contada</strong>.</p>\n<p>E ninguém esqueceu.</p>"}};
