function renderSlide(){
  const m=state.mod, s=slideIdx, card=document.getElementById('slideCard'), counter=document.getElementById('slideCounter');
  if(!card||!counter||!m) return;
  counter.textContent=s+' / '+TOTAL_SLIDES;
  const prev=document.getElementById('slidePrev'), next=document.getElementById('slideNext');
  if(prev) prev.disabled=(s===1); if(next) next.disabled=(s===TOTAL_SLIDES);
  card.innerHTML=pdBuildSlide(m,s);
  card.className='';
  card.innerHTML=pdBuildSlide(m,s);
  card.scrollTop=0;
}

