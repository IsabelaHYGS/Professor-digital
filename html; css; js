      actor.enraged=true;actor.atk=Math.round(actor.atk*1.25);actor.spd=Math.round(actor.spd*1.15);
      log.push(`😡 ${actor.name} entrou em FÚRIA! Ataque +25% e velocidade +15%.`);
    }
