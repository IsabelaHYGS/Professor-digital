function afkEnemyPower(d){
  // O poder do inimigo é determinado pelo estágio, e NÃO pelo poder atual do jogador.
  // Assim, subir um herói cria uma vantagem real em vez de fazer o chefe subir junto.
  const stage=Math.max(1,Number(d.stage)||1);
  const basePower=1500;
  const stageGrowth=Math.pow(1.05,stage-1); // +5% por estágio
  const bossMilestone=(stage%10===0)?1.18:1; // estágios 10, 20, 30... são picos de dificuldade
  return Math.round(basePower*stageGrowth*bossMilestone);
}
