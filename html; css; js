function afkStoryFragmentTotal(){return AFK_STORY_CHAPTERS.length*3;}
function afkStoryCollected(d){
  if(isAdmin()) return afkStoryFragmentTotal();
  const saved=Number(d.storyFragments);
  if(Number.isFinite(saved)) return Math.max(0,Math.min(afkStoryFragmentTotal(),Math.floor(saved)));
  return Math.max(0,Math.min(afkStoryFragmentTotal(),Math.max(1,Number(d.stage)||1)-1));
}
function afkStoryUnlockForStage(d,wonStage){
  if(isAdmin()){d.storyFragments=afkStoryFragmentTotal();return;}
  const n=Math.max(0,Math.min(afkStoryFragmentTotal(),Number(wonStage)||0));
  d.storyFragments=Math.max(Number(d.storyFragments)||0,n);
}
function afkStoryArc(n){
  return n<=8?{name:'I — O Despertar',theme:'Conhecer os heróis',icon:'🌅'}:
    n<=16?{name:'II — A Descida',theme:'Entrar na Fratura',icon:'🕳️'}:
    n<=24?{name:'III — A Fratura se Abre',theme:'A verdade vem à tona',icon:'🪞'}:
    {name:'IV — A Escolha',theme:'Fechar ou aceitar',icon:'⚖️'};
}
function afkStoryFragmentText(ch,idx){
  const z=AFK_STORY_DEPTH[ch.n]||{};
  if(idx===0) return {label:'Cena recuperada',icon:'🧭',text:ch.scene||ch.encounter||'Registro de cena fragmentado.',detail:z.summary||ch.beat||''};
  if(idx===1) return {label:'Memória do encontro',icon:'📜',text:z.summary||ch.beat||'O próximo fragmento ainda está perdido.',detail:z.quote||''};
  return {label:ch.clue?'Pista plantada':'Registro final',icon:ch.clue?'🔎':'🕯️',text:ch.clue||z.hook||'Este capítulo ainda guarda páginas que a Fratura não devolveu.',detail:z.hook||''};
}
function afkStoryArcBanner(arc,start,end,collected){
  const done=Math.max(0,Math.min(end-start+1,Math.floor((collected-(start-1)*3)/3)));
  return `<div class="afk-story-arc-banner"><div><strong>${arc.icon} ${arc.name}</strong><span>${arc.theme}</span></div><div class="arc-count">${done}/${end-start+1} capítulos completos</div></div>`;
}

function afkBookChapter(n){
  return AFK_BOOK.chapters.find(c=>Number(c.n)===Number(n))||null;
}
function afkBookUnlocked(d,n){
  if(isAdmin()) return true;
  return afkStoryCollected(d) >= Number(n)*3;
}
function afkBookPartLabel(part){
  const m=String(part||'').match(/^PARTE (.+?) — (.+)$/);
  return m ? {num:m[1],name:m[2]} : {num:'',name:part||''};
}
function afkBookOpen(type,key){
  const d=afkLoad();
  let title='', body='', kicker='', unlocked=true, nextLabel='';
  if(type==='prologue'){
    title=AFK_BOOK.prologue.title; body=AFK_BOOK.prologue.html; kicker='Abertura do Livro';
  }else if(type==='chapter'){
    const ch=afkBookChapter(key); if(!ch)return;
    unlocked=afkBookUnlocked(d,ch.n);
    if(!unlocked)return toast('🔒 Recupere os 3 fragmentos deste capítulo para abrir esta página.');
    title=`Capítulo ${ch.n} — ${ch.title}`; body=ch.html; kicker=ch.part;
    nextLabel=ch.n<30?`Próximo capítulo: ${AFK_BOOK.chapters[ch.n]?.title||''}`:'O fim do Livro I';
  }else if(type==='route'){
    if(!isAdmin() && afkStoryCollected(d)<afkStoryFragmentTotal()) return toast('🔒 Recupere toda a história antes de abrir as rotas.');
    const r=AFK_BOOK.routes.find((x,i)=>i===Number(key)); if(!r)return;
    title=r.title; body=r.html; kicker='As três rotas';
  }else if(type==='epilogue'){
