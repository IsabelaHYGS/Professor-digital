.cat-stat .cs-fill{height:100%;transition:width .4s}
.cat-stat .cs-fill.hunger{background:linear-gradient(90deg,#dc3232,#ff8888)}
.cat-stat .cs-fill.happy{background:linear-gradient(90deg,#2ea043,#A2CA8E)}
.cat-stat .cs-fill.energy{background:linear-gradient(90deg,#1466C3,#1466C3)}
.cat-stat .cs-fill.affection{background:linear-gradient(90deg,#dc6ac2,#ff9ad4)}
.cat-stat .cs-val{font-size:.72rem;color:var(--accent-l);font-weight:700;min-width:36px;text-align:right}
.cat-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
.cat-action{padding:12px;border-radius:12px;border:1px solid var(--border);background:var(--bg);color:var(--text);font:inherit;font-weight:700;cursor:pointer;font-size:.84rem;transition:.2s;display:flex;flex-direction:column;align-items:center;gap:4px}
.cat-action:hover:not(:disabled){border-color:var(--accent);background:var(--primary);transform:translateY(-2px)}
