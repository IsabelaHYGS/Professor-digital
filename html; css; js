  const goalsHTML = goals.length ? goals.map(g => { const cur = goalCurrentValue(g.type); const pct = Math.min(100, (cur/g.target)*100); const done = cur >= g.target; return `<div class="goal-item ${done?'done':''}"><div class="goal-actions"><button onclick="removeGoal('${g.id}')">×</button></div><div class="goal-title"><span>${done?'✓ ':'🎯 '}${g.title}</span><span class="goal-type">${GOAL_TYPES[g.type]?.label||g.type}</span></div><div class="goal-progress">${cur} / ${g.target} ${GOAL_TYPES[g.type]?.target||''} · ${Math.round(pct)}%</div><div class="goal-bar"><div class="goal-fill" style="width:${pct}%"></div></div>${g.deadline?`<div class="goal-deadline">📅 Até ${new Date(g.deadline+'T00:00').toLocaleDateString('pt-BR')}</div>`:''}</div>`; }).join('') : `<div style="text-align:center;padding:20px;color:var(--muted);font-size:.88rem">Nenhuma meta. Crie uma abaixo!</div>`;
  const catsHTML = ACHIEVEMENTS.map(a => { const on = unlocked.has(a.id); const info = ACH_CATS[a.id]||{name:'?',color:'#888',personality:''}; const cat = on?getCat(a.id):null; const mood = cat?catMood(cat):null; return `<div class="cat-card ${on?'unlocked':'locked'}" onclick="openCatModal('${a.id}')">${on?`<div class="cat-mood-badge">${mood.emoji}</div>`:''}<div class="cat-svg">${catSVG(info.color, cat && cat.happiness >= 50 ? 'happy':'sad', 64)}</div><div class="cat-name">${on?info.name:'???'}</div><div class="cat-personality">${on?info.personality:'Bloqueado'}</div></div>`; }).join('');
  let rows = '';
  for (const k in DISCS){ const d = DISCS[k]; for (const m of d.mods){ const st = state.steps[m.id]; const done = st?st.filter(Boolean).length:0; const pct = (done/13)*100; const q = stats.quizzes[m.id]; let accTxt='—',accCls='none'; if (q && q.attempts>0){ const pAcc = q.correct/q.attempts; accTxt = Math.round(pAcc*100)+'%'; accCls = pAcc>=0.8?'high':pAcc>=0.5?'mid':'low'; } rows += `<tr><td><strong>${d.icon}</strong> ${m.titulo}</td><td style="color:var(--muted);font-size:.78rem">${d.nome}</td><td><div style="display:flex;align-items:center;gap:6px"><div class="mod-prog-bar"><div class="mod-prog-fill" style="width:${pct}%"></div></div><span class="mod-prog-txt">${done}/13</span></div></td><td><span class="acc ${accCls}">${accTxt}</span></td></tr>`; } }
  const hasData = doneMods > 0 || Object.keys(stats.quizzes).length > 0 || timeTotal > 0;
  app.innerHTML = `
    <div class="dash-hero"><h1>📊 Meu <span class="accent">Aprendizado</span></h1><p>Acompanhe progresso, metas, gatinhos, conquistas e evolução.</p>
      <div class="dash-stats">
        <div class="stat-card blue"><div class="stat-icon">📚</div><div class="stat-value">${doneMods}<span style="font-size:1rem;opacity:.6">/${totalMods}</span></div><div class="stat-label">Módulos completos</div></div>
        <div class="stat-card green"><div class="stat-icon">🎯</div><div class="stat-value">${Math.round(acc*100)}%</div><div class="stat-label">Precisão</div></div>
        <div class="stat-card purple"><div class="stat-icon">⏱️</div><div class="stat-value">${fmtTime(timeTotal)||'0s'}</div><div class="stat-label">Tempo</div></div>
        <div class="stat-card"><div class="stat-icon">🔥</div><div class="stat-value">${streak}</div><div class="stat-label">Sequência</div></div>
        <div class="stat-card red"><div class="stat-icon">🏆</div><div class="stat-value">${unlocked.size}<span style="font-size:1rem;opacity:.6">/${ACHIEVEMENTS.length}</span></div><div class="stat-label">Conquistas</div></div>
      </div>
    </div>
    <div class="dash-panel"><h3>🎯 Minhas Metas <span class="tag">${goals.filter(g=>goalCurrentValue(g.type)>=g.target).length}/${goals.length}</span></h3>
      <div class="goals-list">${goalsHTML}</div>
      <div class="goal-form"><label>NOVA META</label><input type="text" id="gTitle" placeholder="Ex: Completar 5 módulos" maxlength="60">
        <div class="row2"><select id="gType"><option value="modules">Módulos completos</option><option value="accuracy">Precisão média (%)</option><option value="time">Tempo de estudo (min)</option><option value="streak">Dias seguidos</option></select><input type="number" id="gTarget" placeholder="Alvo" min="1" max="5000"></div>
        <input type="date" id="gDeadline">
        <button class="btn primary" onclick="addGoal()">+ Adicionar meta</button>
      </div>
    </div>
    ${hasData ? `<div class="dash-panel"><h3>📈 Evolução <span class="tag">14 dias</span></h3>${lineChartSVG()}</div>
      <div class="dash-grid"><div class="dash-panel"><h3>📈 Progresso por disciplina</h3>${barChartSVG(barData)}</div><div class="dash-panel"><h3>🎯 Precisão por área</h3>${radarChartSVG(radarData)}</div></div>` : ''}
    <div class="dash-panel"><h3>🐱 Meus Gatinhos <span class="tag">${unlocked.size}/${ACHIEVEMENTS.length}</span></h3>
      <p style="font-size:.84rem;color:var(--muted);margin-bottom:14px">Cada conquista desbloqueia um gatinho. Clique para interagir!</p>
      <div class="cat-gallery">${catsHTML}</div>
    </div>
    ${hasData ? `<div class="dash-grid"><div class="dash-panel"><h3>🏆 Conquistas</h3><div class="achievements">${achHTML}</div></div><div class="dash-panel"><h3>📅 Atividade</h3>${heatmapSVG(30)}</div></div>
      <div class="dash-panel"><h3>📚 Detalhe por módulo</h3><div style="overflow-x:auto"><table class="dash-table"><thead><tr><th>Módulo</th><th>Disciplina</th><th>Progresso</th><th>Acerto</th></tr></thead><tbody>${rows}</tbody></table></div></div>` : ''}
    <div class="dash-panel"><h3>ℹ️ Sobre</h3><p style="font-size:.86rem;color:var(--muted);line-height:1.6">Tudo salvo no navegador.</p><div style="margin-top:12px"><button class="btn" onclick="resetProgress()">🗑️ Apagar histórico</button></div></div>`;
}
