  s.timeSpent[today] = (s.timeSpent[today]||0)+seconds;
  s.history = s.history || {};
  s.history[today] = s.history[today] || {quizCorrect:0,quizTotal:0,time:0};
  s.history[today].time = (s.history[today].time||0)+seconds;
  updateStreak(s); saveStats(s);
}
