function afkBookProgress(d){
  const total=afkStoryFragmentTotal(),collected=afkStoryCollected(d);
  return {total,collected,pct:Math.round(collected/total*100),complete:collected>=total};
}
function afkRenderStory(d){
  const p=afkBookProgress(d);
  const partRanges=[
    {label:'PARTE UM',name:'O Despertar',start:1,end:8,icon:'🌅'},
    {label:'PARTE DOIS',name:'A Descida',start:9,end:16,icon:'🕳️'},
    {label:'PARTE TRÊS',name:'A Fratura se Abre',start:17,end:24,icon:'🪞'},
    {label:'PARTE QUATRO',name:'A Escolha',start:25,end:30,icon:'⚖️'}
