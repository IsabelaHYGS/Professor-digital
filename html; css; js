.cat-panel .cat-name-big{font-size:1.5rem;font-weight:800;color:var(--accent-l);margin-top:10px}
.cat-panel .cat-personality-big{font-size:.84rem;color:var(--muted);font-style:italic}
.cat-panel .cat-mood-text{font-size:1rem;color:var(--text);margin-top:8px;font-weight:600}
.cat-stats{display:flex;flex-direction:column;gap:8px;margin:14px 0}
.cat-stat{display:flex;align-items:center;gap:10px}
.cat-stat .cs-label{font-size:.8rem;color:var(--muted);min-width:100px;font-weight:600}
