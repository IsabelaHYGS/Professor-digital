/* ATALHOS */
document.addEventListener('keydown', e => {
  const tag = (e.target.tagName||'').toUpperCase();
  if (tag === 'INPUT' || tag === 'TEXTAREA') return;
  if (e.key === 'Escape'){
    const po=document.getElementById('presOverlay'), sm=document.getElementById('slidesModal'), dm=document.getElementById('studentModal'), gm=document.getElementById('gameModal'), cm=document.getElementById('catModal'), fm=document.getElementById('fcModal');
    if (po?.classList.contains('on')) closePresentation();
    else if (sm?.classList.contains('on')) closeSlides();
    else if (dm?.classList.contains('open')) closeStudentModal();
    else if (gm?.classList.contains('on')) closeGame();
    else if (cm?.classList.contains('open')) closeCatModal();
    else if (fm?.classList.contains('open')) closeFcModal();
    return;
  }
  if (GAME.rafId && !GAME.questionOpen && !GAME.overlayOpen){
    if (e.key.toLowerCase() === 'p'){ toggleGamePause(); e.preventDefault(); return; }
    if (!GAME.paused){
      if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a'){ GAME.keys.left = true; e.preventDefault(); return; }
      if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd'){ GAME.keys.right = true; e.preventDefault(); return; }
      if (e.key === 'ArrowUp' || e.key === ' ' || e.key.toLowerCase() === 'w'){ GAME.keys.jump = true; e.preventDefault(); return; }
    }
  }
  if (document.getElementById('slidesModal')?.classList.contains('on')){
    if (e.key === 'ArrowRight' || e.key === 'PageDown'){ e.preventDefault(); slideNav(1); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp'){ e.preventDefault(); slideNav(-1); }
    else if (e.key === 'Escape'){ closeSlides(); }
    return;
  }
  if (document.getElementById('presOverlay')?.classList.contains('on')){
    if (e.key === 'ArrowRight' || e.key === 'PageDown'){
      e.preventDefault();
      if (state.sec < 13){ openSec(state.sec+1); setTimeout(()=>openPresentation(),80); }
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp'){
      e.preventDefault();
      if (state.sec > 1){ openSec(state.sec-1); setTimeout(()=>openPresentation(),80); }
    } else if (e.key === 'Escape'){ closePresentation(); }
    return;
  }
  if (!document.getElementById('profSidebar')?.classList.contains('show')) return;
  if (e.key === 'ArrowRight'){ e.preventDefault(); profNext(); }
  else if (e.key === 'ArrowLeft'){ e.preventDefault(); profPrev(); }
  else if (e.key.toLowerCase() === 'p'){ e.preventDefault(); togglePresentation(); }
  else if (e.key.toLowerCase() === 's'){ e.preventDefault(); openStudentModal(); }
  else if (e.key.toLowerCase() === 'r'){ e.preventDefault(); profRestart(); }
  else if (e.key.toLowerCase() === 'l'){ e.preventDefault(); openSlides(); }
});
document.addEventListener('keyup', e => {
  if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a') GAME.keys.left = false;
  if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd') GAME.keys.right = false;
  if (e.key === 'ArrowUp' || e.key === ' ' || e.key.toLowerCase() === 'w') GAME.keys.jump = false;
});
let toastTimer;
function toast(msg){ const t = document.getElementById('toast'); if (!t) return; t.textContent = msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(()=>t.classList.remove('show'), 2200); }

/* TEMA — modo escuro original por padrão; modo claro usa a paleta fornecida */
const THEME_KEY = 'PD_THEME_MODE';
function applyTheme(mode){
  const light = mode === 'light';
  document.body.classList.toggle('light-theme', light);
  const b = document.getElementById('themeToggle');
  if (b){
    b.textContent = light ? '🌙 Modo escuro' : '☀️ Modo claro';
    b.setAttribute('aria-label', light ? 'Voltar ao modo escuro' : 'Ativar modo claro');
    b.title = light ? 'Voltar ao modo escuro' : 'Ativar modo claro';
  }
  try{ localStorage.setItem(THEME_KEY, light ? 'light' : 'dark'); }catch(e){}
}
function toggleTheme(){
  const next = document.body.classList.contains('light-theme') ? 'dark' : 'light';
  applyTheme(next);
}
(function initTheme(){
  let mode='dark';
  try{ mode=localStorage.getItem(THEME_KEY)==='light' ? 'light' : 'dark'; }catch(e){}
  document.documentElement.dataset.theme=mode;
  document.body.classList.toggle('light-theme', mode==='light');
  setTimeout(()=>applyTheme(mode),0);
})();

